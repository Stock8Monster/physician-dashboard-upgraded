t":0,"fatalErrorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"270","usedDeprecatedRules":"156"},{"filePath":"271","messages":"272","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"156"},{"filePath":"273","messages":"274","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"156"},{"filePath":"275","messages":"276","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"156"},{"filePath":"277","messages":"278","errorCount":0,"fatalErrorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"279","usedDeprecatedRules":"156"},{"filePath":"280","messages":"281","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"156"},{"filePath":"282","messages":"283","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"156"},{"filePath":"284","messages":"285","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"156"},{"filePath":"286","messages":"287","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"156"},{"filePath":"288","messages":"289","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"156"},{"filePath":"290","messages":"291","errorCount":0,"fatalErrorCount":0,"warningCount":4,"fixableErrorCount":0,"fixableWarningCount":0,"source":"292","usedDeprecatedRules":"156"},{"filePath":"293","messages":"294","errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"295","usedDeprecatedRules":"156"},{"filePath":"296","messages":"297","errorCount":0,"fatalErrorCount":0,"warningCount":3,"fixableErrorCount":0,"fixableWarningCount":0,"source":"298","usedDeprecatedRules":"156"},{"filePath":"299","messages":"300","errorCount":0,"fatalErrorCount":0,"warningCount":3,"fixableErrorCount":0,"fixableWarningCount":0,"source":"301","usedDeprecatedRules":"156"},{"filePath":"302","messages":"303","errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"304","usedDeprecatedRules":"156"},{"filePath":"305","messages":"306","errorCount":0,"fatalErrorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"307","usedDeprecatedRules":"156"},{"filePath":"308","messages":"309","errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"310","usedDeprecatedRules":"156"},{"filePath":"311","messages":"312","errorCount":0,"fatalErrorCount":0,"warningCount":3,"fixableErrorCount":0,"fixableWarningCount":0,"source":"313","usedDeprecatedRules":"156"},{"filePath":"314","messages":"315","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"156"},{"filePath":"316","messages":"317","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"156"},{"filePath":"318","messages":"319","errorCount":0,"fatalErrorCount":0,"warningCount":7,"fixableErrorCount":0,"fixableWarningCount":0,"source":null},{"filePath":"320","messages":"321","errorCount":0,"fatalErrorCount":0,"warningCount":9,"fixableErrorCount":0,"fixableWarningCount":0,"source":"322","usedDeprecatedRules":"156"},{"filePath":"323","messages":"324","errorCount":0,"fatalErrorCount":0,"warningCount":8,"fixableErrorCount":0,"fixableWarningCount":0,"source":"325","usedDeprecatedRules":"156"},{"filePath":"326","messages":"327","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"156"},{"filePath":"328","messages":"329","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"156"},{"filePath":"330","messages":"331","errorCount":0,"fatalErrorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"332","usedDeprecatedRules":"156"},{"filePath":"333","messages":"334","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"156"},{"filePath":"335","messages":"336","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"156"},"C:\\Users\\Ajdurden8\\Documents\\GitHub\\physician-dashboard-upgraded\\new-directory-name\\src\\index.js",[],["337","338"],"C:\\Users\\Ajdurden8\\Documents\\GitHub\\physician-dashboard-upgraded\\new-directory-name\\src\\App.js",["339","340"],"import React, { useState } from 'react';\r\nimport { Grommet } from 'grommet';\r\nimport { BrowserRouter as Router, Routes, Route, Navigate, useLocation } from 'react-router-dom';\r\nimport AppBar from './components/AppBar';\r\nimport Dashboard from './pages/Dashboard';\r\nimport DashboardEnhanced from './pages/Dashboard-Enhanced';\r\nimport Account from './pages/Account';\r\nimport NotFound from './pages/NotFound';\r\nimport Login from './components/Login';\r\nimport AdminPage from './components/AdminPage';\r\nimport AgamaPatientPortal from './pages/AgamaPatientPortal';\r\nimport ConsultList from './components/ConsultList'; // Import the new ConsultList component\r\nimport ConsultListDynamic from './components/ConsultListDynamic'; // Dynamic version with AI features\r\nimport './styles/global.css';\r\nimport { ResponsiveProvider } from './contexts/ResponsiveContext';\r\n\r\nconst customTheme = {\r\n    // Your custom theme code here...\r\n};\r\n\r\nfunction App() {\r\n    const [isAuth, setIsAuth] = useState(false); // Authentication state\r\n    const location = useLocation(); // Get the current location\r\n\r\n    // Updated state to hold multiple popups\r\n    const [popups, setPopups] = useState([]);\r\n\r\n    const addPopup = (contentType, content) => {\r\n        // Check if the popup with the same contentType already exists\r\n        const popupExists = popups.some(popup => popup.contentType === contentType);\r\n        if (popupExists) return; // If it exists, do not add another one\r\n\r\n        const newPopup = {\r\n            id: Date.now(), // Unique identifier for each popup\r\n            contentType: contentType,\r\n            isVisible: true,\r\n            content: content,\r\n        };\r\n        setPopups((prevPopups) => [...prevPopups, newPopup]);\r\n    };\r\n\r\n\r\n    const removePopup = (id) => {\r\n        setPopups((prevPopups) => prevPopups.filter((popup) => popup.id !== id));\r\n    };\r\n\r\n    const removePopupByType = (contentType) => {\r\n        setPopups((prevPopups) => prevPopups.filter(popup => popup.contentType !== contentType));\r\n    };\r\n\r\n    return (\r\n        <ResponsiveProvider>\r\n            <Grommet theme={customTheme} full>\r\n                {/* Conditionally render AppBar based on the current path */}\r\n                {location.pathname !== '/patient-portal' && (\r\n                    <AppBar\r\n                        setAuth={setIsAuth}\r\n                    />\r\n                )}\r\n                <Routes>\r\n                    {/* Login Route */}\r\n                    <Route path=\"/login\" element={<Login setAuth={setIsAuth} />} />\r\n\r\n                    {/* Main Route for ConsultList or Dashboard */}\r\n                    <Route\r\n                        path=\"/\"\r\n                        element={\r\n                            isAuth ? (\r\n                                <ConsultListDynamic /> // Show Dynamic ConsultList with AI features\r\n                            ) : (\r\n                                <Navigate to=\"/login\" />\r\n                            )\r\n                        }\r\n                    />\r\n\r\n                    {/* Admin Page Route */}\r\n                    <Route path=\"/Admin\" element={isAuth ? <AdminPage /> : <Navigate to=\"/login\" />} />\r\n\r\n                    {/* Patient Portal Route */}\r\n                    <Route path=\"/patient-portal\" element={<AgamaPatientPortal />} />\r\n\r\n                    {/* Dashboard Route (accessible only after clicking a patient) */}\r\n                    <Route\r\n                        path=\"/dashboard\"\r\n                        element={\r\n                            isAuth ? (\r\n                                <Dashboard\r\n                                    popups={popups} removePopup={removePopup} addPopup={addPopup} removePopupByType={removePopupByType}\r\n                                />\r\n                            ) : (\r\n                                <Navigate to=\"/login\" />\r\n                            )\r\n                        }\r\n                    />\r\n\r\n                    {/* Enhanced Dashboard Route with Revolutionary AI Features */}\r\n                    <Route\r\n                        path=\"/dashboard-ai\"\r\n                        element={\r\n                            isAuth ? (\r\n                                <DashboardEnhanced\r\n                                    popups={popups} removePopup={removePopup} addPopup={addPopup} removePopupByType={removePopupByType}\r\n                                />\r\n                            ) : (\r\n                                <Navigate to=\"/login\" />\r\n                            )\r\n                        }\r\n                    />\r\n\r\n                    {/* Fallback Route for 404 Not Found */}\r\n                    <Route path=\"*\" element={<NotFound />} />\r\n                </Routes>\r\n            </Grommet>\r\n        </ResponsiveProvider>\r\n    );\r\n}\r\n\r\nfunction AppWrapper() {\r\n    return (\r\n        <Router>\r\n            <App />\r\n        </Router>\r\n    );\r\n}\r\n\r\nexport default AppWrapper;\r\n","C:\\Users\\Ajdurden8\\Documents\\GitHub\\physician-dashboard-upgraded\\new-directory-name\\src\\reportWebVitals.js",[],"C:\\Users\\Ajdurden8\\Documents\\GitHub\\physician-dashboard-upgraded\\new-directory-name\\src\\components\\AppBar.js",["341","342","343","344","345","346"],"import React from \"react\";\r\nimport { Header, Box, Button, Text } from \"grommet\";\r\nimport { Logout } from \"grommet-icons\";\r\nimport { useNavigate, useLocation } from \"react-router-dom\"; // Import useLocation\r\nimport styled from \"styled-components\";\r\n\r\n// Styled header with the appropriate background color\r\nconst StyledHeader = styled(Header)`\r\n  background-color: #1c1c1c; // Dark top menu background color\r\n  border-bottom: none;\r\n  padding: 0 2rem;\r\n  box-shadow: none;\r\n`;\r\n\r\n// App name styled text\r\nconst AppName = styled(Text)`\r\n  font-weight: normal;\r\n  color: #ffffff; // Default white text color\r\n  letter-spacing: 1.2px;\r\n`;\r\n\r\n// Logout button with transparent background and hover effect\r\nconst LogoutButton = styled(Button)`\r\n  border-radius: 50px;\r\n  padding: 0.5rem 1rem;\r\n  background-color: transparent;\r\n  color: #ffffff; // White text\r\n  font-weight: normal;\r\n  border: none;\r\n  transition: none;\r\n  box-shadow: none;\r\n  &:hover {\r\n    background-color: #444444; // Slight dark background on hover\r\n    box-shadow: none;\r\n  }\r\n`;\r\n\r\n// Navigation button with transparent background and similar hover effect\r\nconst NavButton = styled(Button)`\r\n  border-radius: 50px;\r\n  padding: 0.5rem 1rem;\r\n  background-color: transparent;\r\n  color: #ffffff; // White text color for nav buttons\r\n  font-weight: normal;\r\n  border: none;\r\n  transition: none;\r\n  box-shadow: none;\r\n  &:hover {\r\n    background-color: #444444; // Slight dark background on hover\r\n    box-shadow: none;\r\n  }\r\n`;\r\n\r\nconst AppBar = ({ setAuth }) => {\r\n  const isMobile = window.innerWidth <= 768;\r\n  \r\n  return (\r\n    <StyledHeader justify=\"between\">\r\n      <Box direction={isMobile ? 'column' : 'row'} gap=\"small\">\r\n        {/* Adjust layout for mobile */}\r\n      </Box>\r\n    </StyledHeader>\r\n  );\r\n};\r\n\r\nexport default AppBar;\r\n","C:\\Users\\Ajdurden8\\Documents\\GitHub\\physician-dashboard-upgraded\\new-directory-name\\src\\components\\Login.js",["347","348","349","350"],"// src/Login.js\r\nimport React, { useState, useEffect } from 'react';\r\nimport { useNavigate } from 'react-router-dom';\r\nimport axios from 'axios';\r\nimport {Box, Button, Form, FormField, TextInput, Text, Tabs, Heading} from 'grommet';\r\nimport {\r\n    StyledFormContainer,\r\n    StyledForm,\r\n    StyledButton\r\n} from '../styles/StyledComponents';\r\nimport styled from \"styled-components\";\r\n\r\nconst StyledFormField = styled(FormField)`\r\n  label {\r\n    //color: #fff; // Default text color\r\n  }\r\n  input,\r\n  select {\r\n    background-color: #444; // Center panel background\r\n    box-shadow: none !important; // Remove box-shadow from input and select\r\n    border-color: transparent !important;\r\n  }\r\n  input:focus,\r\n  select:focus {\r\n    outline: none;\r\n    box-shadow: none !important; // Ensure no box-shadow on focus\r\n    border-color: transparent !important;\r\n  }\r\n\r\n  /* Remove box-shadow from Grommet drop containers or styled dropdown components */\r\n  div[class*=\"StyledDrop\"],\r\n  div[class*=\"StyledBox\"],\r\n  .grommetux-drop,\r\n  .grommetux-drop__container {\r\n    box-shadow: none !important; /* Forcefully remove box-shadow */\r\n    border-color: transparent !important;\r\n  }\r\n`;\r\n\r\nconst StyledLoginButton = styled(Button)`\r\n  background-color: #444444; /* Default button background */\r\n  color: #FFFFFF; /* Button text color */\r\n  border: 1px solid #444444; /* Button border color */\r\n  border-radius: 5px; /* Border radius as per color scheme */\r\n\r\n  &:hover {\r\n    background-color: #555555; /* Hover background color */\r\n    border: 1px solid #555555 !important; /* Ensure no border on hover */\r\n    box-shadow: none !important; /* Remove any box-shadow on hover */\r\n  }\r\n\r\n  &:focus {\r\n    outline: none !important; /* Remove focus outline */\r\n    box-shadow: none !important; /* Remove focus box-shadow */\r\n  }\r\n\r\n  &:active {\r\n    background-color: #666666; /* Optional: active background color */\r\n  }\r\n`;\r\n\r\nconst Login = ({ setAuth }) => {\r\n    const [username, setUsername] = useState('');\r\n    const [password, setPassword] = useState('');\r\n    const [error, setError] = useState('');\r\n    const [loading, setLoading] = useState(false);\r\n    const navigate = useNavigate();\r\n\r\n    useEffect(() => {\r\n        // Check if user is already logged in\r\n        const isLoggedIn = localStorage.getItem('isLoggedIn');\r\n        if (isLoggedIn === 'true') {\r\n            setAuth(true);\r\n            navigate('/');\r\n        }\r\n    }, [setAuth, navigate]);\r\n\r\n    const handleSubmit = async (e) => {\r\n        e.preventDefault();\r\n        setLoading(true);\r\n        try {\r\n            // Simulate a login request\r\n            await new Promise((resolve) => setTimeout(resolve, 1000));\r\n\r\n            // Check for admin credentials\r\n            if (username === 'andrew-admin' && password === 'andrew-admin') {  // Add your desired admin credentials\r\n                setAuth(true);\r\n                localStorage.setItem('isLoggedIn', 'true'); // Save auth state to local storage\r\n                localStorage.setItem('userRole', 'admin'); // Save user role as 'admin'\r\n                navigate('/'); // Redirect to the main page\r\n            }\r\n            // Check for the regular VC user\r\n            else if (username === 'agama-poc' && password === 'agama-poc') {\r\n                setAuth(true);\r\n                localStorage.setItem('isLoggedIn', 'true'); // Save auth state to local storage\r\n                localStorage.setItem('userRole', 'vc-user'); // Save user role as 'VC user'\r\n                navigate('/'); // Redirect to the main page\r\n            }\r\n            // Handle invalid credentials\r\n            else {\r\n                setError('Invalid username or password');\r\n            }\r\n        } catch (err) {\r\n            setError('Something went wrong. Please try again.');\r\n        }\r\n        setLoading(false);\r\n    };\r\n\r\n\r\n    return (\r\n        <Box fill align=\"center\" justify=\"center\" background=\"#1c1c1c\"> {/* Darker background */}\r\n            <Heading level={3} margin={{ right: 'small', vertical: 'large' }} style={{width: \"175px\"}} color=\"white\">Agama Health</Heading>\r\n            <StyledFormContainer>\r\n                <StyledForm onSubmit={handleSubmit}>\r\n                    <StyledFormField plain label=\"Username\" name=\"username\" required>\r\n                        <TextInput\r\n                            plain\r\n                            name=\"username\"\r\n                            value={username}\r\n                            onChange={(e) => setUsername(e.target.value)}\r\n                        />\r\n                    </StyledFormField>\r\n                    <StyledFormField plain label=\"Password\" name=\"password\" required>\r\n                        <TextInput\r\n                            plain\r\n                            type=\"password\"\r\n                            name=\"password\"\r\n                            value={password}\r\n                            onChange={(e) => setPassword(e.target.value)}\r\n                        />\r\n                    </StyledFormField>\r\n                    {error && (\r\n                        <Box pad={{vertical: 'small'}}>\r\n                            <Text color=\"status-critical\">{error}</Text>\r\n                        </Box>\r\n                    )}\r\n                    <Box direction=\"row\" gap=\"medium\" pad={{top: 'medium'}}>\r\n                        <StyledLoginButton\r\n                            type=\"submit\"\r\n                            primary\r\n                            label={loading ? 'Logging in...' : 'Login'}\r\n                            disabled={loading}\r\n                        />\r\n                    </Box>\r\n                </StyledForm>\r\n            </StyledFormContainer>\r\n        </Box>\r\n    );\r\n}\r\nexport default Login;\r\n","C:\\Users\\Ajdurden8\\Documents\\GitHub\\physician-dashboard-upgraded\\new-directory-name\\src\\components\\AdminPage.js",["351","352"],"import React, { useState } from 'react';\r\nimport { Box, Heading, Button, Layer } from 'grommet';\r\nimport { Add } from 'grommet-icons';\r\nimport PatientDataTable from './PatientDataTable';\r\nimport PatientDetails from './PatientDetails';\r\nimport EditPatient from './EditPatient'; // This will be used for adding a new patient\r\n\r\nconst AdminPage = () => {\r\n    const [selectedPatient, setSelectedPatient] = useState(null);\r\n    const [showAddPatient, setShowAddPatient] = useState(false);\r\n    const [editingPatient, setEditingPatient] = useState(null);\r\n\r\n    const handlePatientSelect = (patient) => {\r\n        setSelectedPatient(patient);\r\n    };\r\n\r\n    const handleAddPatient = () => {\r\n        setEditingPatient(null);\r\n        setShowAddPatient(true);\r\n    };\r\n\r\n    const handleEditPatient = (patient) => {\r\n        setEditingPatient(patient);\r\n        setShowAddPatient(true);\r\n    };\r\n\r\n    const handleCloseAddPatient = () => {\r\n        setShowAddPatient(false);\r\n    };\r\n\r\n    return (\r\n        <Box\r\n            pad=\"medium\"\r\n            background=\"#1c1c1c\" // Body background color\r\n            style={{ minHeight: '100vh' }} // Ensure the background fills the viewport\r\n        >\r\n            <Heading\r\n                level=\"2\"\r\n                color=\"#fff\" // Neon cyan text for specific headings\r\n                margin={{ bottom: 'small' }}\r\n            >\r\n                Admin Page\r\n            </Heading>\r\n\r\n            <Box\r\n                direction=\"row\"\r\n                justify=\"between\"\r\n                align=\"center\"\r\n                margin={{ bottom: 'medium' }}\r\n                background=\"#333333\" // Background for the top menu\r\n                pad=\"small\"\r\n                round=\"small\"\r\n            >\r\n                <Button\r\n                    icon={<Add />}\r\n                    label=\"Add New Patient\"\r\n                    onClick={handleAddPatient}\r\n                    primary\r\n                    color=\"#FFFFFF\" // Button text color\r\n                    style={{borderRadius: \"5px\"}}\r\n                />\r\n            </Box>\r\n\r\n            <Box\r\n                direction=\"row\"\r\n                gap=\"medium\"\r\n                background=\"#1c1c1c\" // Background for the left panel\r\n                pad=\"medium\"\r\n                round=\"small\"\r\n            >\r\n                <PatientDataTable onSelect={handlePatientSelect} onEdit={handleEditPatient} />\r\n            </Box>\r\n\r\n            {showAddPatient && (\r\n                <Layer\r\n                    position=\"center\"\r\n                    onClickOutside={handleCloseAddPatient}\r\n                    onEsc={handleCloseAddPatient}\r\n                >\r\n                    <Box\r\n                        pad=\"medium\"\r\n                        gap=\"small\"\r\n                        background=\"#1c1c1c\" // Layer content background\r\n                        round=\"small\"\r\n                    >\r\n                        <Heading level=\"3\" margin=\"none\" color=\"#fff\">\r\n                            {editingPatient ? 'Edit Patient' : 'Add New Patient'}\r\n                        </Heading>\r\n                        <EditPatient\r\n                            patient={editingPatient || {}}\r\n                            onClose={handleCloseAddPatient}\r\n                        />\r\n                    </Box>\r\n                </Layer>\r\n            )}\r\n        </Box>\r\n    );\r\n};\r\n\r\nexport default AdminPage;\r\n","C:\\Users\\Ajdurden8\\Documents\\GitHub\\physician-dashboard-upgraded\\new-directory-name\\src\\components\\ConsultList.js",[],"C:\\Users\\Ajdurden8\\Documents\\GitHub\\physician-dashboard-upgraded\\new-directory-name\\src\\pages\\Dashboard.js",["353","354","355","356","357","358","359","360"],"import React, { useState, useEffect } from 'react';\r\nimport { Grommet, Box } from 'grommet';\r\nimport SpeechRecognition, { useSpeechRecognition } from 'react-speech-recognition';\r\nimport patientService from '../services/patientService';\r\nimport { Container } from '../components/dashboard/StyledComponents';\r\nimport LeftPanel from '../components/dashboard/LeftPanel';\r\nimport MainPanel from '../components/dashboard/MainPanel';\r\nimport VoiceCommandHelp from \"../components/dashboard/VoiceCommandHelp\";\r\nimport PatientDetails from '../components/dashboard/popup-content/PatientDetails';\r\nimport Notes from '../components/dashboard/popup-content/Notes';\r\nimport Overview from '../components/dashboard/popup-content/Overview';\r\nimport Orders from \"../components/dashboard/popup-content/Orders\";\r\nimport Refills from \"../components/dashboard/popup-content/Refills\";\r\nimport Consult from \"../components/dashboard/popup-content/Consult\";\r\nimport Ambient from \"../components/dashboard/popup-content/Ambient\";\r\nimport Summary from \"../components/dashboard/popup-content/Summary\";\r\nimport AIInsights from \"../components/dashboard/popup-content/AIInsights\";\r\nimport Imaging from \"../components/dashboard/popup-content/Imaging\";\r\nimport Labs from \"../components/dashboard/popup-content/Labs\";\r\nimport Vitals from \"../components/dashboard/popup-content/Vitals\";\r\nimport Commands from \"../components/dashboard/popup-content/Commands\";\r\nimport { useResponsive } from '../contexts/ResponsiveContext';\r\n\r\nconst Dashboard = ({ popups, removePopup, addPopup }) => {\r\n    const [patients, setPatients] = useState([]);\r\n    const [loading, setLoading] = useState(false);\r\n    const [selectedPatient, setSelectedPatient] = useState(null);\r\n    const [chatHistory, setChatHistory] = useState([]);\r\n    const [inputText, setInputText] = useState('');\r\n    const [charts, setCharts] = useState([]);\r\n    const [dashboardCharts, setDashboardCharts] = useState(true);\r\n    const [onDemandCharts, setOnDemandCharts] = useState(false);\r\n    const { transcript, finalTranscript, listening, resetTranscript } = useSpeechRecognition();\r\n    const [activeContent, setActiveContent] = useState(null);\r\n    const [showVoiceHelp, setShowVoiceHelp] = useState(false);\r\n    const [popupMapping, setPopupMapping] = useState({});\r\n    const [isTriggered, setIsTriggered] = useState(false);\r\n\r\n\r\n    // State for tracking LeftPanel width\r\n    const [leftPanelWidth, setLeftPanelWidth] = useState(window.innerWidth > 768 ? 800 : '100%');\r\n    const [isResizing, setIsResizing] = useState(false); // Track if resizing\r\n\r\n    const { isMobile } = useResponsive();\r\n\r\n    // Handle resizing when the user clicks on the resizer bar\r\n    const handlePointerDown = (e) => {\r\n        setIsResizing(true);\r\n        e.preventDefault(); // Prevent default behavior\r\n        e.target.setPointerCapture(e.pointerId); // Capture pointer on the resizer\r\n    };\r\n\r\n    const handlePointerMove = (e) => {\r\n        if (!isResizing) return;\r\n        const newWidth = e.clientX;\r\n        if (newWidth > 200 && newWidth < window.innerWidth - 200) { // Limit min/max width\r\n            setLeftPanelWidth(newWidth);\r\n        }\r\n    };\r\n\r\n    const handlePointerUp = (e) => {\r\n        setIsResizing(false);\r\n        e.target.releasePointerCapture(e.pointerId); // Release the pointer capture\r\n    };\r\n\r\n    useEffect(() => {\r\n        // Attach event listeners to handle resizing while the pointer moves\r\n        document.addEventListener('pointermove', handlePointerMove);\r\n        document.addEventListener('pointerup', handlePointerUp);\r\n        return () => {\r\n            // Cleanup event listeners when the component unmounts\r\n            document.removeEventListener('pointermove', handlePointerMove);\r\n            document.removeEventListener('pointerup', handlePointerUp);\r\n        };\r\n    }, [isResizing]);\r\n\r\n    const fetchPatients = async () => {\r\n        setLoading(true);\r\n        try {\r\n            const patientData = await patientService.listPatientsWithCharts();\r\n            const mappedPatients = patientData.map(patient => ({\r\n                key: patient.Key,\r\n                name: patient.Record.name,\r\n                birthDate: patient.Record.birthDate,\r\n                gender: patient.Record.gender,\r\n                address: patient.Record.address,\r\n                email: patient.Record.communication.email,\r\n                phone: patient.Record.communication.home,\r\n                charts: patient.Record.charts || [],\r\n                ...patient.Record\r\n            }));\r\n            setPatients(mappedPatients);\r\n        } catch (error) {\r\n            console.error('Failed to fetch patients:', error);\r\n        } finally {\r\n            setLoading(false);\r\n        }\r\n    };\r\n\r\n    useEffect(() => {\r\n        fetchPatients();\r\n    }, []);\r\n\r\n    // useEffect to update popupMapping whenever isTriggered or selectedPatient changes\r\n    useEffect(() => {\r\n        console.log(\"triggered = \", isTriggered);\r\n            setPopupMapping({\r\n                'Patient Info': <PatientDetails patient={selectedPatient} />,\r\n                Overview: <Overview />,\r\n                Orders: <Orders />,\r\n                Refills: <Refills />,\r\n                Consult: <Consult />,\r\n                Notes: <Notes />,\r\n                Summary: <Summary />,\r\n                'AI Insights': <AIInsights />,\r\n                Imaging: <Imaging />,\r\n                Labs: <Labs />,\r\n                Vitals: <Vitals />,\r\n                Commands: <Commands />,\r\n            });\r\n    }, [selectedPatient]);\r\n\r\n    // Use another useEffect to handle the popup addition once popupMapping is updated\r\n    useEffect(() => {\r\n        console.log(\"triggered ambient dfirect = \", isTriggered);\r\n        if (isTriggered) {\r\n            addPopup('Ambient', <Ambient isTriggered={isTriggered} />); // Use the updated popupMapping\r\n        } else {\r\n            removePopupByContentType('Ambient');\r\n        }\r\n    }, [isTriggered]); // Run this effect when popupMapping or isTriggered changes\r\n\r\n\r\n    useEffect(() => {\r\n        if (!SpeechRecognition.browserSupportsSpeechRecognition()) {\r\n            console.warn(\"Browser doesn't support speech recognition.\");\r\n        }\r\n    }, []);\r\n\r\n    const sendMessage = async (prompt) => {\r\n        prompt = sanitizePrompt(prompt);\r\n        if (!prompt.trim()) return;  // Check for empty input\r\n        setLoading(true); // Set loading state\r\n        const currentTime = new Date().toLocaleTimeString();\r\n\r\n        try {\r\n            let fullPrompt = `${selectedPatient?.name}: \\n${prompt}`;\r\n\r\n            setChatHistory(currentHistory => [\r\n                ...currentHistory,\r\n                { type: 'user', text: prompt, label: 'USER', timestamp: currentTime }\r\n            ]);\r\n\r\n            const requestOptions = {\r\n                method: 'POST',\r\n                headers: { \r\n                    'Content-Type': 'application/json',\r\n                    'Accept': 'application/json'\r\n                },\r\n                body: JSON.stringify({ \r\n                    prompt: fullPrompt,\r\n                    max_tokens: 1000,\r\n                    temperature: 0.7\r\n                })\r\n            };\r\n\r\n            const response = await fetch('https://us-east4-agama-qrf-poc.cloudfunctions.net/generate-ai-charts-1-anthropic', requestOptions);\r\n            if (!response.ok) {\r\n                throw new Error(`HTTP error! status: ${response.status}`);\r\n            }\r\n            const data = await response.json();\r\n            \r\n            if (data && typeof data === 'object') {\r\n                const messageContent = data.response || data.completion || data;\r\n                const promptType = messageContent.includes('<html') ? 'chart' : 'question';\r\n\r\n                if (promptType === 'chart') {\r\n                    let htmlContent = messageContent.match(/<html\\b[^>]*>[\\s\\S]*<\\/html>/i);\r\n                    let cleanedScript = htmlContent ? htmlContent[0] : '';\r\n                    let newChartTitle = 'New Chart';\r\n\r\n                    let chartData = {\r\n                        patientId: selectedPatient.key,\r\n                        chartId: undefined,\r\n                        chartTitle: newChartTitle,\r\n                        chartDescription: 'dynamic',\r\n                        chartHTML: cleanedScript,\r\n                        Record: {\r\n                            chartId: undefined,\r\n                            chartTitle: newChartTitle,\r\n                            chartDescription: 'dynamic',\r\n                            chartHTML: cleanedScript,\r\n                        }\r\n                    };\r\n\r\n                    const updatedPatient = {\r\n                        ...selectedPatient,\r\n                        charts: [...selectedPatient.charts, chartData]\r\n                    };\r\n\r\n                    setSelectedPatient(updatedPatient);\r\n                    setCharts(updatedPatient.charts);\r\n\r\n                    setChatHistory(currentHistory => [\r\n                        ...currentHistory,\r\n                        { type: 'ai', text: `${newChartTitle} created.`, label: 'Agama AI', timestamp: new Date().toLocaleTimeString() }\r\n                    ]);\r\n                } else {\r\n                    setChatHistory(currentHistory => [\r\n                        ...currentHistory,\r\n                        { type: 'ai', text: messageContent, label: 'Agama AI', timestamp: new Date().toLocaleTimeString() }\r\n                    ]);\r\n                }\r\n            } else {\r\n                throw new Error('Invalid response format');\r\n            }\r\n        } catch (error) {\r\n            console.error('Error fetching data:', error);\r\n            setChatHistory(currentHistory => [\r\n                ...currentHistory,\r\n                { type: 'ai', text: 'Failed to fetch data', label: 'Agama AI', timestamp: new Date().toISOString() }\r\n            ]);\r\n        } finally {\r\n            setLoading(false);\r\n        }\r\n\r\n        setInputText('');\r\n        resetTranscript();\r\n    };\r\n\r\n    // Function to handle voice command interactions\r\n    const handleVoiceCommand = () => {\r\n        if (listening) {\r\n            SpeechRecognition.stopListening();\r\n            setInputText('');\r\n        } else {\r\n            resetTranscript();\r\n            setInputText('');\r\n            SpeechRecognition.startListening({ continuous: true });\r\n        }\r\n    };\r\n\r\n    const handleIframeLoad = (event) => {\r\n        const iframe = event.target;\r\n        const iframeDocument = iframe.contentDocument || iframe.contentWindow.document;\r\n        if (iframeDocument) {\r\n            const body = iframeDocument.body;\r\n            const html = iframeDocument.documentElement;\r\n            const height = Math.max(\r\n                body.scrollHeight,\r\n                body.offsetHeight,\r\n                html.clientHeight,\r\n                html.scrollHeight,\r\n                html.offsetHeight\r\n            );\r\n            iframe.style.height = '100%';\r\n        }\r\n    };\r\n\r\n    // Function to remove a popup by content type\r\n    const removePopupByContentType = (contentType) => {\r\n        const popupToRemove = popups.find((popup) => popup.contentType === contentType);\r\n        if (popupToRemove) {\r\n            removePopup(popupToRemove.id);\r\n        }\r\n    };\r\n\r\n// Voice command actions mapped to add or remove popups and other commands\r\n    const commandActions = {\r\n        // Open commands with both contentType and content\r\n        'openpatientinfo': () => addPopup('Patient Info', popupMapping['Patient Info']),\r\n        'openoverview': () => addPopup('Overview', popupMapping['Overview']),\r\n        'openorders': () => addPopup('Orders', popupMapping['Orders']),\r\n        'openrefills': () => addPopup('Refills', popupMapping['Refills']),\r\n        'openconsult': () => addPopup('Consult', popupMapping['Consult']),\r\n        'openambient': () => {\r\n            setIsTriggered(true);\r\n            //addPopup('Ambient', popupMapping['Ambient']);\r\n        },\r\n        'opennotes': () => addPopup('Notes', popupMapping['Notes']),\r\n        'opensummary': () => addPopup('Summary', popupMapping['Summary']),\r\n        'openaiinsights': () => addPopup('AI Insights', popupMapping['AI Insights']),\r\n        'openimaging': () => addPopup('Imaging', popupMapping['Imaging']),\r\n        'openlabs': () => addPopup('Labs', popupMapping['Labs']),\r\n        'openvitals': () => addPopup('Vitals', popupMapping['Vitals']),\r\n        'opencommands': () => addPopup('Commands', popupMapping['Commands']),\r\n\r\n        // Close commands remain the same, just remove by contentType\r\n        'hidepatientinfo': () => removePopupByContentType('Patient Info'),\r\n        'hideoverview': () => removePopupByContentType('Overview'),\r\n        'hideorders': () => removePopupByContentType('Orders'),\r\n        'hiderefills': () => removePopupByContentType('Refills'),\r\n        'hideconsult': () => removePopupByContentType('Consult'),\r\n        'hideambient': () => {\r\n            setIsTriggered(false);\r\n            //removePopupByContentType('Ambient');\r\n        },\r\n        'hidenotes': () => removePopupByContentType('Notes'),\r\n        'hidesummary': () => removePopupByContentType('Summary'),\r\n        'hideaiinsights': () => removePopupByContentType('AI Insights'),\r\n        'hideimaging': () => removePopupByContentType('Imaging'),\r\n        'hidelabs': () => removePopupByContentType('Labs'),\r\n        'hidevitals': () => removePopupByContentType('Vitals'),\r\n        'hidecommands': () => removePopupByContentType('Commands'),\r\n        // New command to close all popups\r\n        'closealltabs': () => removeAllPopups(),\r\n        // New command to close all popups\r\n        'hidealltabs': () => removeAllPopups(),\r\n\r\n        // Control commands\r\n        'stoplistening': () => {\r\n            SpeechRecognition.stopListening();\r\n            setInputText('');\r\n            setShowVoiceHelp(false);\r\n            resetTranscript();\r\n        },\r\n        'send': () => sendMessage(inputText),\r\n        'erase': () => {\r\n            setInputText('');\r\n            resetTranscript();\r\n        },\r\n        'showvoicecommands': () => setShowVoiceHelp(true),\r\n        'hidevoicecommands': () => setShowVoiceHelp(false),\r\n\r\n        // Toggle commands\r\n        'hidedashboardcharts': () => setDashboardCharts(false),\r\n        'showdashboardcharts': () => setDashboardCharts(true),\r\n        'hideliveviewcharts': () => setOnDemandCharts(false),\r\n        'showliveviewcharts': () => setOnDemandCharts(true),\r\n    };\r\n\r\n    const removeAllPopups = () => {\r\n        // Loop through all popups and remove each by its ID\r\n        popups.forEach((popup) => {\r\n            removePopup(popup.id);\r\n        });\r\n    };\r\n\r\n    // Function to sanitize the prompt and remove any known commands\r\n    const sanitizePrompt = (prompt) => {\r\n        const commandsToRemove = [\r\n            'hide voice commands',\r\n            'show voice commands',\r\n            'open patient info',\r\n            'open overview',\r\n            'open orders',\r\n            'open refills',\r\n            'open consult',\r\n            'open ambient',\r\n            'open notes',\r\n            'open summary',\r\n            'open ai insights',\r\n            'open imaging',\r\n            'open labs',\r\n            'open vitals',\r\n            'open commands',\r\n            'hide patient info',\r\n            'hide overview',\r\n            'hide orders',\r\n            'hide refills',\r\n            'hide consult',\r\n            'hide ambient',\r\n            'hide notes',\r\n            'hide summary',\r\n            'hide ai insights',\r\n            'hide imaging',\r\n            'hide labs',\r\n            'hide vitals',\r\n            'hide commands',\r\n            'stop listening',\r\n            'send',\r\n            'erase',\r\n            'open vitals tab',\r\n            'close ai insights',\r\n            'open consult notes',\r\n            'show ai recommendations',\r\n            'close floating panel',\r\n            'hide dashboard charts',\r\n            'hide live view charts',\r\n            'show dashboard charts',\r\n            'show live view charts',\r\n        ];\r\n\r\n        // Remove each command from the prompt\r\n        let sanitizedPrompt = prompt;\r\n        commandsToRemove.forEach((command) => {\r\n            const regex = new RegExp(`\\\\b${command}\\\\b`, 'gi'); // Use word boundaries to prevent partial matches\r\n            sanitizedPrompt = sanitizedPrompt.replace(regex, '').trim();\r\n        });\r\n\r\n        return sanitizedPrompt;\r\n    };\r\n\r\n\r\n    useEffect(() => {\r\n        if (finalTranscript) {\r\n            const normalizedTranscript = finalTranscript.toLowerCase().replace(/\\s+/g, '');\r\n            Object.keys(commandActions).forEach((command) => {\r\n                if (normalizedTranscript.includes(command)) {\r\n                    commandActions[command](); // Execute the detected command\r\n                }\r\n            });\r\n            setInputText((prevInputText) => prevInputText + ' ' + finalTranscript);\r\n            resetTranscript();\r\n        }\r\n    }, [finalTranscript]);\r\n\r\n    const handleButtonClick = (content) => {\r\n        setActiveContent(activeContent === content ? null : content);\r\n    };\r\n\r\n    const handleToggleButtonClick = (buttonType) => {\r\n        if (buttonType === 'dashboard') {\r\n            setDashboardCharts(!dashboardCharts);\r\n        } else if (buttonType === 'onDemand') {\r\n            setOnDemandCharts(!onDemandCharts);\r\n        }\r\n    };\r\n\r\n    useEffect(() => {\r\n        const handleResize = () => {\r\n            if (window.innerWidth <= 768) {\r\n                setLeftPanelWidth('100%');\r\n            }\r\n        };\r\n        window.addEventListener('resize', handleResize);\r\n        return () => window.removeEventListener('resize', handleResize);\r\n    }, []);\r\n\r\n    return (\r\n        <Grommet>\r\n            <Container direction=\"row\">\r\n                {/* Left Panel with dynamic width */}\r\n                <Box direction=\"column\" width={`${leftPanelWidth}px`} height=\"100vh\">\r\n                    {showVoiceHelp && <VoiceCommandHelp onClose={() => setShowVoiceHelp(false)} />}\r\n                    <LeftPanel\r\n                        activeContent={activeContent}\r\n                        setActiveContent={setActiveContent}\r\n                        selectedPatient={selectedPatient}\r\n                        setSelectedPatient={setSelectedPatient}\r\n                        handleButtonClick={handleButtonClick}\r\n                        handleToggleButtonClick={handleToggleButtonClick}\r\n                        dashboardCharts={dashboardCharts}\r\n                        onDemandCharts={onDemandCharts}\r\n                        chatHistory={chatHistory}\r\n                        inputText={inputText}\r\n                        setInputText={setInputText}\r\n                        sendMessage={sendMessage}\r\n                        handleVoiceCommand={handleVoiceCommand}\r\n                        listening={listening}\r\n                        loading={loading}\r\n                        setLoading={setLoading}\r\n                        setLeftPanelWidth={setLeftPanelWidth}\r\n                        popups={popups}\r\n                        addPopup={addPopup}\r\n                        removePopup={removePopup}\r\n                    />\r\n                </Box>\r\n\r\n                {/* Resizer Button */}\r\n                <div\r\n                    style={{\r\n                        width: '6px',\r\n                        height: '50px',\r\n                        background: '#888',\r\n                        borderRadius: '5px',\r\n                        cursor: 'ew-resize',\r\n                        position: 'relative',\r\n                        top: '50%',\r\n                        left: '0px',\r\n                        transform: 'translateY(-50%)',\r\n                        zIndex: 800,\r\n                    }}\r\n                    onPointerDown={handlePointerDown}\r\n                />\r\n\r\n                {/* Main Panel that grows as LeftPanel resizes */}\r\n                <Box\r\n                    direction=\"column\"\r\n                    flex=\"grow\"\r\n                    height=\"100vh\"\r\n                    style={{ transition: 'width 0.3s ease-in-out' }}\r\n                >\r\n                    <MainPanel\r\n                        selectedPatient={selectedPatient}\r\n                        handleIframeLoad={handleIframeLoad}\r\n                        dashboardCharts={dashboardCharts}\r\n                        onDemandCharts={onDemandCharts}\r\n                        charts={charts}\r\n                    />\r\n                </Box>\r\n            </Container>\r\n        </Grommet>\r\n    );\r\n};\r\n\r\nexport default Dashboard;\r\n","C:\\Users\\Ajdurden8\\Documents\\GitHub\\physician-dashboard-upgraded\\new-directory-name\\src\\pages\\Account.js",[],"C:\\Users\\Ajdurden8\\Documents\\GitHub\\physician-dashboard-upgraded\\new-directory-name\\src\\contexts\\ResponsiveContext.js",[],"C:\\Users\\Ajdurden8\\Documents\\GitHub\\physician-dashboard-upgraded\\new-directory-name\\src\\pages\\NotFound.js",[],"C:\\Users\\Ajdurden8\\Documents\\GitHub\\physician-dashboard-upgraded\\new-directory-name\\src\\pages\\AgamaPatientPortal.js",[],"C:\\Users\\Ajdurden8\\Documents\\GitHub\\physician-dashboard-upgraded\\new-directory-name\\src\\components\\PatientDataTable.js",[],"C:\\Users\\Ajdurden8\\Documents\\GitHub\\physician-dashboard-upgraded\\new-directory-name\\src\\styles\\StyledComponents.js",[],"C:\\Users\\Ajdurden8\\Documents\\GitHub\\physician-dashboard-upgraded\\new-directory-name\\src\\components\\PatientDetails.js",[],"C:\\Users\\Ajdurden8\\Documents\\GitHub\\physician-dashboard-upgraded\\new-directory-name\\src\\components\\EditPatient.js",["361"],"import React, { useState, useEffect } from 'react';\r\nimport { Box, Button, Form, Tabs, Tab, FileInput, Layer, Text, Spinner } from 'grommet';\r\nimport { Notification, StatusGood } from 'grommet-icons';\r\nimport styled from 'styled-components';\r\nimport patientService from '../services/patientService';\r\nimport PatientDemographics from './PatientDemographics';\r\nimport AllergiesMedications from './AllergiesMedications';\r\nimport ProblemsProcedures from './ProblemsProcedures';\r\nimport SocialHistoryVitalSigns from './SocialHistoryVitalSigns';\r\nimport PatientCharts from './PatientCharts';\r\nimport { defaultPatientData } from '../data/staticData';\r\nimport { formatToJsonString } from '../utils/chartUtils';\r\n\r\n// Styled component for tabs with dark theme and highlight\r\nconst StyledTabs = styled(Tabs)`\r\n  div[role='tablist'] > div > button {\r\n    color: #f0f0f0 !important; // Default text color\r\n    font-weight: normal;\r\n    border-bottom: none !important; // Remove underline or bottom border\r\n    background: transparent;\r\n    box-shadow: none;\r\n    padding: 0;\r\n    margin-right: 10px;\r\n\r\n    &:focus {\r\n      outline: none;\r\n    }\r\n\r\n    &[aria-selected='true'] {\r\n      color: #FFFFFF !important; // Text color for selected tab\r\n      font-weight: bold;\r\n      border-bottom: none !important; // Remove underline or bottom border on selected tab\r\n    }\r\n\r\n    &:hover {\r\n      color: #555555 !important; // Hover background for tabs\r\n    }\r\n\r\n    span {\r\n      color: inherit !important;\r\n      text-decoration: none !important; // Remove any underline on the text itself\r\n    }\r\n  }\r\n\r\n  div[class*=\"StyledTab\"] {\r\n    border-bottom: none !important; // Ensure no border-bottom is applied to tab container\r\n  }\r\n\r\n  div.bnhxvU {\r\n    border-bottom: none !important; // Explicitly target the div with border-bottom and override it\r\n  }\r\n`;\r\n\r\nconst StyledButton = styled(Button)`\r\n  background-color: #444444; /* Default button background */\r\n  color: #FFFFFF; /* Button text color */\r\n  border: 1px solid #444444; /* Button border color */\r\n  border-radius: 5px; /* Border radius as per color scheme */\r\n\r\n  &:hover {\r\n    background-color: #555555; /* Hover background color */\r\n    border: 1px solid #555555 !important; /* Ensure no border on hover */\r\n    box-shadow: none !important; /* Remove any box-shadow on hover */\r\n  }\r\n\r\n  &:focus {\r\n    outline: none !important; /* Remove focus outline */\r\n    box-shadow: none !important; /* Remove focus box-shadow */\r\n  }\r\n\r\n  &:active {\r\n    background-color: #666666; /* Optional: active background color */\r\n  }\r\n`;\r\n\r\nconst EditPatient = ({ patient = defaultPatientData, onClose }) => {\r\n    const initialFormValues = {\r\n        gender: '',\r\n        birthDate: '',\r\n        address: '',\r\n        name: '',\r\n        aliases: [],\r\n        communication: [],\r\n        language: '',\r\n        raceEthnicity: '',\r\n        maritalStatus: '',\r\n        allergies: [],\r\n        medications: [],\r\n        problems: [],\r\n        procedures: [],\r\n        socialHistory: {\r\n            smokingTobacco: '',\r\n            smokelessTobacco: '',\r\n            tobaccoCessation: '',\r\n            sexAssignedAtBirth: '',\r\n            genderIdentity: '',\r\n            sexualOrientation: '',\r\n        },\r\n        vitals: {\r\n            bloodPressure: '',\r\n            pulse: '',\r\n            temperature: '',\r\n            respiratoryRate: '',\r\n            oxygenSaturation: '',\r\n            inhaledOxygenConcentration: '',\r\n            weight: '',\r\n            height: '',\r\n            bmi: '',\r\n            comments: ''\r\n        },\r\n        charts: []\r\n    };\r\n\r\n    const [formValues, setFormValues] = useState(initialFormValues);\r\n    const [activeTab, setActiveTab] = useState(0);\r\n    const [showUpload, setShowUpload] = useState(false);\r\n    const [uploadedFile, setUploadedFile] = useState(null);\r\n    const [showNotification, setShowNotification] = useState(false);\r\n    const [notificationMessage, setNotificationMessage] = useState('');\r\n    const [isLoading, setIsLoading] = useState(false);\r\n    const [isAdmin, setIsAdmin] = useState(false);\r\n\r\n    useEffect(() => {\r\n        const userRole = localStorage.getItem('userRole');\r\n        if (userRole === 'admin') {\r\n            setIsAdmin(true);\r\n        }\r\n    }, []);\r\n\r\n    useEffect(() => {\r\n        const isEmptyObject = Object.keys(patient).length === 0;\r\n        const data = isEmptyObject ? defaultPatientData : { ...defaultPatientData, ...patient };\r\n\r\n        setFormValues({\r\n            id: patient.key || null,\r\n            gender: data.gender || '',\r\n            birthDate: data.birthDate || '',\r\n            address: data.address || '',\r\n            name: data.name || '',\r\n            aliases: Array.isArray(data.aliases) ? data.aliases : data.aliases ? [data.aliases] : [],\r\n            communication: data.communication || [],\r\n            language: data.language || '',\r\n            raceEthnicity: data.raceEthnicity || '',\r\n            maritalStatus: data.maritalStatus || '',\r\n            allergies: data.allergies || [],\r\n            medications: data.medications || [],\r\n            problems: data.problems || [],\r\n            procedures: data.procedures || [],\r\n            socialHistory: data.socialHistory || {\r\n                smokingTobacco: '',\r\n                smokelessTobacco: '',\r\n                tobaccoCessation: '',\r\n                sexAssignedAtBirth: '',\r\n                genderIdentity: '',\r\n                sexualOrientation: '',\r\n            },\r\n            vitals: data.vitals || {\r\n                bloodPressure: '',\r\n                pulse: '',\r\n                temperature: '',\r\n                respiratoryRate: '',\r\n                oxygenSaturation: '',\r\n                inhaledOxygenConcentration: '',\r\n                weight: '',\r\n                height: '',\r\n                bmi: '',\r\n                comments: ''\r\n            },\r\n            charts: data.charts || []\r\n        });\r\n    }, [patient]);\r\n\r\n    const handleUpdate = (updatedValues) => {\r\n        setFormValues((prevValues) => ({\r\n            ...prevValues,\r\n            ...updatedValues,\r\n        }));\r\n    };\r\n\r\n    const handleSubmit = async (event) => {\r\n        event.preventDefault();\r\n\r\n        const userRole = localStorage.getItem('userRole');\r\n        if (userRole !== 'admin') {\r\n            return; // Exit function if user is not an admin\r\n        }\r\n        setIsLoading(true);\r\n\r\n        const communicationArray = Array.isArray(formValues.communication)\r\n            ? formValues.communication\r\n            : Object.entries(formValues.communication || {}).map(([type, value]) => ({ type, value }));\r\n\r\n        const updatedFormValues = {\r\n            ...formValues,\r\n            communication: communicationArray.reduce((acc, { type, value }) => {\r\n                acc[type] = value;\r\n                return acc;\r\n            }, {}),\r\n        };\r\n\r\n        try {\r\n            let patientId;\r\n\r\n            const sanitizedFormValues = { ...updatedFormValues };\r\n            delete sanitizedFormValues.charts;\r\n\r\n            if (patient?.key) {\r\n                await patientService.updatePatient(patient.key, sanitizedFormValues);\r\n                patientId = patient.key;\r\n            } else {\r\n                const newPatient = await patientService.createPatient(sanitizedFormValues);\r\n                patientId = newPatient.patientId;\r\n            }\r\n\r\n            setFormValues((prevValues) => ({\r\n                ...prevValues,\r\n                id: patientId,\r\n            }));\r\n\r\n            onClose();\r\n        } catch (error) {\r\n            console.error(\"Error submitting form:\", error);\r\n        } finally {\r\n            setIsLoading(false);\r\n        }\r\n    };\r\n\r\n    const handleFileChange = (event) => {\r\n        const file = event.target.files[0];\r\n        setUploadedFile(file);\r\n    };\r\n\r\n    const handleUpload = async () => {\r\n        if (!uploadedFile) return;\r\n\r\n        const formData = new FormData();\r\n        formData.append('file', uploadedFile);\r\n\r\n        try {\r\n            const response = await fetch('https://qft.agamanetworks.com/process-file', {\r\n                method: 'POST',\r\n                headers: {\r\n                    'Authorization': 'mYetb4Ue52UqZfKFQxhG!',\r\n                },\r\n                body: formData,\r\n            });\r\n\r\n            if (response.ok) {\r\n                const data = await response.json();\r\n                let patientDataString = data.patientData;\r\n\r\n                if (patientDataString.endsWith(';')) {\r\n                    patientDataString = patientDataString.slice(0, -1);\r\n                }\r\n\r\n                patientDataString = formatToJsonString(patientDataString);\r\n\r\n                const patientData = eval(`(${patientDataString})`);\r\n\r\n                setFormValues((prevValues) => ({\r\n                    ...prevValues,\r\n                    ...patientData,\r\n                }));\r\n\r\n                setNotificationMessage(`${patientData.name} has been uploaded and parsed successfully!`);\r\n                setShowNotification(true);\r\n                setShowUpload(false);\r\n            } else {\r\n                console.error('Upload failed');\r\n                setNotificationMessage('Upload failed');\r\n                setShowNotification(true);\r\n            }\r\n        } catch (error) {\r\n            console.error('Error uploading file:', error);\r\n            setNotificationMessage('Error uploading file');\r\n            setShowNotification(true);\r\n        }\r\n    };\r\n\r\n    return (\r\n        <Box pad=\"medium\" width=\"80vw\" background=\"#1c1c1c\">\r\n            {isLoading && (\r\n                <Layer>\r\n                    <Box pad=\"large\" align=\"center\" gap=\"small\" background=\"#333\">\r\n                        <Spinner />\r\n                        <Text color=\"#f0f0f0\">Processing...</Text>\r\n                    </Box>\r\n                </Layer>\r\n            )}\r\n            <Box align=\"center\" margin={{ bottom: 'medium' }}>\r\n                <Button\r\n                    label=\"Upload Document\"\r\n                    onClick={() => setShowUpload(true)}\r\n                    color=\"#FFFFFF\"\r\n                    plain\r\n                />\r\n            </Box>\r\n\r\n            {showUpload && (\r\n                <Layer\r\n                    onEsc={() => setShowUpload(false)}\r\n                    onClickOutside={() => setShowUpload(false)}\r\n                    background=\"#333\"\r\n                >\r\n                    <Box pad=\"medium\" gap=\"small\">\r\n                        <FileInput\r\n                            name=\"file\"\r\n                            onChange={handleFileChange}\r\n                        />\r\n                        <Button\r\n                            label=\"Upload\"\r\n                            onClick={handleUpload}\r\n                            color=\"#FFFFFF\"\r\n                            style={{ backgroundColor: '#444444' }}\r\n                            hoverIndicator={{ background: '#555555' }}\r\n                        />\r\n                    </Box>\r\n                </Layer>\r\n            )}\r\n\r\n            {showNotification && (\r\n                <Layer\r\n                    position=\"top\"\r\n                    modal={false}\r\n                    margin={{ vertical: 'medium', horizontal: 'small' }}\r\n                    onEsc={() => setShowNotification(false)}\r\n                    responsive={false}\r\n                    plain\r\n                >\r\n                    <Box\r\n                        align=\"center\"\r\n                        direction=\"row\"\r\n                        gap=\"small\"\r\n                        justify=\"between\"\r\n                        round=\"small\"\r\n                        elevation=\"medium\"\r\n                        pad={{ vertical: 'xsmall', horizontal: 'small' }}\r\n                        background=\"status-ok\"\r\n                    >\r\n                        <Box align=\"center\" direction=\"row\" gap=\"xsmall\">\r\n                            <StatusGood />\r\n                            <Text>{notificationMessage}</Text>\r\n                        </Box>\r\n                        <Button\r\n                            icon={<Notification />}\r\n                            onClick={() => setShowNotification(false)}\r\n                            plain\r\n                        />\r\n                    </Box>\r\n                </Layer>\r\n            )}\r\n\r\n            <Form onSubmit={handleSubmit}>\r\n                <StyledTabs activeIndex={activeTab} onActive={(index) => setActiveTab(index)}>\r\n                    <Tab title=\"Demographics\">\r\n                        <Box\r\n                            pad={{ vertical: 'large' }}\r\n                            style={{\r\n                                height: '60vh', // Full viewport height\r\n                                overflowY: 'auto', // Enable vertical scrolling on the parent\r\n                                overflowX: 'hidden', // Avoid horizontal scrolling\r\n                            }}\r\n                        >\r\n                            <PatientDemographics demographics={formValues} onUpdate={handleUpdate} />\r\n                        </Box>\r\n                    </Tab>\r\n                    <Tab title=\"Allergies & Medications\">\r\n                        <Box\r\n                            pad={{ vertical: 'large' }}\r\n                            style={{\r\n                                height: '60vh', // Full viewport height\r\n                                overflowY: 'auto', // Enable vertical scrolling on the parent\r\n                                overflowX: 'hidden', // Avoid horizontal scrolling\r\n                            }}\r\n                        >\r\n                            <AllergiesMedications\r\n                                allergies={formValues.allergies}\r\n                                medications={formValues.medications}\r\n                                onAllergiesUpdate={(updatedAllergies) => handleUpdate({ allergies: updatedAllergies })}\r\n                                onMedicationsUpdate={(updatedMedications) => handleUpdate({ medications: updatedMedications })}\r\n                            />\r\n                        </Box>\r\n                    </Tab>\r\n                    <Tab title=\"Problems & Procedures\">\r\n                        <Box\r\n                            pad={{ vertical: 'large' }}\r\n                            style={{\r\n                                height: '60vh', // Full viewport height\r\n                                overflowY: 'auto', // Enable vertical scrolling on the parent\r\n                                overflowX: 'hidden', // Avoid horizontal scrolling\r\n                            }}\r\n                        >\r\n                            <ProblemsProcedures\r\n                                problems={formValues.problems}\r\n                                procedures={formValues.procedures}\r\n                                onProblemsUpdate={(updatedProblems) => handleUpdate({ problems: updatedProblems })}\r\n                                onProceduresUpdate={(updatedProcedures) => handleUpdate({ procedures: updatedProcedures })}\r\n                            />\r\n                        </Box>\r\n                    </Tab>\r\n                    <Tab title=\"Social History & Vital Signs\">\r\n                        <Box\r\n                            pad={{ vertical: 'large' }}\r\n                            style={{\r\n                                height: '60vh', // Full viewport height\r\n                                overflowY: 'auto', // Enable vertical scrolling on the parent\r\n                                overflowX: 'hidden', // Avoid horizontal scrolling\r\n                            }}\r\n                        >\r\n                            <SocialHistoryVitalSigns\r\n                                socialHistory={formValues.socialHistory}\r\n                                vitalSigns={formValues.vitals}\r\n                                onSocialHistoryUpdate={(updatedSocialHistory) => handleUpdate({ socialHistory: updatedSocialHistory })}\r\n                                onVitalSignsUpdate={(updatedVitalSigns) => handleUpdate({ vitals: updatedVitalSigns })}\r\n                            />\r\n                        </Box>\r\n                    </Tab>\r\n                    <Tab title=\"Patient Charts\" disabled={!formValues.id}>\r\n                        <Box\r\n                            pad={{ vertical: 'large' }}\r\n                            style={{\r\n                                height: '60vh', // Full viewport height\r\n                                overflowY: 'auto', // Enable vertical scrolling on the parent\r\n                                overflowX: 'hidden', // Avoid horizontal scrolling\r\n                            }}\r\n                        >\r\n                            <PatientCharts\r\n                                patientId={formValues.id}\r\n                                charts={formValues.charts}\r\n                                onChartsUpdate={(updatedCharts) => handleUpdate({ charts: updatedCharts })}\r\n                            />\r\n                        </Box>\r\n                    </Tab>\r\n                </StyledTabs>\r\n                <Box direction=\"row\" gap=\"medium\" margin={{ top: 'medium' }}>\r\n                    <StyledButton\r\n                        type=\"submit\"\r\n                        label=\"Save\"\r\n                        primary\r\n                        disabled={!isAdmin}\r\n                        style={{ backgroundColor: '#444444', color: '#FFFFFF' }}\r\n                    />\r\n                    <StyledButton\r\n                        type=\"button\"\r\n                        label=\"Cancel\"\r\n                        onClick={onClose}\r\n                        style={{ backgroundColor: '#555555', color: '#FFFFFF' }}\r\n                    />\r\n                </Box>\r\n            </Form>\r\n        </Box>\r\n    );\r\n};\r\n\r\nexport default EditPatient;\r\n","C:\\Users\\Ajdurden8\\Documents\\GitHub\\physician-dashboard-upgraded\\new-directory-name\\src\\components\\patient-portal\\HealthRecordsCard.js",["362"],"import React from 'react';\r\n\r\nconst HealthRecordsCard = () => {\r\n    const buttonStyle = {\r\n        backgroundColor: '#00BCD4', // Adjust this color as needed\r\n        color: 'white',\r\n        padding: '10px 20px',\r\n        margin: '5px', // Add margin to create space between buttons\r\n        border: 'none',\r\n        borderRadius: '5px',\r\n        cursor: 'pointer',\r\n        fontSize: '16px',\r\n    };\r\n\r\n    return (\r\n        <div className=\"card\">\r\n            <h2>Your Health Records</h2>\r\n            <button className=\"btn\" style={{marginRight: \"15px\"}}>View Health Records</button>\r\n            <button className=\"btn\" style={{marginRight: \"15px\"}}>Add New Records</button>\r\n            <button className=\"btn\" style={{marginRight: \"15px\"}}>Save My Records</button>\r\n        </div>\r\n    );\r\n};\r\n\r\nexport default HealthRecordsCard;\r\n","C:\\Users\\Ajdurden8\\Documents\\GitHub\\physician-dashboard-upgraded\\new-directory-name\\src\\components\\patient-portal\\AppointmentCard.js",[],"C:\\Users\\Ajdurden8\\Documents\\GitHub\\physician-dashboard-upgraded\\new-directory-name\\src\\components\\patient-portal\\Footer.js",[],"C:\\Users\\Ajdurden8\\Documents\\GitHub\\physician-dashboard-upgraded\\new-directory-name\\src\\components\\patient-portal\\MedicalJournalCard.js",[],"C:\\Users\\Ajdurden8\\Documents\\GitHub\\physician-dashboard-upgraded\\new-directory-name\\src\\components\\patient-portal\\ChatBoxCard.js",[],"C:\\Users\\Ajdurden8\\Documents\\GitHub\\physician-dashboard-upgraded\\new-directory-name\\src\\components\\patient-portal\\UpdateInfoCard.js",[],"C:\\Users\\Ajdurden8\\Documents\\GitHub\\physician-dashboard-upgraded\\new-directory-name\\src\\components\\patient-portal\\SettingsCard.js",[],"C:\\Users\\Ajdurden8\\Documents\\GitHub\\physician-dashboard-upgraded\\new-directory-name\\src\\components\\dashboard\\StyledComponents.js",["363"],"import styled from 'styled-components';\r\nimport {Box, Button, TextInput, Text, TextArea} from 'grommet';\r\n\r\nexport const Container = styled(Box)`\r\n  height: 96.9vh;\r\n  margin: 0;\r\n  overflow: hidden;\r\n  background-color: #1c1c1c;\r\n  color: black;\r\n  font-family: Arial, sans-serif;\r\n`;\r\n\r\nexport const LeftPanel = styled(Box)`\r\n  background-color: #1c1c1c;\r\n  display: flex;\r\n  flex-direction: column;\r\n  padding: 10px;\r\n  padding-bottom: 50px;\r\n`;\r\n\r\nexport const MainPanel = styled(Box)`\r\n  flex: 1;\r\n  //padding: 20px;\r\n  overflow-y: auto;\r\n`;\r\n\r\nexport const StyledChatContainer = styled(Box)`\r\n  min-height: fit-content;\r\n  height: 100%;\r\n  flex: 1;\r\n  display: flex;\r\n  flex-direction: column;\r\n  border: 0px solid #333;\r\n  color: white;\r\n  background-color: #444;\r\n  border-radius: 5px;\r\n\r\n  /* Ensuring the chat container itself does not overflow */\r\n  overflow: hidden;\r\n\r\n  @media screen and (max-width: 768px) {\r\n    width: 100%;\r\n    margin: 0;\r\n    border-radius: 0;\r\n  }\r\n`;\r\n\r\n\r\nexport const StyledButton = styled(Button)`\r\n  margin-bottom: 10px;\r\n  padding: 10px;\r\n  border: none;\r\n  cursor: pointer;\r\n  background-color: #333;\r\n  color: #fff;\r\n  width: 100%;\r\n  text-align: left;\r\n  outline: none;\r\n  font-size: 1em;\r\n  border-radius: 5px;\r\n  box-shadow: none;\r\n\r\n  &:hover {\r\n    background-color: #555;\r\n  }\r\n`;\r\n\r\nexport const ToggleButton = styled(Button)`\r\n  margin-bottom: 2.5px;\r\n  padding: 10px;\r\n  border: none;\r\n  cursor: pointer;\r\n  background-color: #333;\r\n  color: #fff;\r\n  width: 100%;\r\n  text-align: left;\r\n  outline: none;\r\n  font-size: 1em;\r\n  border-radius: 5px;\r\n  box-shadow: none;\r\n  display: flex;\r\n  align-items: center;\r\n\r\n  &:hover {\r\n    background-color: #555;\r\n  }\r\n\r\n  .icon {\r\n    margin-left: auto;\r\n    margin-right: 0;\r\n  }\r\n`;\r\n\r\nexport const StyledCard = styled(Box)`\r\n  background-color: #333;\r\n  border: 0px solid #444;\r\n  border-radius: 5px;\r\n  padding: 15px;\r\n  margin-bottom: 10px;\r\n`;\r\n\r\nexport const InfoText = styled(Text)`\r\n  color: #fff;\r\n\r\n\r\n`;\r\n\r\nexport const StyledTextArea = styled.textarea`\r\n  flex: 1;\r\n  margin-right: 8px;\r\n  border: none;\r\n  padding: 6px 10px;  /* Minimal padding */\r\n  background-color: #555;\r\n  color: white;\r\n  border-radius: 5px;\r\n  resize: none; /* Prevent manual resizing */\r\n  overflow: hidden; /* Hide overflow */\r\n  line-height: 1.5; /* Line height */\r\n  min-height: 10px; /* Set the minimum height to a single line */\r\n  height: 30px; /* Set height to auto to adjust dynamically */\r\n  &:focus {\r\n    outline: none;\r\n    box-shadow: none;\r\n  }\r\n  &::placeholder {\r\n    color: white;\r\n    opacity: 1; /* This ensures the white color is fully visible */\r\n  }\r\n`;\r\n\r\nexport const StyledTextInput = styled(TextInput)`\r\n  flex: 1;\r\n  margin-right: 8px;\r\n  border: none;\r\n  padding: 10px;\r\n  background-color: #444;\r\n  color: white;\r\n  border-radius: 5px;\r\n  &:focus {\r\n    outline: none;\r\n    box-shadow: none;\r\n  }\r\n`;\r\n\r\nexport const ChartContainer = styled(Box)`\r\n  //background-color: #333;\r\n  width: 100%;\r\n  margin-bottom: 15px;\r\n  border: 0px solid #333;\r\n  border-radius: 5px;\r\n  min-height: 78vh;\r\n  display: flex;\r\n  justify-content: center;\r\n  align-items: center;\r\n`;\r\n\r\nexport const Iframe = styled.iframe`\r\n  width: 100%;\r\n  border: none;\r\n`;\r\n\r\nexport const SplitButtonContainer = styled.div`\r\n  display: flex;\r\n  justify-content: space-between;\r\n  background-color: #333;\r\n  border: 0px solid #444;\r\n  border-radius: 5px;\r\n  width: 100%;\r\n  margin-bottom: 2.5px; /* Adds consistent space between rows */\r\n\r\n  @media screen and (max-width: 768px) {\r\n    flex-direction: column;\r\n    \r\n    & > div {\r\n      width: 100%;\r\n      margin-bottom: 5px;\r\n    }\r\n  }\r\n`;\r\n\r\nexport const SplitButtonSection = styled.div`\r\n  flex: 1;\r\n  padding: 6px; /* Adjusted for consistent size */\r\n  color: white;\r\n  text-align: center;\r\n  cursor: pointer;\r\n  border-right: 0px solid #444;\r\n  box-sizing: border-box; /* Ensures padding is included in the width/height calculations */\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: left;\r\n  height: 45px; /* Set a consistent height for all buttons */\r\n  gap: 5px;\r\n\r\n  &:last-child {\r\n    border-right: none; /* Remove border on the last item */\r\n  }\r\n\r\n  &:hover {\r\n    background-color: #555;\r\n  }\r\n`;\r\n\r\nexport const StyledColorButton = styled(Button)`\r\n  background-color: #444444; /* Default button background */\r\n  color: #FFFFFF; /* Button text color */\r\n  border: 1px solid #444444; /* Button border color */\r\n  border-radius: 5px; /* Border radius as per color scheme */\r\n\r\n  &:hover {\r\n    background-color: #555555; /* Hover background color */\r\n    border: 1px solid #555555 !important; /* Ensure no border on hover */\r\n    box-shadow: none !important; /* Remove any box-shadow on hover */\r\n  }\r\n\r\n  &:focus {\r\n    outline: none !important; /* Remove focus outline */\r\n    box-shadow: none !important; /* Remove focus box-shadow */\r\n  }\r\n\r\n  &:active {\r\n    background-color: #666666; /* Optional: active background color */\r\n  }\r\n`;","C:\\Users\\Ajdurden8\\Documents\\GitHub\\physician-dashboard-upgraded\\new-directory-name\\src\\components\\patient-portal\\Greeting.js",[],"C:\\Users\\Ajdurden8\\Documents\\GitHub\\physician-dashboard-upgraded\\new-directory-name\\src\\components\\patient-portal\\MedicationsCard.js",[],"C:\\Users\\Ajdurden8\\Documents\\GitHub\\physician-dashboard-upgraded\\new-directory-name\\src\\components\\patient-portal\\NotificationsCard.js",[],"C:\\Users\\Ajdurden8\\Documents\\GitHub\\physician-dashboard-upgraded\\new-directory-name\\src\\services\\patientService.js",["364"],"import axios from 'axios';\r\nimport mockPatients from '../data/mockPatients';\r\n\r\nconst API_BASE_URL = 'https://qft.agamanetworks.com/create-patient-record';\r\nconst API_KEY = 'qrf-poc-123456-key';\r\nconst USE_MOCK_DATA = true; // Toggle this to use mock data when API is unavailable\r\n\r\n// Create an Axios instance with default headers\r\nconst axiosInstance = axios.create({\r\n    baseURL: API_BASE_URL,\r\n    headers: {\r\n        'Content-Type': 'application/json',\r\n        'x-api-key': API_KEY\r\n    }\r\n});\r\n\r\nconst listPatientsWithCharts = async () => {\r\n    // Use mock data when API is unavailable\r\n    if (USE_MOCK_DATA) {\r\n        console.log(`Using mock data: Found ${mockPatients.length} patients`);\r\n        return mockPatients;\r\n    }\r\n    \r\n    try {\r\n        // Fetch all patients\r\n        const response = await axiosInstance.post('', {\r\n            action: 'queryAllPatients'\r\n        });\r\n        const patients = response.data;\r\n\r\n        console.log('Fetched patients:', patients);\r\n\r\n        // Fetch charts for each patient\r\n        const patientsWithCharts = await Promise.all(\r\n            patients.map(async (patient) => {\r\n                try {\r\n                    const charts = await getCharts(patient.Key);\r\n                    return {\r\n                        ...patient,\r\n                        Record: {\r\n                            ...patient.Record,\r\n                            charts: charts\r\n                        }\r\n                    };\r\n                } catch (chartError) {\r\n                    console.error(`Error fetching charts for patient ${patient.Key}:`, chartError);\r\n                    return {\r\n                        ...patient,\r\n                        Record: {\r\n                            ...patient.Record,\r\n                            charts: []\r\n                        }\r\n                    };\r\n                }\r\n            })\r\n        );\r\n\r\n        console.log('Patients with charts:', patientsWithCharts);\r\n        return patientsWithCharts;\r\n    } catch (error) {\r\n        console.error('Error listing patients with charts:', error);\r\n        // Fallback to mock data on error\r\n        console.log('Falling back to mock data');\r\n        return mockPatients;\r\n    }\r\n};\r\n\r\nconst getPatientDetails = async (patientId) => {\r\n    // Use mock data when API is unavailable\r\n    if (USE_MOCK_DATA) {\r\n        const patient = mockPatients.find(p => p.Key === patientId);\r\n        return patient ? patient.Record : null;\r\n    }\r\n    \r\n    try {\r\n        const response = await axiosInstance.get(`/patients/${patientId}`);\r\n        return response.data;\r\n    } catch (error) {\r\n        console.error('Error getting patient details:', error);\r\n        throw error;\r\n    }\r\n};\r\n\r\nconst createPatient = async (patientData) => {\r\n    try {\r\n        const response = await axiosInstance.post('/', patientData);\r\n        return response.data;\r\n    } catch (error) {\r\n        console.error('Error creating patient:', error);\r\n        throw error;\r\n    }\r\n};\r\n\r\nconst updatePatient = async (patientId, patientData) => {\r\n    try {\r\n        const response = await axiosInstance.patch(`/${patientId}`, {\r\n            ...patientData,\r\n            action: 'updatePatient' // Ensure action is specified if needed by the backend\r\n        });\r\n        return response.data;\r\n    } catch (error) {\r\n        console.error('Error updating patient:', error);\r\n        throw error;\r\n    }\r\n};\r\n\r\nconst deletePatient = async (patientId) => {\r\n    try {\r\n        const response = await axiosInstance.delete(`/${patientId}`);\r\n        return response.data;\r\n    } catch (error) {\r\n        console.error('Error deleting patient:', error);\r\n        throw error;\r\n    }\r\n};\r\n\r\n// Chart functions\r\n\r\nconst createChart = async (chartData) => {\r\n    try {\r\n        console.log(chartData);\r\n        const response = await axiosInstance.post('/', {\r\n            action: 'createChart',\r\n            ...chartData\r\n        });\r\n        return response.data;\r\n    } catch (error) {\r\n        console.error('Error creating chart:', error);\r\n        throw error;\r\n    }\r\n};\r\n\r\nconst replaceChart = async (chartData) => {\r\n    try {\r\n        const response = await axiosInstance.patch('/', {\r\n            action: 'replaceChart',\r\n            ...chartData\r\n        });\r\n        return response.data;\r\n    } catch (error) {\r\n        console.error('Error replacing chart:', error);\r\n        throw error;\r\n    }\r\n};\r\n\r\nconst deleteChart = async (chartId) => {\r\n    try {\r\n        const response = await axiosInstance.patch('/', {\r\n            action: 'deleteChart',\r\n            chartId\r\n        });\r\n        return response.data;\r\n    } catch (error) {\r\n        console.error('Error deleting chart:', error);\r\n        throw error;\r\n    }\r\n};\r\n\r\nconst getCharts = async (patientId) => {\r\n    try {\r\n        const response = await axiosInstance.patch('/', {\r\n            action: 'getCharts',\r\n            patientId\r\n        });\r\n        return response.data;\r\n    } catch (error) {\r\n        console.error('Error getting charts:', error);\r\n        throw error;\r\n    }\r\n};\r\n\r\n// Appointment functions\r\n\r\nconst createAppointment = async (appointmentData) => {\r\n    try {\r\n        const response = await axiosInstance.post('/', {\r\n            action: 'createAppointment',\r\n            ...appointmentData\r\n        });\r\n        return response.data;\r\n    } catch (error) {\r\n        console.error('Error creating appointment:', error);\r\n        throw error;\r\n    }\r\n};\r\n\r\nconst getAppointments = async (patientId) => {\r\n    try {\r\n        const response = await axiosInstance.patch('/', {\r\n            action: 'getAppointments',\r\n            patientId\r\n        });\r\n        return response.data;\r\n    } catch (error) {\r\n        console.error('Error getting appointments:', error);\r\n        throw error;\r\n    }\r\n};\r\n\r\nconst updateAppointment = async (appointmentData) => {\r\n    try {\r\n        const response = await axiosInstance.patch('/', {\r\n            action: 'updateAppointment',\r\n            ...appointmentData\r\n        });\r\n        return response.data;\r\n    } catch (error) {\r\n        console.error('Error updating appointment:', error);\r\n        throw error;\r\n    }\r\n};\r\n\r\nconst deleteAppointment = async (appointmentId) => {\r\n    try {\r\n        const response = await axiosInstance.patch('/', {\r\n            action: 'deleteAppointment',\r\n            appointmentId\r\n        });\r\n        return response.data;\r\n    } catch (error) {\r\n        console.error('Error deleting appointment:', error);\r\n        throw error;\r\n    }\r\n};\r\n\r\n// JournalEntry functions\r\n\r\nconst createJournalEntry = async (journalEntryData) => {\r\n    try {\r\n        const response = await axiosInstance.post('/', {\r\n            action: 'createJournalEntry',\r\n            ...journalEntryData\r\n        });\r\n        return response.data;\r\n    } catch (error) {\r\n        console.error('Error creating journal entry:', error);\r\n        throw error;\r\n    }\r\n};\r\n\r\nconst getJournalEntries = async (patientId) => {\r\n    try {\r\n        const response = await axiosInstance.patch('/', {\r\n            action: 'getJournalEntries',\r\n            patientId\r\n        });\r\n        return response.data;\r\n    } catch (error) {\r\n        console.error('Error getting journal entries:', error);\r\n        throw error;\r\n    }\r\n};\r\n\r\nconst updateJournalEntry = async (journalEntryData) => {\r\n    try {\r\n        const response = await axiosInstance.patch('/', {\r\n            action: 'updateJournalEntry',\r\n            ...journalEntryData\r\n        });\r\n        return response.data;\r\n    } catch (error) {\r\n        console.error('Error updating journal entry:', error);\r\n        throw error;\r\n    }\r\n};\r\n\r\nconst deleteJournalEntry = async (journalEntryId) => {\r\n    try {\r\n        const response = await axiosInstance.patch('/', {\r\n            action: 'deleteJournalEntry',\r\n            journalEntryId\r\n        });\r\n        return response.data;\r\n    } catch (error) {\r\n        console.error('Error deleting journal entry:', error);\r\n        throw error;\r\n    }\r\n};\r\n\r\nexport default {\r\n    listPatientsWithCharts,\r\n    getPatientDetails,\r\n    createPatient,\r\n    updatePatient,\r\n    deletePatient,\r\n    createChart,\r\n    replaceChart,\r\n    getCharts,\r\n    deleteChart,\r\n    createAppointment,\r\n    getAppointments,\r\n    updateAppointment,\r\n    deleteAppointment,\r\n    createJournalEntry,\r\n    getJournalEntries,\r\n    updateJournalEntry,\r\n    deleteJournalEntry,\r\n};\r\n","C:\\Users\\Ajdurden8\\Documents\\GitHub\\physician-dashboard-upgraded\\new-directory-name\\src\\components\\dashboard\\MainPanel.js",["365"],"import React from 'react';\r\nimport { MainPanel as StyledMainPanel } from './StyledComponents';\r\nimport Chart from './ChartContainer';\r\n\r\nconst MainPanel = ({ selectedPatient, handleIframeLoad, dashboardCharts, onDemandCharts }) => {\r\n\r\n    // Hardcoded order of chart titles\r\n    const preferredOrder = [\r\n        \"1. Patient OVERVIEW\",\r\n        \"2. Vitals with trends\",\r\n        \"3. Labs Summary Scatter Plot with Drill Downs\",\r\n        \"4. Labs with Trends\",\r\n        \"5. Radiology Findings\",\r\n        \"6 Medical Events Timeline\",\r\n        \"7. medications\",\r\n        \"8. REFERALS AND PREVENTATIVE SERVICES\"\r\n    ];\r\n\r\n    // Function to sort charts based on the numeric prefix in the title dynamically\r\n    const sortCharts = (charts) => {\r\n        return charts.sort((a, b) => {\r\n            // Extract numbers from chart titles\r\n            const numberA = parseInt((a.Record.chartTitle || '').match(/^\\d+/)); // Extracts the leading number\r\n            const numberB = parseInt((b.Record.chartTitle || '').match(/^\\d+/)); // Extracts the leading number\r\n\r\n            // If either title does not contain a number, treat it as being at the end\r\n            if (isNaN(numberA)) return 1;\r\n            if (isNaN(numberB)) return -1;\r\n\r\n            // Sort by the extracted numbers\r\n            return numberA - numberB;\r\n        });\r\n    };\r\n\r\n\r\n    // Sort the charts of the selected patient\r\n    const sortedCharts = selectedPatient?.charts ? sortCharts([...selectedPatient.charts]) : [];\r\n\r\n    return (\r\n        <StyledMainPanel>\r\n            {sortedCharts.length > 0 && sortedCharts.map((chart, index) => (\r\n                <Chart\r\n                    key={index}\r\n                    chart={chart}\r\n                    index={index}\r\n                    handleIframeLoad={handleIframeLoad}\r\n                    dashboardCharts={dashboardCharts}\r\n                    onDemandCharts={onDemandCharts}\r\n                />\r\n            ))}\r\n        </StyledMainPanel>\r\n    );\r\n};\r\n\r\nexport default MainPanel;\r\n","C:\\Users\\Ajdurden8\\Documents\\GitHub\\physician-dashboard-upgraded\\new-directory-name\\src\\components\\dashboard\\LeftPanel.js",["366","367","368","369"],"import React, { useState, useEffect } from 'react';\r\nimport { Box, Heading } from 'grommet';\r\nimport { SplitButtonSection, SplitButtonContainer, LeftPanel as StyledLeftPanel, StyledColorButton } from './StyledComponents';\r\nimport PatientDetails from './popup-content/PatientDetails';\r\nimport Chat from './ChatContainer';\r\nimport Popup from '../Popup';\r\nimport Overview from './popup-content/Overview';\r\nimport Orders from './popup-content/Orders';\r\nimport Refills from './popup-content/Refills';\r\nimport Consult from './popup-content/Consult';\r\nimport Ambient from './popup-content/Ambient';\r\nimport Notes from './popup-content/Notes';\r\nimport Summary from './popup-content/Summary';\r\nimport AIInsights from './popup-content/AIInsights';\r\nimport Imaging from './popup-content/Imaging';\r\nimport Labs from './popup-content/Labs';\r\nimport Vitals from './popup-content/Vitals';\r\nimport Commands from './popup-content/Commands';\r\nimport patientService from '../../services/patientService';\r\n\r\nconst LeftPanel = ({\r\n                       selectedPatient,\r\n                       setSelectedPatient,\r\n                       handleToggleButtonClick,\r\n                       dashboardCharts,\r\n                       onDemandCharts,\r\n                       chatHistory,\r\n                       inputText,\r\n                       setInputText,\r\n                       sendMessage,\r\n                       handleVoiceCommand,\r\n                       listening,\r\n                       loading,\r\n                       setLoading,\r\n                       popups,\r\n                       addPopup,\r\n                       removePopup,\r\n                       closePopup,\r\n                       setClosePopup,\r\n                       popUpRequested,\r\n                       popupContentType,\r\n                       setPopUpRequested,\r\n                   }) => {\r\n    const [patients, setPatients] = useState([]);\r\n    const [showButtons, setShowButtons] = useState(false);\r\n    const [boxSize, setBoxSize] = useState({ width: '100%', height: '81vh' });\r\n\r\n    // Function to toggle button visibility\r\n    const handleToggle = () => {\r\n        setShowButtons((prevState) => !prevState);\r\n    };\r\n\r\n    // Function to fetch patients\r\n    const fetchPatients = async () => {\r\n        setLoading(true);\r\n        try {\r\n            const patientData = await patientService.listPatientsWithCharts();\r\n            const mappedPatients = patientData.map((patient) => ({\r\n                key: patient.Key,\r\n                name: patient.Record.name,\r\n                charts: patient.Record.charts || [],\r\n                ...patient.Record,\r\n            }));\r\n            setPatients(mappedPatients);\r\n            if (mappedPatients.length > 0) {\r\n                setSelectedPatient(mappedPatients[0]);\r\n            }\r\n        } catch (error) {\r\n            console.error('Failed to fetch patients:', error);\r\n        } finally {\r\n            setLoading(false);\r\n        }\r\n    };\r\n\r\n    // Initial patient fetch\r\n    useEffect(() => {\r\n        fetchPatients();\r\n    }, []);\r\n\r\n    // Function to handle button clicks and load content into popup\r\n    const handleButtonClick = (contentType) => {\r\n        const popupExists = popups.some(popup => popup.contentType === contentType);\r\n        if (popupExists) return; // If it exists, do not add another one\r\n        const popupMapping = {\r\n            // First Row\r\n            Vickie: <PatientDetails patient={selectedPatient} />,\r\n            Overview: <Overview />,\r\n            Orders: <Orders />,\r\n            Refills: <Refills />,\r\n            // Second Row\r\n            Consult: <Consult />,\r\n            Ambient: <Ambient />,\r\n            Notes: <Notes />,\r\n            Summary: <Summary />,\r\n            // Third Row\r\n            'AI Insights': <AIInsights />,\r\n            Imaging: <Imaging />,\r\n            Labs: <Labs />,\r\n            Vitals: <Vitals />,\r\n            // Chart Row\r\n            Commands: <Commands />,\r\n        };\r\n\r\n        // If valid contentType is provided, add the popup\r\n        if (popupMapping[contentType]) {\r\n            addPopup(contentType, popupMapping[contentType]); // Adds popup using the deduplication logic in App.js\r\n        }\r\n    };\r\n\r\n    // Handle automatic popup state changes based on external triggers (like voice commands)\r\n    useEffect(() => {\r\n        if (popUpRequested && popupContentType) {\r\n            handleButtonClick(popupContentType);\r\n            setPopUpRequested(false); // Reset the flag after handling\r\n        }\r\n    }, [popUpRequested, popupContentType, setPopUpRequested]);\r\n\r\n    return (\r\n        <StyledLeftPanel style={{ display: 'flex', flexDirection: 'column' }}>\r\n            {/* Section for rendering buttons */}\r\n            <Box flex={false}>\r\n                <SplitButtonContainer>\r\n                    <SplitButtonSection onClick={() => handleButtonClick('Vickie')}>Patient Info</SplitButtonSection>\r\n                    <SplitButtonSection onClick={() => handleButtonClick('Overview')}>Overview</SplitButtonSection>\r\n                    <SplitButtonSection onClick={() => handleButtonClick('Orders')}>Orders</SplitButtonSection>\r\n                    <SplitButtonSection onClick={() => handleButtonClick('Refills')}>Refills</SplitButtonSection>\r\n                </SplitButtonContainer>\r\n                <SplitButtonContainer>\r\n                    <SplitButtonSection onClick={() => handleButtonClick('Consult')}>Consult</SplitButtonSection>\r\n                    <SplitButtonSection onClick={() => handleButtonClick('Ambient')}>Ambient</SplitButtonSection>\r\n                    <SplitButtonSection onClick={() => handleButtonClick('Notes')}>Notes</SplitButtonSection>\r\n                    <SplitButtonSection onClick={() => handleButtonClick('Summary')}>Summary</SplitButtonSection>\r\n                </SplitButtonContainer>\r\n                <SplitButtonContainer>\r\n                    <SplitButtonSection onClick={() => handleButtonClick('AI Insights')}>AI Insights</SplitButtonSection>\r\n                    <SplitButtonSection onClick={() => handleButtonClick('Imaging')}>Imaging</SplitButtonSection>\r\n                    <SplitButtonSection onClick={() => handleButtonClick('Labs')}>Labs</SplitButtonSection>\r\n                    <SplitButtonSection onClick={() => handleButtonClick('Vitals')}>Vitals</SplitButtonSection>\r\n                </SplitButtonContainer>\r\n                <SplitButtonContainer>\r\n                    <SplitButtonSection onClick={() => handleToggleButtonClick('dashboard')}>Dashboard Charts</SplitButtonSection>\r\n                    <SplitButtonSection onClick={() => handleToggleButtonClick('onDemand')}>Live View Charts</SplitButtonSection>\r\n                    <SplitButtonSection onClick={() => handleToggle()} style={{ backgroundColor: showButtons ? '#555' : '#333' }}>\r\n                        Multi View\r\n                    </SplitButtonSection>\r\n                    <SplitButtonSection onClick={() => handleButtonClick('Commands')}>Commands</SplitButtonSection>\r\n                </SplitButtonContainer>\r\n            </Box>\r\n\r\n            {/* Chat Container */}\r\n            <Box\r\n                flex=\"grow\"\r\n                pad=\"xsmall\"\r\n                round=\"small\"\r\n                style={{\r\n                    width: boxSize.width,\r\n                    height: boxSize.height,\r\n                    resize: 'vertical',\r\n                    overflowY: 'auto',\r\n                    display: 'flex',\r\n                    flexDirection: 'column',\r\n                    backgroundColor: '#333',\r\n                    borderRadius: '5px',\r\n                }}\r\n            >\r\n                <Box direction=\"row\" justify=\"between\" align=\"\" gap=\"small\" pad=\"none\" margin=\"none\" style={{ minHeight: '35px', width: '100%' }}>\r\n                    <Heading level={3} margin={{ right: 'small', vertical: 'none' }} style={{ width: '175px' }} color=\"white\">\r\n                        Agama AI\r\n                    </Heading>\r\n                    {/* Render additional buttons */}\r\n                    {showButtons && (\r\n                        <SplitButtonContainer direction=\"row\" align=\"right\" gap=\"small\" pad=\"none\">\r\n                            <StyledColorButton style={{ fontSize: '14px', padding: '4px 10px', height: '28px', lineHeight: '1' }} label=\"Charts X Labs\" />\r\n                            <StyledColorButton style={{ fontSize: '14px', padding: '4px 10px', height: '28px', lineHeight: '1' }} label=\"Consults, Labs, Imaging\" />\r\n                            <StyledColorButton style={{ fontSize: '14px', padding: '4px 10px', height: '28px', lineHeight: '1' }} label=\"Full Charts\" />\r\n                            <StyledColorButton style={{ fontSize: '14px', padding: '4px 10px', height: '28px', lineHeight: '1' }} label=\"Full AI Chat\" />\r\n                        </SplitButtonContainer>\r\n                    )}\r\n                </Box>\r\n\r\n                <Chat\r\n                    chatHistory={chatHistory}\r\n                    inputText={inputText}\r\n                    setInputText={setInputText}\r\n                    sendMessage={sendMessage}\r\n                    handleVoiceCommand={handleVoiceCommand}\r\n                    listening={listening}\r\n                    loading={loading}\r\n                    style={{ flexGrow: 1 }}\r\n                />\r\n            </Box>\r\n\r\n                {popups.map((popup, index) => {\r\n                    console.log(`Rendering Popup ${index}:`, popup);\r\n\r\n                    const popupContent = popup.content;\r\n                    console.log(`Popup content type:`, typeof popupContent);\r\n                    console.log(`Popup content value:`, popupContent);\r\n\r\n                    return (\r\n                        <Popup\r\n                            key={popup.id}\r\n                            isVisible={popup.isVisible}\r\n                            onClose={() => {\r\n                                console.log(\"Removing Popup:\", popup.id);\r\n                                removePopup(popup.id);\r\n                            }}\r\n                            content={\r\n                                popupContent ? (\r\n                                    popupContent\r\n                                ) : (\r\n                                    <div style={{ color: 'red' }}>\r\n                                        No valid content available for popup with id: {popup.id}\r\n                                    </div>\r\n                                )\r\n                            }\r\n                            title={popup?.title || popup.contentType.toString()}\r\n                        />\r\n                    );\r\n                })}\r\n        </StyledLeftPanel>\r\n    );\r\n};\r\n\r\nexport default LeftPanel;\r\n","C:\\Users\\Ajdurden8\\Documents\\GitHub\\physician-dashboard-upgraded\\new-directory-name\\src\\components\\dashboard\\VoiceCommandHelp.js",[],"C:\\Users\\Ajdurden8\\Documents\\GitHub\\physician-dashboard-upgraded\\new-directory-name\\src\\components\\dashboard\\popup-content\\Notes.js",[],"C:\\Users\\Ajdurden8\\Documents\\GitHub\\physician-dashboard-upgraded\\new-directory-name\\src\\components\\dashboard\\popup-content\\PatientDetails.js",[],"C:\\Users\\Ajdurden8\\Documents\\GitHub\\physician-dashboard-upgraded\\new-directory-name\\src\\components\\dashboard\\popup-content\\Overview.js",["370"],"import React from 'react';\r\nimport { Box } from 'grommet';\r\nimport { StyledCard, InfoText } from '../StyledComponents';\r\n\r\nconst Overview = () => (\r\n    <StyledCard>\r\n        <InfoText><strong>Reason for Visit:</strong> Vickie reports chest discomfort and shortness of breath during physical exertion over the past week. She is here for evaluation of possible cardiac issues.</InfoText>\r\n\r\n        <InfoText><strong>Recent Labs/Imaging:</strong></InfoText>\r\n        <ul>\r\n            <li>Lab (05/01/2024): WBC: 8.15, Hemoglobin: 14.9, Iron Saturation: 47%</li>\r\n            <li>Imaging (05/03/2024): Transthoracic Echo shows mild regurgitation in the aortic and mitral valves, mild pulmonary hypertension.</li>\r\n        </ul>\r\n\r\n        <InfoText><strong>Recent Vitals (04/30/2024):</strong></InfoText>\r\n        <ul>\r\n            <li>Blood Pressure: 142/88 mmHg</li>\r\n            <li>Pulse: 58 bpm</li>\r\n            <li>Weight: 66.7 kg (147 lb)</li>\r\n            <li>Height: 154.9 cm (5'1\")</li>\r\n            <li>Oxygen Saturation: 99%</li>\r\n        </ul>\r\n    </StyledCard>\r\n);\r\n\r\nexport default Overview;\r\n","C:\\Users\\Ajdurden8\\Documents\\GitHub\\physician-dashboard-upgraded\\new-directory-name\\src\\components\\dashboard\\popup-content\\Refills.js",[],"C:\\Users\\Ajdurden8\\Documents\\GitHub\\physician-dashboard-upgraded\\new-directory-name\\src\\components\\dashboard\\popup-content\\Orders.js",["371"],"import React from 'react';\r\nimport { Box, Text, Heading } from 'grommet';\r\nimport { StyledCard, InfoText } from '../StyledComponents'; // Adjust the import path as needed\r\n\r\nconst Orders = () => {\r\n    const orders = [\r\n        { description: 'Transthoracic Echo, scheduled for follow-up review on 07/19/2024' },\r\n        { description: 'Lipid Panel due on 03/20/2029 (routine)' },\r\n        { description: 'Bone density scan, scheduled for 04/18/2025' },\r\n        { description: 'CT Chest with contrast for further evaluation of pulmonary hypertension (order placed)' },\r\n        { description: 'Dietary consultation to address vitamin D levels and osteoporosis management (order placed)' },\r\n    ];\r\n\r\n    return (\r\n        <StyledCard>\r\n            <Heading level={3} margin={{ bottom: 'small' }} color=\"#fff\">Pending Orders</Heading>\r\n            <Box pad=\"small\">\r\n                {orders.map((order, index) => (\r\n                    <InfoText key={index} margin={{ bottom: 'small' }}>\r\n                        {order.description}\r\n                    </InfoText>\r\n                ))}\r\n            </Box>\r\n        </StyledCard>\r\n    );\r\n};\r\n\r\nexport default Orders;\r\n","C:\\Users\\Ajdurden8\\Documents\\GitHub\\physician-dashboard-upgraded\\new-directory-name\\src\\components\\dashboard\\popup-content\\Consult.js",[],"C:\\Users\\Ajdurden8\\Documents\\GitHub\\physician-dashboard-upgraded\\new-directory-name\\src\\components\\dashboard\\popup-content\\Summary.js",["372"],"// Summary.js\r\nimport React, {useState} from 'react';\r\nimport { Box, Text, Button } from 'grommet';\r\nimport {StyledCard, InfoText, StyledColorButton} from '../StyledComponents';\r\n\r\nconst Summary = ({ onApprove, onEdit }) => {\r\n    const [isApproved, setIsApproved] = useState(false);\r\n    // Handle approval action\r\n    const handleApprove = () => {\r\n        setIsApproved(true);\r\n    };\r\n    return (\r\n        <StyledCard>\r\n            {/* SOAP Note Sections */}\r\n            <Box pad=\"medium\">\r\n                {/* Subjective Section */}\r\n                <InfoText>\r\n                    <Text weight=\"bold\" size=\"large\">S: Subjective</Text><br />\r\n                    Vickie J. Moore presented today for evaluation of chest discomfort and shortness of breath.<br />\r\n                    Patient describes intermittent episodes of chest tightness during exertion, lasting 5-10 minutes and relieved by rest.<br />\r\n                    No associated dizziness or syncope reported.<br />\r\n                    Reports increased fatigue, but denies recent weight changes, infections, or fever.\r\n                </InfoText>\r\n\r\n                {/* Objective Section */}\r\n                <InfoText margin={{ top: 'medium' }}>\r\n                    <Text weight=\"bold\" size=\"large\">O: Objective</Text><br />\r\n                    <strong>Blood Pressure:</strong> 142/88 mmHg (elevated)<br />\r\n                    <strong>Recent Imaging:</strong><br />\r\n                    - Transthoracic echocardiogram shows mild regurgitation in both aortic and mitral valves.<br />\r\n                    - Mild pulmonary hypertension noted.<br />\r\n                    <strong>Labs:</strong> Pending results of lipid panel and bone density scan.\r\n                </InfoText>\r\n\r\n                {/* Assessment Section */}\r\n                <InfoText margin={{ top: 'medium' }}>\r\n                    <Text weight=\"bold\" size=\"large\">A: Assessment</Text><br />\r\n                    - Mild pulmonary hypertension likely contributing to symptoms.<br />\r\n                    - Potential heart involvement needs further evaluation due to persistent shortness of breath and chest discomfort.<br />\r\n                    - Blood pressure management required due to elevated readings.\r\n                </InfoText>\r\n\r\n                {/* Plan Section */}\r\n                <InfoText margin={{ top: 'medium' }}>\r\n                    <Text weight=\"bold\" size=\"large\">P: Plan</Text><br />\r\n                    - Order CT chest with contrast for further evaluation of pulmonary hypertension and heart involvement.<br />\r\n                    - Discussed potential medication adjustments; consider antihypertensives if elevated BP persists.<br />\r\n                    - Patient instructed to follow up in 2 weeks for review of imaging results and reassessment.<br />\r\n                    - Dietary consultation to address vitamin D levels and management of osteoporosis.\r\n                </InfoText>\r\n\r\n                {/* Buttons */}\r\n                <Box direction=\"row\" justify=\"\" gap={\"large\"} margin={{ top: 'medium' }}>\r\n                    <StyledColorButton\r\n                        primary\r\n                        label={isApproved ? 'Approved ✓' : 'Approve'}\r\n                        onClick={handleApprove}\r\n                        disabled={isApproved}\r\n\r\n                    />\r\n                    <StyledColorButton\r\n                        label=\"Edit\"\r\n                        onClick={onEdit}\r\n                    />\r\n                </Box>\r\n            </Box>\r\n        </StyledCard>\r\n    );\r\n};\r\n\r\nexport default Summary;\r\n","C:\\Users\\Ajdurden8\\Documents\\GitHub\\physician-dashboard-upgraded\\new-directory-name\\src\\components\\dashboard\\popup-content\\Ambient.js",["373"],"import React, { useState } from 'react';\r\nimport { Box, Heading, Text } from 'grommet';\r\nimport { StyledCard, InfoText } from '../StyledComponents';\r\n\r\nconst Ambient = ({ isTriggered }) => {\r\n    console.log(\"Ambient trigger = \", isTriggered);\r\n\r\n    const ambientRecording = `Waiting for input...`;\r\n\r\n    // Content for Doctor-Patient Transcript\r\n    const transcriptContent = [\r\n        { speaker: \"Doctor\", text: \"How have you been feeling since our last consultation, Vickie?\" },\r\n        { speaker: \"Vickie\", text: \"I’ve been feeling more tired than usual, and I’ve had some mild chest pain that comes and goes. My blood pressure seems higher too.\" },\r\n        { speaker: \"Doctor\", text: \"Can you describe the chest pain? Does it get worse when you’re active?\" },\r\n        { speaker: \"Vickie\", text: \"Yes, it feels a bit worse in the mornings, especially after I walk to work.\" },\r\n        { speaker: \"Doctor\", text: \"Do you also notice any shortness of breath?\" },\r\n        { speaker: \"Vickie\", text: \"Sometimes, especially when I’m climbing stairs.\" },\r\n        { speaker: \"Doctor\", text: \"Thanks for sharing that. I’ll order an ECG to check your heart and adjust your blood pressure medication slightly. We may also do some blood work to rule out other issues.\" },\r\n        { speaker: \"Vickie\", text: \"Okay, should I be worried?\" },\r\n        { speaker: \"Doctor\", text: \"These symptoms can be caused by a few things, many of which are manageable. We’ll know more after the tests. For now, take it easy, and avoid overexertion. We’ll get to the bottom of this.\" },\r\n        { speaker: \"Vickie\", text: \"Thanks, Doctor.\" },\r\n        { speaker: \"Doctor\", text: \"Great. I’ll see you in two weeks for a follow-up. If anything gets worse, reach out, okay?\" },\r\n        { speaker: \"Vickie\", text: \"Got it. Thanks again.\" }\r\n    ];\r\n\r\n    // AI Transcription and Summary\r\n    const transcriptionSummary = `\r\n        Patient Vickie reports increased fatigue and intermittent chest pain, worsening in the mornings,\r\n        especially after physical activity like walking. Also experiencing occasional shortness of breath.\r\n        Blood pressure readings higher than usual. Doctor recommends ECG, potential medication adjustment, \r\n        and blood work. Next follow-up scheduled for 2 weeks.\r\n    `;\r\n\r\n    // Action Items as a plain list\r\n    const actionItems = [\r\n        \"Order ECG.\",\r\n        \"Adjust prescription for blood pressure.\",\r\n        \"Conduct blood work.\",\r\n        \"Schedule follow-up consultation in 2 weeks.\"\r\n    ];\r\n\r\n    return (\r\n        <StyledCard>\r\n            <Heading level={3} margin={{ bottom: 'small' }} color=\"#fff\">\r\n                Live Ambient Recording\r\n            </Heading>\r\n            <Box pad=\"small\">\r\n                {isTriggered ? (\r\n                    <Box>\r\n                        {/* Doctor-Patient Transcript */}\r\n                        <Box margin={{ bottom: 'medium' }}>\r\n                            <Text weight=\"bold\" size=\"large\">Doctor-Patient Transcript:</Text>\r\n                            {transcriptContent.map((line, index) => (\r\n                                <Box key={index} margin={{ bottom: 'xsmall' }}>\r\n                                    <Text weight=\"bold\">{line.speaker}:</Text> <Text>{line.text}</Text>\r\n                                </Box>\r\n                            ))}\r\n                        </Box>\r\n\r\n                        {/* AI Transcription and Summary */}\r\n                        <Box margin={{ bottom: 'medium' }}>\r\n                            <Text weight=\"bold\" size=\"large\">AI Transcription and Summary:</Text>\r\n                            <Text>{transcriptionSummary}</Text>\r\n                        </Box>\r\n\r\n                        {/* Action Items as a plain list */}\r\n                        <Box>\r\n                            <Text weight=\"bold\" size=\"large\">Action Items Generated:</Text>\r\n                            {actionItems.map((item, index) => (\r\n                                <Text key={index}>{item}</Text>\r\n                            ))}\r\n                        </Box>\r\n                    </Box>\r\n                ) : (\r\n                    <InfoText>{ambientRecording}</InfoText>\r\n                )}\r\n            </Box>\r\n        </StyledCard>\r\n    );\r\n};\r\n\r\nexport default Ambient;\r\n","C:\\Users\\Ajdurden8\\Documents\\GitHub\\physician-dashboard-upgraded\\new-directory-name\\src\\components\\dashboard\\popup-content\\Imaging.js",[],"C:\\Users\\Ajdurden8\\Documents\\GitHub\\physician-dashboard-upgraded\\new-directory-name\\src\\components\\dashboard\\popup-content\\AIInsights.js",[],"C:\\Users\\Ajdurden8\\Documents\\GitHub\\physician-dashboard-upgraded\\new-directory-name\\src\\components\\dashboard\\popup-content\\Commands.js",[],"C:\\Users\\Ajdurden8\\Documents\\GitHub\\physician-dashboard-upgraded\\new-directory-name\\src\\components\\dashboard\\popup-content\\Labs.js",[],"C:\\Users\\Ajdurden8\\Documents\\GitHub\\physician-dashboard-upgraded\\new-directory-name\\src\\utils\\responsive.js",[],"C:\\Users\\Ajdurden8\\Documents\\GitHub\\physician-dashboard-upgraded\\new-directory-name\\src\\components\\dashboard\\popup-content\\Vitals.js",[],"C:\\Users\\Ajdurden8\\Documents\\GitHub\\physician-dashboard-upgraded\\new-directory-name\\src\\components\\PatientCharts.js",["374"],"import React, { useState, useEffect } from 'react';\r\nimport { Box, FormField, TextInput, TextArea, Button, Layer, Select, Text, Spinner } from 'grommet';\r\nimport styled from 'styled-components';\r\nimport patientService from '../services/patientService';\r\nimport {CustomSelect, StyledFormField} from \"../styles/admin\";\r\n\r\n// Styled components using the provided color scheme\r\nconst StyledButton = styled(Button)`\r\n  border-radius: 5px;\r\n  border: 0px solid #333 !important; // Neon cyan border\r\n  padding: 0.5rem 1rem;\r\n  background-color: #444444 !important;; // Background for buttons\r\n  color: #FFFFFF !important;; // Text color\r\n  font-weight: bold;\r\n  transition: all 0.3s ease;\r\n  &:hover {\r\n    background-color: #555555 !important;; // Hover background\r\n    box-shadow: 0 4px 12px #444 !important;;\r\n  }\r\n  &:disabled {\r\n    background-color: #c6c6c6;\r\n    border-color: #c6c6c6;\r\n  }\r\n  &:focus {\r\n    outline: none;\r\n    box-shadow: none; // Remove focus outline\r\n  }\r\n`;\r\n\r\n// Styled delete button\r\nconst DeleteButton = styled(Button)`\r\n  border-radius: 5px;\r\n  border: 1px solid #ff0000;\r\n  padding: 0.5rem 1rem;\r\n  background-color: #ff0000;\r\n  color: #FFFFFF;\r\n  font-weight: bold;\r\n  transition: all 0.3s ease;\r\n  &:hover {\r\n    background-color: #cc0000;\r\n    box-shadow: 0 4px 12px rgba(255, 0, 0, 0.4);\r\n  }\r\n  &:focus {\r\n    outline: none;\r\n    box-shadow: none; // Remove focus outline\r\n  }\r\n`;\r\n\r\nconst PatientCharts = ({ patientId, charts, onChartsUpdate }) => {\r\n    const [chartTitle, setChartTitle] = useState('');\r\n    const [chartDescription, setChartDescription] = useState('');\r\n    const [chartHTML, setChartHTML] = useState('');\r\n    const [showPreview, setShowPreview] = useState(false);\r\n    const [showConfirmDelete, setShowConfirmDelete] = useState(false);\r\n    const [selectedChart, setSelectedChart] = useState('Add New Chart');\r\n    const [isLoading, setIsLoading] = useState(false);\r\n    const [isAdmin, setIsAdmin] = useState(false);\r\n\r\n    useEffect(() => {\r\n        const userRole = localStorage.getItem('userRole');\r\n        if (userRole === 'admin') {\r\n            setIsAdmin(true);\r\n        }\r\n    }, []);\r\n\r\n    useEffect(() => {\r\n        if (selectedChart !== 'Add New Chart') {\r\n            const selected = charts.find((chart) => chart.Key === selectedChart);\r\n            if (selected && selected.Record) {\r\n                setChartTitle(selected.Record.chartTitle);\r\n                setChartDescription(selected.Record.chartDescription);\r\n                setChartHTML(selected.Record.chartHTML);\r\n            }\r\n        }\r\n    }, [selectedChart, charts]);\r\n\r\n    const handlePreview = () => {\r\n        setShowPreview(true);\r\n    };\r\n\r\n    const handleClosePreview = () => {\r\n        setShowPreview(false);\r\n    };\r\n\r\n    const handleSaveChart = async () => {\r\n        const userRole = localStorage.getItem('userRole');\r\n        if (userRole !== 'admin') {\r\n            return; // Exit function if user is not an admin\r\n        }\r\n        setIsLoading(true);\r\n        const chartData = {\r\n            patientId,\r\n            chartId: selectedChart === 'Add New Chart' ? undefined : selectedChart,\r\n            chartTitle,\r\n            chartDescription,\r\n            chartHTML,\r\n        };\r\n\r\n        let updatedCharts;\r\n        try {\r\n            if (selectedChart === 'Add New Chart') {\r\n                const newChart = { Key: `new-${Date.now()}`, Record: { chartTitle, chartDescription, chartHTML } };\r\n                updatedCharts = [...charts, newChart];\r\n                await patientService.createChart(chartData);\r\n            } else {\r\n                updatedCharts = charts.map((chart) =>\r\n                    chart.Key === selectedChart\r\n                        ? { Key: chart.Key, Record: { ...chart.Record, chartTitle, chartDescription, chartHTML } }\r\n                        : chart\r\n                );\r\n                await patientService.replaceChart(chartData);\r\n            }\r\n            onChartsUpdate(updatedCharts);\r\n        } catch (error) {\r\n            console.error('Failed to save chart:', error);\r\n        } finally {\r\n            setIsLoading(false);\r\n        }\r\n    };\r\n\r\n    const handleSelectChart = (option) => {\r\n        if (option === 'Add New Chart') {\r\n            setSelectedChart(option);\r\n            setChartTitle('');\r\n            setChartDescription('');\r\n            setChartHTML('');\r\n        } else {\r\n            const selected = charts.find((chart) => chart.Record.chartTitle === option);\r\n            if (selected) {\r\n                setSelectedChart(selected.Key);\r\n                setChartTitle(selected.Record.chartTitle);\r\n                setChartDescription(selected.Record.chartDescription);\r\n                setChartHTML(selected.Record.chartHTML);\r\n            }\r\n        }\r\n    };\r\n\r\n    const handleDeleteChart = async () => {\r\n        const userRole = localStorage.getItem('userRole');\r\n        if (userRole !== 'admin') {\r\n            return; // Exit function if user is not an admin\r\n        }\r\n        setIsLoading(true);\r\n        if (selectedChart && selectedChart !== 'Add New Chart') {\r\n            try {\r\n                await patientService.deleteChart({ chartId: selectedChart });\r\n                const updatedCharts = charts.filter((chart) => chart.Key !== selectedChart);\r\n                onChartsUpdate(updatedCharts);\r\n                setSelectedChart('Add New Chart');\r\n                setChartTitle('');\r\n                setChartDescription('');\r\n                setChartHTML('');\r\n                setShowConfirmDelete(false);\r\n            } catch (error) {\r\n                console.error('Failed to delete chart:', error);\r\n            } finally {\r\n                setIsLoading(false);\r\n            }\r\n        }\r\n    };\r\n\r\n    return (\r\n        <Box direction=\"row\" gap=\"medium\">\r\n            {isLoading && (\r\n                <Layer>\r\n                    <Box pad=\"large\" align=\"center\" gap=\"small\">\r\n                        <Spinner />\r\n                        <Text>Processing...</Text>\r\n                    </Box>\r\n                </Layer>\r\n            )}\r\n            <Box width=\"30%\" gap=\"medium\">\r\n                <StyledFormField name=\"selectChart\" label=\"Select Chart\">\r\n                    <CustomSelect\r\n                        plain\r\n                        options={['Add New Chart', ...charts.map((chart) => chart.Record.chartTitle)]}\r\n                        value={selectedChart === 'Add New Chart' ? selectedChart : charts.find(chart => chart.Key === selectedChart)?.Record.chartTitle}\r\n                        onChange={({ option }) => handleSelectChart(option)}\r\n                    />\r\n                </StyledFormField>\r\n                <StyledFormField name=\"chartTitle\" label=\"Chart Title\">\r\n                    <TextInput\r\n                        name=\"chartTitle\"\r\n                        value={chartTitle}\r\n                        onChange={(event) => setChartTitle(event.target.value)}\r\n                    />\r\n                </StyledFormField>\r\n                <StyledFormField name=\"chartDescription\" label=\"Chart Description\">\r\n                    <TextInput\r\n                        name=\"chartDescription\"\r\n                        value={chartDescription}\r\n                        onChange={(event) => setChartDescription(event.target.value)}\r\n                    />\r\n                </StyledFormField>\r\n                <Box direction=\"row\" gap=\"medium\" justify=\"center\" align=\"center\">\r\n                    <StyledButton\r\n                        label=\"Save Chart\"\r\n                        onClick={handleSaveChart}\r\n                        disabled={!isAdmin || !chartTitle.trim() || !chartHTML.trim()}\r\n                    />\r\n                    <StyledButton\r\n                        label=\"Preview Chart\"\r\n                        onClick={handlePreview}\r\n                        disabled={!chartHTML.trim()}\r\n                    />\r\n                    {selectedChart !== 'Add New Chart' && (\r\n                        <DeleteButton\r\n                            label=\"Delete Chart\"\r\n                            disabled={!isAdmin}\r\n                            onClick={() => setShowConfirmDelete(true)}\r\n                        />\r\n                    )}\r\n                </Box>\r\n            </Box>\r\n            <Box width=\"70%\">\r\n                <FormField name=\"chartHTML\" label=\"HTML\">\r\n                    <TextArea\r\n                        name=\"chartHTML\"\r\n                        value={chartHTML}\r\n                        onChange={(event) => setChartHTML(event.target.value)}\r\n                        rows={20}\r\n                    />\r\n                </FormField>\r\n            </Box>\r\n            {showPreview && (\r\n                <Layer onEsc={handleClosePreview} onClickOutside={handleClosePreview} align=\"center\" justify=\"center\">\r\n                    <Box pad=\"medium\" gap=\"small\" width=\"80vw\" height=\"80vh\" overflow=\"auto\" align=\"center\" justify=\"center\">\r\n                        <Box direction=\"row\" justify=\"between\" align=\"center\" width=\"100%\">\r\n                            <h1>{chartTitle}</h1>\r\n                            <Button label=\"Close\" onClick={handleClosePreview} />\r\n                        </Box>\r\n                        <p>{chartDescription}</p>\r\n                        <Box width=\"100%\" height=\"100%\">\r\n                            <iframe\r\n                                srcDoc={chartHTML}\r\n                                title=\"Chart Preview\"\r\n                                style={{ width: '100%', height: '100%', border: 'none' }}\r\n                            />\r\n                        </Box>\r\n                    </Box>\r\n                </Layer>\r\n            )}\r\n            {showConfirmDelete && (\r\n                <Layer position=\"center\" onClickOutside={() => setShowConfirmDelete(false)} onEsc={() => setShowConfirmDelete(false)}>\r\n                    <Box pad=\"medium\" gap=\"small\">\r\n                        <Text>Are you sure you want to delete this chart?</Text>\r\n                        <Box direction=\"row\" gap=\"medium\" justify=\"center\">\r\n                            <DeleteButton label=\"Yes\" onClick={handleDeleteChart} disabled={!isAdmin} />\r\n                            <Button label=\"No\" onClick={() => setShowConfirmDelete(false)} />\r\n                        </Box>\r\n                    </Box>\r\n                </Layer>\r\n            )}\r\n        </Box>\r\n    );\r\n};\r\n\r\nexport default PatientCharts;\r\n","C:\\Users\\Ajdurden8\\Documents\\GitHub\\physician-dashboard-upgraded\\new-directory-name\\src\\components\\ProblemsProcedures.js",[],"C:\\Users\\Ajdurden8\\Documents\\GitHub\\physician-dashboard-upgraded\\new-directory-name\\src\\components\\SocialHistoryVitalSigns.js",["375"],"import React from 'react';\r\nimport { Box } from 'grommet';\r\nimport styled from 'styled-components';\r\nimport SocialHistory from './SocialHistory';\r\nimport LastFiledVitalSigns from './LastFiledVitalSigns';\r\n\r\n// Styled Box to apply the background and text colors\r\nconst StyledBox = styled(Box)`\r\n  background-color: transparent; /* Center panel background */\r\n  padding: 1rem;\r\n  border-radius: 5px;\r\n  color: #fff; /* Default text color */\r\n  height: 100%; /* Make sure all boxes have equal height */\r\n`;\r\n\r\n// Parent container with CSS grid\r\nconst GridContainer = styled(Box)`\r\n  display: grid;\r\n  grid-template-columns: repeat(1, 1fr); /* 3 columns in the grid */\r\n  grid-gap: 60px; /* Gap between the cards both horizontally and vertically */\r\n  width: 100%;\r\n  align-items: start; /* Align all items to the start to prevent any vertical misalignment */\r\n  padding: 1rem;\r\n`;\r\n\r\nconst Spacer = styled.div`\r\n  width: 100%;\r\n  height: 2rem; /* Adjust height to add vertical spacing */\r\n`;\r\n\r\nconst SocialHistoryVitalSigns = ({ socialHistory, vitalSigns, onSocialHistoryUpdate, onVitalSignsUpdate }) => {\r\n    return (\r\n        <GridContainer>\r\n                <SocialHistory socialHistory={socialHistory} onUpdate={onSocialHistoryUpdate} />\r\n            <Spacer />\r\n                <LastFiledVitalSigns vitals={vitalSigns} onUpdate={onVitalSignsUpdate} />\r\n            {/* Add more cards here as needed */}\r\n        </GridContainer>\r\n    );\r\n};\r\n\r\nexport default SocialHistoryVitalSigns;\r\n","C:\\Users\\Ajdurden8\\Documents\\GitHub\\physician-dashboard-upgraded\\new-directory-name\\src\\components\\PatientDemographics.js",["376","377"],"import React, { useState, useEffect } from 'react';\r\nimport {\r\n    Box,\r\n    FormField,\r\n    TextInput,\r\n    Select,\r\n    CardHeader,\r\n    Card,\r\n    CardBody,\r\n} from 'grommet';\r\nimport styled from 'styled-components';\r\nimport CommunicationField from './CommunicationField';\r\nimport AliasField from './AliasField';\r\nimport {CustomSelect, StyledFormField} from \"../styles/admin\";\r\n\r\nconst monthOptions = [\r\n    { label: 'Jan.', value: '01' },\r\n    { label: 'Feb.', value: '02' },\r\n    { label: 'Mar.', value: '03' },\r\n    { label: 'Apr.', value: '04' },\r\n    { label: 'May.', value: '05' },\r\n    { label: 'Jun.', value: '06' },\r\n    { label: 'Jul.', value: '07' },\r\n    { label: 'Aug.', value: '08' },\r\n    { label: 'Sep.', value: '09' },\r\n    { label: 'Oct.', value: '10' },\r\n    { label: 'Nov.', value: '11' },\r\n    { label: 'Dec.', value: '12' },\r\n];\r\n\r\n// Styled components for the card to match the dark theme\r\nconst StyledCard = styled(Card)`\r\n  //background-color: #333; // Left panel background\r\n  //border-radius: 8px;\r\n`;\r\n\r\nconst StyledCardHeader = styled(CardHeader)`\r\n  //color: #fff; // Neon cyan for headings\r\n  //font-weight: bold;\r\n  //background-color: #333333; // Top menu background\r\n  //padding: 1rem;\r\n  //margin: 0; // Remove default margins\r\n  //flex: 0 0 auto; // Prevent flex items from growing or shrinking\r\n`;\r\n\r\nconst PatientDemographics = ({ demographics, onUpdate }) => {\r\n    const [addressParts, setAddressParts] = useState({\r\n        street: '',\r\n        city: '',\r\n        state: '',\r\n        zip: '',\r\n    });\r\n\r\n    const [birthdateParts, setBirthdateParts] = useState({\r\n        month: '',\r\n        day: '',\r\n        year: '',\r\n    });\r\n\r\n    useEffect(() => {\r\n        if (demographics.address) {\r\n            const addressRegex = /^(.*?),\\s*(.*?),\\s*([A-Z]{2})\\s*(\\d{5}(?:-\\d{4})?)$/;\r\n            const match = demographics.address.match(addressRegex);\r\n            if (match) {\r\n                setAddressParts({\r\n                    street: match[1] || '',\r\n                    city: match[2] || '',\r\n                    state: match[3] || '',\r\n                    zip: match[4] || '',\r\n                });\r\n            }\r\n        }\r\n\r\n        if (demographics.birthDate) {\r\n            const [month, day, year] = demographics.birthDate.split(' ');\r\n            setBirthdateParts({\r\n                month:\r\n                    monthOptions.find((option) => option.label === month)?.value || '',\r\n                day: day.replace(',', ''),\r\n                year,\r\n            });\r\n        }\r\n    }, [demographics]);\r\n\r\n    const handleAddressChange = (field, value) => {\r\n        const updatedAddressParts = { ...addressParts, [field]: value };\r\n        setAddressParts(updatedAddressParts);\r\n        const combinedAddress = `${updatedAddressParts.street}, ${updatedAddressParts.city}, ${updatedAddressParts.state}, ${updatedAddressParts.zip}`;\r\n        onUpdate({ address: combinedAddress });\r\n    };\r\n\r\n    const handleBirthdateChange = (field, value) => {\r\n        const updatedBirthdateParts = { ...birthdateParts, [field]: value };\r\n        setBirthdateParts(updatedBirthdateParts);\r\n        const monthLabel = monthOptions.find(\r\n            (option) => option.value === updatedBirthdateParts.month\r\n        )?.label;\r\n        const combinedBirthdate = `${monthLabel} ${updatedBirthdateParts.day}, ${updatedBirthdateParts.year}`;\r\n        onUpdate({ birthDate: combinedBirthdate });\r\n    };\r\n\r\n    const handleChange = (field, value) => {\r\n        onUpdate({ [field]: value });\r\n    };\r\n\r\n    const handleCommunicationUpdate = (updatedCommunication) => {\r\n        onUpdate({ communication: updatedCommunication });\r\n    };\r\n\r\n    const handleAliasesUpdate = (updatedAliases) => {\r\n        onUpdate({ aliases: updatedAliases });\r\n    };\r\n\r\n    return (\r\n        <Box\r\n            gap=\"medium\"\r\n            width=\"100%\" // Full width\r\n            background=\"#1c1c1c\"\r\n            pad=\"medium\"\r\n            flex={false}\r\n            style={{ overflow: 'hidden', position: 'relative' }}\r\n        >\r\n            <StyledCard width=\"full\" style={{ border: 'none !important', boxShadow: 'none' }}>\r\n                {/* Single container for both sections */}\r\n                <Box direction=\"column\" flex>\r\n                    <StyledCardHeader>\r\n                        <b>Basic Information</b>\r\n                    </StyledCardHeader>\r\n                    {/* Scrollable content */}\r\n                    <Box flex overflow={{ vertical: 'auto' }} style={{ minHeight: 0 }}>\r\n                        <CardBody pad=\"medium\">\r\n                            <StyledFormField name=\"name\" label=\"Patient Name\">\r\n                                <TextInput\r\n                                    plain\r\n                                    name=\"name\"\r\n                                    placeholder=\"Enter full name\"\r\n                                    value={demographics.name || ''}\r\n                                    onChange={(event) =>\r\n                                        handleChange('name', event.target.value)\r\n                                    }\r\n                                />\r\n                            </StyledFormField>\r\n                            <Box direction=\"row\" gap=\"medium\">\r\n                                <StyledFormField name=\"month\" label=\"Birth Month\">\r\n                                    <CustomSelect\r\n                                        plain // Removes Grommet default styling\r\n                                        options={monthOptions.map((option) => option.label)}\r\n                                        placeholder=\"Select birth month\"\r\n                                        value={\r\n                                            monthOptions.find(\r\n                                                (option) =>\r\n                                                    option.value === birthdateParts.month\r\n                                            )?.label || ''\r\n                                        }\r\n                                        onChange={({ option }) =>\r\n                                            handleBirthdateChange(\r\n                                                'month',\r\n                                                monthOptions.find(\r\n                                                    (opt) => opt.label === option\r\n                                                ).value\r\n                                            )\r\n                                        }\r\n                                    />\r\n                                </StyledFormField>\r\n                                <StyledFormField name=\"day\" label=\"Birth Day\">\r\n                                    <TextInput\r\n                                        plain // Removes Grommet default styling\r\n                                        placeholder=\"Enter birth day\"\r\n                                        name=\"day\"\r\n                                        value={birthdateParts.day || ''}\r\n                                        onChange={(event) =>\r\n                                            handleBirthdateChange('day', event.target.value)\r\n                                        }\r\n                                    />\r\n                                </StyledFormField>\r\n                                <StyledFormField name=\"year\" label=\"Birth Year\">\r\n                                    <TextInput\r\n                                        plain // Removes Grommet default styling\r\n                                        placeholder=\"Enter birth year\"\r\n                                        name=\"year\"\r\n                                        value={birthdateParts.year || ''}\r\n                                        onChange={(event) =>\r\n                                            handleBirthdateChange('year', event.target.value)\r\n                                        }\r\n                                    />\r\n                                </StyledFormField>\r\n                                <StyledFormField name=\"gender\" label=\"Gender\">\r\n                                    <CustomSelect\r\n                                        plain // Removes Grommet default styling\r\n                                        options={['Male', 'Female']}\r\n                                        placeholder=\"Select gender\"\r\n                                        value={demographics.gender || ''}\r\n                                        onChange={({ option }) => handleChange('gender', option)}\r\n                                    />\r\n                                </StyledFormField>\r\n                            </Box>\r\n\r\n                            <Box direction=\"row\" gap=\"medium\">\r\n                                <StyledFormField name=\"language\" label=\"Language\">\r\n                                    <TextInput\r\n                                        plain // Removes Grommet default styling\r\n                                        placeholder=\"Enter preferred language\"\r\n                                        name=\"language\"\r\n                                        value={demographics.language || ''}\r\n                                        onChange={(event) =>\r\n                                            handleChange('language', event.target.value)\r\n                                        }\r\n                                    />\r\n                                </StyledFormField>\r\n                                <StyledFormField name=\"raceEthnicity\" label=\"Race / Ethnicity\">\r\n                                    <TextInput\r\n                                        plain // Removes Grommet default styling\r\n                                        placeholder=\"Enter race or ethnicity\"\r\n                                        name=\"raceEthnicity\"\r\n                                        value={demographics.raceEthnicity || ''}\r\n                                        onChange={(event) =>\r\n                                            handleChange('raceEthnicity', event.target.value)\r\n                                        }\r\n                                    />\r\n                                </StyledFormField>\r\n                                <StyledFormField name=\"maritalStatus\" label=\"Marital Status\">\r\n                                    <TextInput\r\n                                        plain // Removes Grommet default styling\r\n                                        placeholder=\"Enter marital status\"\r\n                                        name=\"maritalStatus\"\r\n                                        value={demographics.maritalStatus || ''}\r\n                                        onChange={(event) =>\r\n                                            handleChange('maritalStatus', event.target.value)\r\n                                        }\r\n                                    />\r\n                                </StyledFormField>\r\n                            </Box>\r\n                            <AliasField\r\n                                aliases={demographics.aliases || []}\r\n                                onUpdate={handleAliasesUpdate}\r\n                            />\r\n                        </CardBody>\r\n\r\n                        {/* Divider or spacing between sections */}\r\n                        <StyledCardHeader>\r\n                            <b>Address Information</b>\r\n                        </StyledCardHeader>\r\n                        <CardBody pad=\"medium\">\r\n                            <StyledFormField name=\"street\" label=\"Street Address\">\r\n                                <TextInput\r\n                                    plain // Removes Grommet default styling\r\n                                    placeholder=\"Enter street address\"\r\n                                    name=\"street\"\r\n                                    value={addressParts.street || ''}\r\n                                    onChange={(event) =>\r\n                                        handleAddressChange('street', event.target.value)\r\n                                    }\r\n                                />\r\n                            </StyledFormField>\r\n                            <Box direction=\"row\" gap=\"medium\">\r\n                                <StyledFormField name=\"city\" label=\"City\">\r\n                                    <TextInput\r\n                                        plain // Removes Grommet default styling\r\n                                        placeholder=\"Enter city\"\r\n                                        name=\"city\"\r\n                                        value={addressParts.city || ''}\r\n                                        onChange={(event) =>\r\n                                            handleAddressChange('city', event.target.value)\r\n                                        }\r\n                                    />\r\n                                </StyledFormField>\r\n                                <StyledFormField name=\"state\" label=\"State\">\r\n                                    <TextInput\r\n                                        plain // Removes Grommet default styling\r\n                                        placeholder=\"Enter state\"\r\n                                        name=\"state\"\r\n                                        value={addressParts.state || ''}\r\n                                        onChange={(event) =>\r\n                                            handleAddressChange('state', event.target.value)\r\n                                        }\r\n                                    />\r\n                                </StyledFormField>\r\n                                <StyledFormField name=\"zip\" label=\"Zip Code\">\r\n                                    <TextInput\r\n                                        plain // Removes Grommet default styling\r\n                                        placeholder=\"Enter zip code\"\r\n                                        name=\"zip\"\r\n                                        value={addressParts.zip || ''}\r\n                                        onChange={(event) =>\r\n                                            handleAddressChange('zip', event.target.value)\r\n                                        }\r\n                                    />\r\n                                </StyledFormField>\r\n                            </Box>\r\n                            <CommunicationField\r\n                                communication={demographics.communication}\r\n                                onUpdate={handleCommunicationUpdate}\r\n                            />\r\n                        </CardBody>\r\n                    </Box>\r\n                </Box>\r\n            </StyledCard>\r\n        </Box>\r\n    );\r\n}\r\n\r\n    export default PatientDemographics;\r\n","C:\\Users\\Ajdurden8\\Documents\\GitHub\\physician-dashboard-upgraded\\new-directory-name\\src\\utils\\chartUtils.js",[],"C:\\Users\\Ajdurden8\\Documents\\GitHub\\physician-dashboard-upgraded\\new-directory-name\\src\\components\\AllergiesMedications.js",[],"C:\\Users\\Ajdurden8\\Documents\\GitHub\\physician-dashboard-upgraded\\new-directory-name\\src\\components\\MarkdownMessage.js",[],"C:\\Users\\Ajdurden8\\Documents\\GitHub\\physician-dashboard-upgraded\\new-directory-name\\src\\components\\dashboard\\ChatContainer.js",["378","379"],"import React, { useRef, useEffect } from 'react';\r\nimport {Box, Button, Heading} from 'grommet';\r\nimport { Microphone, Send } from 'grommet-icons';\r\nimport {StyledChatContainer, StyledTextArea, StyledTextInput} from './StyledComponents';\r\nimport Message from '../Message';\r\nimport ProcessingOverlay from './ProcessingOverlay';\r\n\r\nconst Chat = ({ chatHistory, inputText, setInputText, sendMessage, handleVoiceCommand, listening, loading }) => {\r\n    const messageListRef = useRef(null);\r\n    const inputRef = useRef(null);\r\n\r\n    useEffect(() => {\r\n        if (messageListRef.current) {\r\n            messageListRef.current.scrollTop = messageListRef.current.scrollHeight;\r\n        }\r\n    }, [chatHistory]);\r\n\r\n    // Preload the welcome message in the chat history\r\n    const initialMessage = {\r\n        type: 'ai',\r\n        text: 'Welcome to Agama AI, how may I assist you today?',\r\n        label: '',\r\n        timestamp: new Date().toLocaleTimeString(),\r\n    };\r\n\r\n    //VOICE COMMANDS\r\n    const voiceCommands = {\r\n        type: 'ai',\r\n        text: 'Click \"Commands\" tab above to view the Voice input guide',\r\n        label: '',\r\n        timestamp: new Date().toLocaleTimeString(),\r\n    };\r\n\r\n    const handleInputChange = (event) => {\r\n        setInputText(event.target.value);\r\n        inputRef.current.style.height = 'auto'; // Reset height to auto to measure new height\r\n        if (`${inputRef.current.scrollHeight}` < 128) {\r\n            inputRef.current.style.height = `${inputRef.current.scrollHeight}px`; // Set the height based on scrollHeight\r\n        } else {\r\n            inputRef.current.style.height = '128px';\r\n        }\r\n    };\r\n\r\n    const preloadedChatHistory = [initialMessage, voiceCommands, ...chatHistory];\r\n\r\n    return (\r\n        <StyledChatContainer style={{ position: 'relative', display: 'flex', flexDirection: 'column', height: '100%', overflow: 'hidden' }}>\r\n            {loading && <ProcessingOverlay />}\r\n\r\n            {/* Container to hold chat messages */}\r\n            <Box\r\n                flex\r\n                overflow=\"auto\"  // Enable scrolling if content overflows\r\n                pad=\"small\"\r\n                style={{\r\n                    flexGrow: 1,\r\n                    overflowY: 'auto', // Make sure to apply vertical scrolling\r\n                    scrollbarWidth: 'thin' // Optional: For Firefox, to set a thinner scrollbar\r\n                }}\r\n            >\r\n                <Box ref={messageListRef} style={{ minHeight: 'fit-content', maxHeight: '100%' }}>\r\n                    {preloadedChatHistory.map((msg, index) => (\r\n                        <Message key={index} message={msg} />\r\n                    ))}\r\n                </Box>\r\n            </Box>\r\n\r\n            {/* Input Box and Send Button */}\r\n            <Box direction=\"row\" pad=\"small\" border={{ side: 'top', color: '#444' }} style={{ flexShrink: 0 }}>\r\n                <Button\r\n                    icon={<Microphone color={listening ? 'green' : 'red'} />}\r\n                    onClick={handleVoiceCommand}\r\n                />\r\n                <StyledTextArea\r\n                    ref={inputRef}\r\n                    placeholder=\"Talk or Text...\"\r\n                    value={inputText}\r\n                    onChange={handleInputChange}  // Use the function to handle resizing\r\n                    onKeyDown={(event) => {\r\n                        if (event.key === 'Enter' && !event.shiftKey) {\r\n                            sendMessage(inputText);\r\n                            event.preventDefault(); // Prevents creating a new line on Enter\r\n                        }\r\n                    }}\r\n                    style={{ flexGrow: 1 }} // Allow the text area to take available space\r\n                />\r\n                <Button icon={<Send />} onClick={() => sendMessage(inputText)} />\r\n            </Box>\r\n        </StyledChatContainer>\r\n    );\r\n};\r\n\r\nexport default Chat;\r\n","C:\\Users\\Ajdurden8\\Documents\\GitHub\\physician-dashboard-upgraded\\new-directory-name\\src\\components\\dashboard\\ChartContainer.js",[],"C:\\Users\\Ajdurden8\\Documents\\GitHub\\physician-dashboard-upgraded\\new-directory-name\\src\\components\\Popup.js",[],"C:\\Users\\Ajdurden8\\Documents\\GitHub\\physician-dashboard-upgraded\\new-directory-name\\src\\data\\staticData.js",[],"C:\\Users\\Ajdurden8\\Documents\\GitHub\\physician-dashboard-upgraded\\new-directory-name\\src\\components\\ProcessingOverlay.js",[],"C:\\Users\\Ajdurden8\\Documents\\GitHub\\physician-dashboard-upgraded\\new-directory-name\\src\\styles\\admin.js",[],"C:\\Users\\Ajdurden8\\Documents\\GitHub\\physician-dashboard-upgraded\\new-directory-name\\src\\components\\Procedures.js",["380","381","382","383"],"import React, {useState} from 'react';\r\nimport {Box, FormField, TextInput, Button, DataTable, TextArea} from 'grommet';\r\nimport {Add, Edit, Trash, Save} from 'grommet-icons';\r\nimport {StyledDataTable} from \"../styles/admin\";\r\nimport styled from \"styled-components\";\r\nimport {StyledFormField} from \"../styles/admin\";\r\n\r\nconst Procedures = ({procedures, onUpdate}) => {\r\n\r\n    const [newProcedure, setNewProcedure] = useState({procedure: '', date: '', reason: ''});\r\n    const [editingIndex, setEditingIndex] = useState(null);\r\n    const [editingProcedure, setEditingProcedure] = useState({procedure: '', date: '', reason: ''});\r\n\r\n    const handleAdd = () => {\r\n        if (newProcedure.procedure.trim() === '' || newProcedure.date.trim() === '' || newProcedure.reason.trim() === '') return;\r\n        onUpdate([...procedures, newProcedure]);\r\n        setNewProcedure({procedure: '', date: '', reason: ''});\r\n    };\r\n\r\n    const handleEdit = (index) => {\r\n        setEditingIndex(index);\r\n        setEditingProcedure(procedures[index]);\r\n    };\r\n\r\n    const handleSaveEdit = (index) => {\r\n        const updatedProcedures = [...procedures];\r\n        updatedProcedures[index] = editingProcedure;\r\n        onUpdate(updatedProcedures);\r\n        setEditingIndex(null);\r\n        setEditingProcedure({procedure: '', date: '', reason: ''});\r\n    };\r\n\r\n    const handleDelete = (index) => {\r\n        const updatedProcedures = procedures.filter((_, i) => i !== index);\r\n        onUpdate(updatedProcedures);\r\n    };\r\n\r\n    return (\r\n        <Box height=\"large\" overflow=\"auto\">\r\n            <Box direction=\"row\" gap=\"small\" align=\"center\" pad={{vertical: 'large'}}>\r\n                <StyledFormField>\r\n                    <TextInput\r\n                        placeholder=\"Procedure\"\r\n                        value={newProcedure.procedure}\r\n                        onChange={(e) => setNewProcedure({...newProcedure, procedure: e.target.value})}\r\n                    />\r\n                </StyledFormField>\r\n                <StyledFormField>\r\n                    <TextInput\r\n                        placeholder=\"Date\"\r\n                        value={newProcedure.date}\r\n                        onChange={(e) => setNewProcedure({...newProcedure, date: e.target.value})}\r\n                    />\r\n                </StyledFormField>\r\n                <StyledFormField>\r\n                    <TextInput\r\n                        placeholder=\"Reason\"\r\n                        value={newProcedure.reason}\r\n                        onChange={(e) => setNewProcedure({...newProcedure, reason: e.target.value})}\r\n                    />\r\n                </StyledFormField>\r\n                <Button icon={<Add/>} onClick={handleAdd}/>\r\n            </Box>\r\n            <StyledDataTable\r\n                primaryKey=\"index\"  // Specify a primary key that's not the first column\r\n                columns={[\r\n                    {\r\n                        property: 'procedure',\r\n                        header: 'Procedure',\r\n                        primary: false,  // Explicitly set primary to false\r\n                        render: (data) =>\r\n                            editingIndex === data.index ? (\r\n                                <TextInput\r\n                                    value={editingProcedure.procedure}\r\n                                    onChange={(e) => setEditingProcedure({\r\n                                        ...editingProcedure,\r\n                                        procedure: e.target.value\r\n                                    })}\r\n                                />\r\n                            ) : (\r\n                                data.procedure\r\n                            ),\r\n                    },\r\n                    {\r\n                        property: 'date',\r\n                        header: 'Date',\r\n                        render: (data) =>\r\n                            editingIndex === data.index ? (\r\n                                <TextInput\r\n                                    value={editingProcedure.date}\r\n                                    onChange={(e) => setEditingProcedure({...editingProcedure, date: e.target.value})}\r\n                                />\r\n                            ) : (\r\n                                data.date\r\n                            ),\r\n                    },\r\n                    {\r\n                        property: 'reason',\r\n                        header: 'Reason',\r\n                        render: (data) =>\r\n                            editingIndex === data.index ? (\r\n                                <TextInput\r\n                                    value={editingProcedure.reason}\r\n                                    onChange={(e) => setEditingProcedure({...editingProcedure, reason: e.target.value})}\r\n                                />\r\n                            ) : (\r\n                                data.reason\r\n                            ),\r\n                    },\r\n                    {\r\n                        property: 'actions',\r\n                        header: 'Actions',\r\n                        render: (data) =>\r\n                            editingIndex === data.index ? (\r\n                                <Button icon={<Save />} onClick={() => handleSaveEdit(data.index)} />\r\n                            ) : (\r\n                                <Box direction=\"row\" gap=\"small\">\r\n                                    <Button icon={<Edit />} onClick={() => handleEdit(data.index)} />\r\n                                    <Button icon={<Trash />} onClick={() => handleDelete(data.index)} />\r\n                                </Box>\r\n                            ),\r\n                    },\r\n                ]}\r\n                data={procedures.map((procedure, index) => ({ ...procedure, index }))}\r\n            />\r\n        </Box>\r\n    );\r\n};\r\n\r\nexport default Procedures;\r\n","C:\\Users\\Ajdurden8\\Documents\\GitHub\\physician-dashboard-upgraded\\new-directory-name\\src\\components\\SocialHistory.js",["384"],"import React from 'react';\r\nimport { Box, FormField, TextInput, Card, CardBody, CardHeader, Heading } from 'grommet';\r\nimport styled from 'styled-components';\r\nimport {StyledFormField} from \"../styles/admin\";\r\n\r\n// Styled components for the card, headers, and form fields to match the dark theme\r\nconst StyledCard = styled(Card)`\r\n  background-color: #444; /* Left panel background */\r\n  color: #fff; /* Default text color */\r\n  border-radius: 5px;\r\n  box-shadow: none;\r\n  height: 100%; /* Ensure equal height for all cards */\r\n`;\r\n\r\nconst StyledCardHeader = styled(CardHeader)`\r\n  background-color: #444; /* Top menu background */\r\n  color: #fff; /* Neon cyan for headings */\r\n  padding: 1rem;\r\n`;\r\n\r\n// Parent container with CSS grid\r\nconst GridContainer = styled(Box)`\r\n  display: grid;\r\n  grid-template-columns: repeat(3, 1fr); /* Adjust columns to fit your layout */\r\n  grid-gap: 32px; /* Gap between cards */\r\n  width: 100%;\r\n  align-items: start; /* Align items to the top */\r\n  padding: 1rem;\r\n`;\r\n\r\nconst SocialHistory = ({ socialHistory, onUpdate }) => {\r\n    const handleChange = (field, value) => {\r\n        onUpdate({\r\n            ...socialHistory,\r\n            [field]: value,\r\n        });\r\n    };\r\n\r\n    return (\r\n        <GridContainer>\r\n            <StyledCard>\r\n                <StyledCardHeader>\r\n                    <Heading level=\"3\" margin=\"none\">Tobacco Use</Heading>\r\n                </StyledCardHeader>\r\n                <CardBody pad=\"medium\">\r\n                    <StyledFormField name=\"smokingTobacco\" label=\"Smoking Tobacco\">\r\n                        <TextInput\r\n                            name=\"smokingTobacco\"\r\n                            value={socialHistory.smokingTobacco}\r\n                            onChange={(event) => handleChange('smokingTobacco', event.target.value)}\r\n                        />\r\n                    </StyledFormField>\r\n                    <StyledFormField name=\"smokelessTobacco\" label=\"Smokeless Tobacco\">\r\n                        <TextInput\r\n                            name=\"smokelessTobacco\"\r\n                            value={socialHistory.smokelessTobacco}\r\n                            onChange={(event) => handleChange('smokelessTobacco', event.target.value)}\r\n                        />\r\n                    </StyledFormField>\r\n                    <StyledFormField name=\"tobaccoCessation\" label=\"Tobacco Cessation\">\r\n                        <TextInput\r\n                            name=\"tobaccoCessation\"\r\n                            value={socialHistory.tobaccoCessation}\r\n                            onChange={(event) => handleChange('tobaccoCessation', event.target.value)}\r\n                        />\r\n                    </StyledFormField>\r\n                </CardBody>\r\n            </StyledCard>\r\n\r\n            <StyledCard>\r\n                <StyledCardHeader>\r\n                    <Heading level=\"3\" margin=\"none\">Sex and Gender Information</Heading>\r\n                </StyledCardHeader>\r\n                <CardBody pad=\"medium\">\r\n                    <StyledFormField name=\"sexAssignedAtBirth\" label=\"Sex Assigned at Birth\">\r\n                        <TextInput\r\n                            name=\"sexAssignedAtBirth\"\r\n                            value={socialHistory.sexAssignedAtBirth}\r\n                            onChange={(event) => handleChange('sexAssignedAtBirth', event.target.value)}\r\n                        />\r\n                    </StyledFormField>\r\n                    <StyledFormField name=\"genderIdentity\" label=\"Gender Identity\">\r\n                        <TextInput\r\n                            name=\"genderIdentity\"\r\n                            value={socialHistory.genderIdentity}\r\n                            onChange={(event) => handleChange('genderIdentity', event.target.value)}\r\n                        />\r\n                    </StyledFormField>\r\n                    <StyledFormField name=\"sexualOrientation\" label=\"Sexual Orientation\">\r\n                        <TextInput\r\n                            name=\"sexualOrientation\"\r\n                            value={socialHistory.sexualOrientation}\r\n                            onChange={(event) => handleChange('sexualOrientation', event.target.value)}\r\n                        />\r\n                    </StyledFormField>\r\n                </CardBody>\r\n            </StyledCard>\r\n\r\n            {/* Add additional cards following the same structure here */}\r\n        </GridContainer>\r\n    );\r\n};\r\n\r\nexport default SocialHistory;\r\n","C:\\Users\\Ajdurden8\\Documents\\GitHub\\physician-dashboard-upgraded\\new-directory-name\\src\\components\\ActiveProblems.js",["385","386","387"],"import React, { useState } from 'react';\r\nimport { Box, FormField, TextInput, Button, DataTable } from 'grommet';\r\nimport { Add, Edit, Trash, Save } from 'grommet-icons';\r\nimport { StyledDataTable } from \"../styles/admin\";\r\nimport styled from \"styled-components\";\r\nimport {StyledFormField} from \"../styles/admin\";\r\n\r\nconst ActiveProblems = ({ problems, onUpdate }) => {\r\n\r\n\r\n\r\n    const [newProblem, setNewProblem] = useState({ problem: '', notedDate: '', diagnosedDate: '' });\r\n    const [editingIndex, setEditingIndex] = useState(null);\r\n    const [editingProblem, setEditingProblem] = useState({ problem: '', notedDate: '', diagnosedDate: '' });\r\n\r\n    const handleAdd = () => {\r\n        if (newProblem.problem.trim() === '' || newProblem.notedDate.trim() === '' || newProblem.diagnosedDate.trim() === '') return;\r\n        onUpdate([...problems, newProblem]);\r\n        setNewProblem({ problem: '', notedDate: '', diagnosedDate: '' });\r\n    };\r\n\r\n    const handleEdit = (index) => {\r\n        setEditingIndex(index);\r\n        setEditingProblem(problems[index]);\r\n    };\r\n\r\n    const handleSaveEdit = (index) => {\r\n        const updatedProblems = [...problems];\r\n        updatedProblems[index] = editingProblem;\r\n        onUpdate(updatedProblems);\r\n        setEditingIndex(null);\r\n        setEditingProblem({ problem: '', notedDate: '', diagnosedDate: '' });\r\n    };\r\n\r\n    const handleDelete = (index) => {\r\n        const updatedProblems = problems.filter((_, i) => i !== index);\r\n        onUpdate(updatedProblems);\r\n    };\r\n\r\n    return (\r\n        <Box height=\"large\" overflow=\"auto\">\r\n            <Box direction=\"row\" gap=\"small\" align=\"center\" pad={{ vertical: 'large' }}>\r\n                <StyledFormField>\r\n                    <TextInput\r\n                        placeholder=\"Add new problem\"\r\n                        value={newProblem.problem}\r\n                        onChange={(e) => setNewProblem({ ...newProblem, problem: e.target.value })}\r\n                    />\r\n                </StyledFormField>\r\n                <StyledFormField>\r\n                <TextInput\r\n                    placeholder=\"Noted Date\"\r\n                    value={newProblem.notedDate}\r\n                    onChange={(e) => setNewProblem({ ...newProblem, notedDate: e.target.value })}\r\n                />\r\n                </StyledFormField>\r\n                <StyledFormField>\r\n                <TextInput\r\n                    placeholder=\"Diagnosed Date\"\r\n                    value={newProblem.diagnosedDate}\r\n                    onChange={(e) => setNewProblem({ ...newProblem, diagnosedDate: e.target.value })}\r\n                />\r\n                </StyledFormField>\r\n                <Button icon={<Add />} onClick={handleAdd} />\r\n            </Box>\r\n            <StyledDataTable\r\n                primaryKey=\"index\"\r\n                columns={[\r\n                    {\r\n                        property: 'problem',\r\n                        header: 'Problem',\r\n                        primary: false,\r\n                        render: (data) =>\r\n                            editingIndex === data.index ? (\r\n                                <TextInput\r\n                                    value={editingProblem.problem}\r\n                                    onChange={(e) => setEditingProblem({ ...editingProblem, problem: e.target.value })}\r\n                                />\r\n                            ) : (\r\n                                data.problem\r\n                            ),\r\n                    },\r\n                    {\r\n                        property: 'notedDate',\r\n                        header: 'Noted Date',\r\n                        render: (data) =>\r\n                            editingIndex === data.index ? (\r\n                                <TextInput\r\n                                    value={editingProblem.notedDate}\r\n                                    onChange={(e) => setEditingProblem({ ...editingProblem, notedDate: e.target.value })}\r\n                                />\r\n                            ) : (\r\n                                data.notedDate\r\n                            ),\r\n                    },\r\n                    {\r\n                        property: 'diagnosedDate',\r\n                        header: 'Diagnosed Date',\r\n                        render: (data) =>\r\n                            editingIndex === data.index ? (\r\n                                <TextInput\r\n                                    value={editingProblem.diagnosedDate}\r\n                                    onChange={(e) => setEditingProblem({ ...editingProblem, diagnosedDate: e.target.value })}\r\n                                />\r\n                            ) : (\r\n                                data.diagnosedDate\r\n                            ),\r\n                    },\r\n                    {\r\n                        property: 'actions',\r\n                        header: 'Actions',\r\n                        render: (data) =>\r\n                            editingIndex === data.index ? (\r\n                                <Button icon={<Save />} onClick={() => handleSaveEdit(data.index)} />\r\n                            ) : (\r\n                                <Box direction=\"row\" gap=\"small\">\r\n                                    <Button icon={<Edit />} onClick={() => handleEdit(data.index)} />\r\n                                    <Button icon={<Trash />} onClick={() => handleDelete(data.index)} />\r\n                                </Box>\r\n                            ),\r\n                    },\r\n                ]}\r\n                data={problems.map((problem, index) => ({ ...problem, index }))}\r\n            />\r\n        </Box>\r\n    );\r\n};\r\n\r\nexport default ActiveProblems;\r\n","C:\\Users\\Ajdurden8\\Documents\\GitHub\\physician-dashboard-upgraded\\new-directory-name\\src\\components\\CommunicationField.js",["388","389","390"],"import React, { useState, useEffect } from 'react';\r\nimport { Box, FormField, TextInput, Button, Select, Text } from 'grommet';\r\nimport { Add, Edit, Trash } from 'grommet-icons';\r\nimport styled from \"styled-components\";\r\nimport {CustomSelect, StyledFormField} from \"../styles/admin\";\r\n\r\nconst communicationTypes = ['home', 'work', 'mobile', 'email', 'alternateEmail'];\r\n\r\nconst CommunicationField = ({ communication, onUpdate }) => {\r\n    const [type, setType] = useState('');\r\n    const [value, setValue] = useState('');\r\n    const [editIndex, setEditIndex] = useState(null);\r\n\r\n    const [entries, setEntries] = useState([]);\r\n\r\n    useEffect(() => {\r\n        const initialEntries = Array.isArray(communication)\r\n            ? communication\r\n            : Object.entries(communication).map(([key, val]) => ({ type: key, value: val }));\r\n        setEntries(initialEntries);\r\n    }, [communication]);\r\n\r\n    const handleAdd = () => {\r\n        const newEntries = [...entries];\r\n        if (editIndex !== null) {\r\n            newEntries[editIndex] = { type, value };\r\n            setEditIndex(null);\r\n        } else {\r\n            newEntries.push({ type, value });\r\n        }\r\n        setEntries(newEntries);\r\n        setType('');\r\n        setValue('');\r\n        onUpdate(newEntries.reduce((acc, entry) => {\r\n            acc[entry.type] = entry.value;\r\n            return acc;\r\n        }, {}));\r\n    };\r\n\r\n    const handleEdit = (index) => {\r\n        setType(entries[index].type);\r\n        setValue(entries[index].value);\r\n        setEditIndex(index);\r\n    };\r\n\r\n    const handleDelete = (index) => {\r\n        const newEntries = entries.filter((_, i) => i !== index);\r\n        setEntries(newEntries);\r\n        onUpdate(newEntries.reduce((acc, entry) => {\r\n            acc[entry.type] = entry.value;\r\n            return acc;\r\n        }, {}));\r\n    };\r\n\r\n    return (\r\n        <Box>\r\n            <Box direction=\"row\" gap=\"small\" align=\"center\">\r\n                <StyledFormField name=\"type\" label=\"Communication Type\">\r\n                    <CustomSelect\r\n                        plain\r\n                        placeholder=\"Select Contact Type\"\r\n                        options={communicationTypes}\r\n                        value={type}\r\n                        onChange={({ option }) => setType(option)}\r\n                    />\r\n                </StyledFormField>\r\n                <StyledFormField name=\"value\" label=\"Value\">\r\n                    <TextInput\r\n                        name=\"value\"\r\n                        value={value}\r\n                        onChange={(event) => setValue(event.target.value)}\r\n                    />\r\n                </StyledFormField>\r\n                <Button icon={<Add />} onClick={handleAdd} />\r\n            </Box>\r\n            <Box margin={{ top: 'small' }}>\r\n                {entries.map((comm, index) => (\r\n                    <Box\r\n                        key={index}\r\n                        direction=\"row\"\r\n                        align=\"center\"\r\n                        justify=\"between\"\r\n                        gap=\"small\"\r\n                        pad={{ vertical: 'small' }}\r\n                        border={{ side: 'bottom', color: 'light-4' }}\r\n                    >\r\n                        <Box flex={{ grow: 1 }}>\r\n                            <Text weight=\"bold\">{comm.type}</Text>\r\n                            <Text>{comm.value}</Text>\r\n                        </Box>\r\n                        <Box direction=\"row\" gap=\"small\">\r\n                            <Button icon={<Edit />} onClick={() => handleEdit(index)} />\r\n                            <Button icon={<Trash />} onClick={() => handleDelete(index)} />\r\n                        </Box>\r\n                    </Box>\r\n                ))}\r\n            </Box>\r\n        </Box>\r\n    );\r\n};\r\n\r\nexport default CommunicationField;\r\n","C:\\Users\\Ajdurden8\\Documents\\GitHub\\physician-dashboard-upgraded\\new-directory-name\\src\\components\\LastFiledVitalSigns.js",["391"],"import React from 'react';\r\nimport { Box, FormField, TextInput, TextArea, Card, CardBody, CardHeader, Heading } from 'grommet';\r\nimport styled from 'styled-components';\r\nimport {StyledFormField} from \"../styles/admin\";\r\n\r\n// Styled components for the card, headers, and form fields to match the dark theme\r\nconst StyledCard = styled(Card)`\r\n  background-color: #444; /* Left panel background */\r\n  color: #fff; /* Default text color */\r\n  border-radius: 5px;\r\n  box-shadow: none;\r\n  height: 100%; /* Ensure equal height for all cards */\r\n`;\r\n\r\nconst StyledCardHeader = styled(CardHeader)`\r\n  background-color: #444; /* Top menu background */\r\n  color: #fff; /* Neon cyan for headings */\r\n  padding: 1rem;\r\n`;\r\n\r\n// Parent container with CSS grid\r\nconst GridContainer = styled(Box)`\r\n  display: grid;\r\n  grid-template-columns: repeat(4, 1fr); /* 4 columns in the grid */\r\n  grid-gap: 32px; /* Gap between the cards both horizontally and vertically */\r\n  width: 100%;\r\n  align-items: start; /* Align all items to the start to prevent any vertical misalignment */\r\n  padding: 1rem;\r\n`;\r\n\r\nconst LastFiledVitalSigns = ({ vitals = {}, onUpdate }) => {\r\n    const defaultVitals = {\r\n        bloodPressure: '',\r\n        pulse: '',\r\n        temperature: '',\r\n        respiratoryRate: '',\r\n        oxygenSaturation: '',\r\n        inhaledOxygenConcentration: '',\r\n        weight: '',\r\n        height: '',\r\n        bmi: '',\r\n        comments: ''\r\n    };\r\n\r\n    const vitalsData = { ...defaultVitals, ...vitals };\r\n\r\n    const handleChange = (field, value) => {\r\n        onUpdate({\r\n            ...vitalsData,\r\n            [field]: value,\r\n        });\r\n    };\r\n\r\n    return (\r\n        <GridContainer>\r\n            <StyledCard>\r\n                <StyledCardHeader>\r\n                    <Heading level=\"3\" margin=\"none\">Basic Vitals</Heading>\r\n                </StyledCardHeader>\r\n                <CardBody pad=\"medium\">\r\n                    <StyledFormField name=\"bloodPressure\" label=\"Blood Pressure\">\r\n                        <TextInput\r\n                            name=\"bloodPressure\"\r\n                            value={vitalsData.bloodPressure}\r\n                            onChange={(event) => handleChange('bloodPressure', event.target.value)}\r\n                        />\r\n                    </StyledFormField>\r\n                    <StyledFormField name=\"pulse\" label=\"Pulse\">\r\n                        <TextInput\r\n                            name=\"pulse\"\r\n                            value={vitalsData.pulse}\r\n                            onChange={(event) => handleChange('pulse', event.target.value)}\r\n                        />\r\n                    </StyledFormField>\r\n                    <StyledFormField name=\"temperature\" label=\"Temperature\">\r\n                        <TextInput\r\n                            name=\"temperature\"\r\n                            value={vitalsData.temperature}\r\n                            onChange={(event) => handleChange('temperature', event.target.value)}\r\n                        />\r\n                    </StyledFormField>\r\n                    <StyledFormField name=\"respiratoryRate\" label=\"Respiratory Rate\">\r\n                        <TextInput\r\n                            name=\"respiratoryRate\"\r\n                            value={vitalsData.respiratoryRate}\r\n                            onChange={(event) => handleChange('respiratoryRate', event.target.value)}\r\n                        />\r\n                    </StyledFormField>\r\n                </CardBody>\r\n            </StyledCard>\r\n\r\n            <StyledCard>\r\n                <StyledCardHeader>\r\n                    <Heading level=\"3\" margin=\"none\">Oxygen & Weight</Heading>\r\n                </StyledCardHeader>\r\n                <CardBody pad=\"medium\">\r\n                    <StyledFormField name=\"oxygenSaturation\" label=\"Oxygen Saturation\">\r\n                        <TextInput\r\n                            name=\"oxygenSaturation\"\r\n                            value={vitalsData.oxygenSaturation}\r\n                            onChange={(event) => handleChange('oxygenSaturation', event.target.value)}\r\n                        />\r\n                    </StyledFormField>\r\n                    <StyledFormField name=\"inhaledOxygenConcentration\" label=\"Inhaled Oxygen Concentration\">\r\n                        <TextInput\r\n                            name=\"inhaledOxygenConcentration\"\r\n                            value={vitalsData.inhaledOxygenConcentration}\r\n                            onChange={(event) => handleChange('inhaledOxygenConcentration', event.target.value)}\r\n                        />\r\n                    </StyledFormField>\r\n                    <StyledFormField name=\"weight\" label=\"Weight\">\r\n                        <TextInput\r\n                            name=\"weight\"\r\n                            value={vitalsData.weight}\r\n                            onChange={(event) => handleChange('weight', event.target.value)}\r\n                        />\r\n                    </StyledFormField>\r\n                </CardBody>\r\n            </StyledCard>\r\n\r\n            <StyledCard>\r\n                <StyledCardHeader>\r\n                    <Heading level=\"3\" margin=\"none\">Height & BMI</Heading>\r\n                </StyledCardHeader>\r\n                <CardBody pad=\"medium\">\r\n                    <StyledFormField name=\"height\" label=\"Height\">\r\n                        <TextInput\r\n                            name=\"height\"\r\n                            value={vitalsData.height}\r\n                            onChange={(event) => handleChange('height', event.target.value)}\r\n                        />\r\n                    </StyledFormField>\r\n                    <StyledFormField name=\"bmi\" label=\"Body Mass Index\">\r\n                        <TextInput\r\n                            name=\"bmi\"\r\n                            value={vitalsData.bmi}\r\n                            onChange={(event) => handleChange('bmi', event.target.value)}\r\n                        />\r\n                    </StyledFormField>\r\n                </CardBody>\r\n            </StyledCard>\r\n\r\n            <StyledCard>\r\n                <StyledCardHeader>\r\n                    <Heading level=\"3\" margin=\"none\">Comments</Heading>\r\n                </StyledCardHeader>\r\n                <CardBody pad=\"medium\">\r\n                    <StyledFormField name=\"comments\" label=\"Comments\">\r\n                        <TextArea\r\n                            name=\"comments\"\r\n                            value={vitalsData.comments}\r\n                            onChange={(event) => handleChange('comments', event.target.value)}\r\n                        />\r\n                    </StyledFormField>\r\n                </CardBody>\r\n            </StyledCard>\r\n        </GridContainer>\r\n    );\r\n};\r\n\r\nexport default LastFiledVitalSigns;\r\n","C:\\Users\\Ajdurden8\\Documents\\GitHub\\physician-dashboard-upgraded\\new-directory-name\\src\\components\\AliasField.js",["392","393"],"import React, { useState } from 'react';\r\nimport { Box, Button, FormField, TextInput, List } from 'grommet';\r\nimport { Add, Edit, Trash } from 'grommet-icons';\r\nimport styled from \"styled-components\";\r\nimport {StyledFormField} from \"../styles/admin\";\r\n\r\nconst AliasField = ({ aliases, onUpdate }) => {\r\n    const [newAlias, setNewAlias] = useState('');\r\n    const [editingIndex, setEditingIndex] = useState(null);\r\n\r\n    const handleAddAlias = () => {\r\n        if (newAlias) {\r\n            let updatedAliases;\r\n            if (editingIndex !== null) {\r\n                updatedAliases = [...aliases];\r\n                updatedAliases[editingIndex] = newAlias;\r\n                setEditingIndex(null);\r\n            } else {\r\n                updatedAliases = [...aliases, newAlias];\r\n            }\r\n            setNewAlias('');\r\n            onUpdate(updatedAliases);\r\n        }\r\n    };\r\n\r\n    const handleEditAlias = (index) => {\r\n        setNewAlias(aliases[index]);\r\n        setEditingIndex(index);\r\n    };\r\n\r\n    const handleDeleteAlias = (index) => {\r\n        const updatedAliases = aliases.filter((_, i) => i !== index);\r\n        onUpdate(updatedAliases);\r\n    };\r\n\r\n    return (\r\n        <Box>\r\n            <Box direction=\"row\" gap=\"small\" align=\"center\">\r\n                <StyledFormField label=\"Former / Aliases\">\r\n                    <TextInput\r\n                        placeholder=\"Enter Alias\"\r\n                        value={newAlias}\r\n                        onChange={(event) => setNewAlias(event.target.value)}\r\n                    />\r\n                </StyledFormField>\r\n                <Button icon={<Add />} onClick={handleAddAlias} />\r\n            </Box>\r\n            <List\r\n                primaryKey=\"alias\"\r\n                data={aliases.map((alias, index) => ({ alias, index }))}\r\n                action={(item) => (\r\n                    <Box direction=\"row\" gap=\"small\">\r\n                        <Button icon={<Edit />} onClick={() => handleEditAlias(item.index)} />\r\n                        <Button icon={<Trash />} onClick={() => handleDeleteAlias(item.index)} />\r\n                    </Box>\r\n                )}\r\n            />\r\n        </Box>\r\n    );\r\n};\r\n\r\nexport default AliasField;\r\n","C:\\Users\\Ajdurden8\\Documents\\GitHub\\physician-dashboard-upgraded\\new-directory-name\\src\\components\\Allergies.js",["394"],"import React, { useState } from 'react';\r\nimport {Box, TextInput, Button, DataTable, FormField} from 'grommet';\r\nimport { Add, Edit, Trash, Save } from 'grommet-icons';\r\nimport styled from \"styled-components\";\r\nimport {StyledFormField} from \"../styles/admin\";\r\n\r\nconst Allergies = ({ allergies, onUpdate }) => {\r\n    const [newAllergy, setNewAllergy] = useState('');\r\n    const [editingIndex, setEditingIndex] = useState(null);\r\n    const [editingAllergy, setEditingAllergy] = useState('');\r\n\r\n\r\n    // Styled DataTable for dark mode\r\n    const StyledDataTable = styled(DataTable)`\r\n  background-color: #333; /* Background for left panel */\r\n  \r\n  th {\r\n    background-color: #444;\r\n    color: #f0f0f0; /* Default text color */\r\n    border-bottom: 1px solid #444444; /* Borders between rows */\r\n  }\r\n\r\n  th {\r\n    background-color: #444; /* Header background */\r\n    font-weight: bold;\r\n  }\r\n\r\n  td {\r\n    background-color: #555; /* Header background */\r\n  }\r\n\r\n  tr:nth-child(even) {\r\n    background-color: #555; /* Alternating row background */\r\n  }\r\n  \r\n  tr:hover {\r\n    background-color: #444444; /* Hover row background */\r\n  }\r\n`;\r\n\r\n    const handleAdd = () => {\r\n        if (newAllergy.trim() === '') return;\r\n        onUpdate([...allergies, newAllergy]);\r\n        setNewAllergy('');\r\n    };\r\n\r\n    const handleEdit = (index) => {\r\n        setEditingIndex(index);\r\n        setEditingAllergy(allergies[index].allergy);\r\n    };\r\n\r\n    const handleSaveEdit = (index) => {\r\n        const updatedAllergies = [...allergies];\r\n        updatedAllergies[index].allergy = editingAllergy;\r\n        onUpdate(updatedAllergies);\r\n        setEditingIndex(null);\r\n        setEditingAllergy('');\r\n    };\r\n\r\n    const handleDelete = (index) => {\r\n        const updatedAllergies = allergies.filter((_, i) => i !== index);\r\n        onUpdate(updatedAllergies);\r\n    };\r\n\r\n    return (\r\n        <Box height=\"large\" overflow=\"auto\">\r\n            <Box direction=\"row\" gap=\"small\" align=\"center\" pad={{ vertical: 'large' }}>\r\n                <StyledFormField>\r\n                    <TextInput\r\n                        placeholder=\"Add new allergy\"\r\n                        value={newAllergy}\r\n                        onChange={(e) => setNewAllergy(e.target.value)}\r\n                    />\r\n                </StyledFormField>\r\n                <Button icon={<Add />} onClick={handleAdd} />\r\n            </Box>\r\n            <StyledDataTable\r\n                primaryKey=\"index\"\r\n                columns={[\r\n                    {\r\n                        property: 'allergy',\r\n                        header: 'Allergy',\r\n                        primary: false,\r\n                        render: (data) =>\r\n                            editingIndex === data.index ? (\r\n                                <TextInput\r\n                                    value={editingAllergy}\r\n                                    onChange={(e) => setEditingAllergy(e.target.value)}\r\n                                />\r\n                            ) : (\r\n                                <span>\r\n                                    {typeof data.allergy === 'object'\r\n                                        ? `${data.allergy.name} (Reaction: ${data.allergy.reaction}, Criticality: ${data.allergy.criticality})`\r\n                                        : data.allergy}\r\n                                </span>\r\n                            ),\r\n                    },\r\n                    {\r\n                        property: 'actions',\r\n                        header: 'Actions',\r\n                        render: (data) =>\r\n                            editingIndex === data.index ? (\r\n                                <Button icon={<Save />} onClick={() => handleSaveEdit(data.index)} />\r\n                            ) : (\r\n                                <Box direction=\"row\" gap=\"small\">\r\n                                    <Button icon={<Edit />} onClick={() => handleEdit(data.index)} />\r\n                                    <Button icon={<Trash />} onClick={() => handleDelete(data.index)} />\r\n                                </Box>\r\n                            ),\r\n                    },\r\n                ]}\r\n                data={allergies.map((allergy, index) => ({ allergy, index }))}\r\n            />\r\n        </Box>\r\n    );\r\n};\r\n\r\nexport default Allergies;\r\n","C:\\Users\\Ajdurden8\\Documents\\GitHub\\physician-dashboard-upgraded\\new-directory-name\\src\\components\\Medications.js",["395","396","397"],"import React, {useState} from 'react';\r\nimport {Box, TextInput, Button, DataTable, FormField} from 'grommet';\r\nimport {Add, Edit, Trash, Save} from 'grommet-icons';\r\nimport {StyledDataTable} from \"../styles/admin\";\r\nimport styled from \"styled-components\";\r\nimport {StyledFormField} from \"../styles/admin\";\r\n\r\nconst Medications = ({medications, onUpdate}) => {\r\n\r\n    const initialMedication = {name: '', dosage: '', indication: '', startDate: ''};\r\n    const [newMedication, setNewMedication] = useState(initialMedication);\r\n    const [editingIndex, setEditingIndex] = useState(null);\r\n    const [editingMedication, setEditingMedication] = useState(initialMedication);\r\n\r\n    const handleAdd = () => {\r\n        if (newMedication.name.trim() === '') return;\r\n        onUpdate([...medications, newMedication]);\r\n        setNewMedication(initialMedication);\r\n    };\r\n\r\n    const handleEdit = (index) => {\r\n        setEditingIndex(index);\r\n        setEditingMedication(medications[index]);\r\n    };\r\n\r\n    const handleSaveEdit = (index) => {\r\n        const updatedMedications = [...medications];\r\n        updatedMedications[index] = editingMedication;\r\n        onUpdate(updatedMedications);\r\n        setEditingIndex(null);\r\n        setEditingMedication(initialMedication);\r\n    };\r\n\r\n    const handleDelete = (index) => {\r\n        const updatedMedications = medications.filter((_, i) => i !== index);\r\n        onUpdate(updatedMedications);\r\n    };\r\n\r\n    const handleChange = (e) => {\r\n        const {name, value} = e.target;\r\n        setNewMedication((prev) => ({...prev, [name]: value}));\r\n    };\r\n\r\n    const handleEditChange = (e) => {\r\n        const {name, value} = e.target;\r\n        setEditingMedication((prev) => ({...prev, [name]: value}));\r\n    };\r\n\r\n    return (\r\n        <Box height=\"large\" overflow=\"auto\">\r\n            <Box direction=\"\" gap=\"small\" align=\"center\" pad={{vertical: 'large'}}>\r\n                <StyledFormField>\r\n                    <TextInput\r\n                        placeholder=\"Name\"\r\n                        name=\"name\"\r\n                        value={newMedication.name}\r\n                        onChange={handleChange}\r\n                    />\r\n                </StyledFormField>\r\n                <StyledFormField>\r\n                    <TextInput\r\n                        placeholder=\"Dosage\"\r\n                        name=\"dosage\"\r\n                        value={newMedication.dosage}\r\n                        onChange={handleChange}\r\n                    />\r\n                </StyledFormField>\r\n                <StyledFormField>\r\n                    <TextInput\r\n                        placeholder=\"Indication\"\r\n                        name=\"indication\"\r\n                        value={newMedication.indication}\r\n                        onChange={handleChange}\r\n                    />\r\n                </StyledFormField>\r\n                <StyledFormField>\r\n                    <TextInput\r\n                        placeholder=\"Start Date\"\r\n                        name=\"startDate\"\r\n                        value={newMedication.startDate}\r\n                        onChange={handleChange}\r\n                    />\r\n                </StyledFormField>\r\n                <Button icon={<Add/>} onClick={handleAdd}/>\r\n            </Box>\r\n            <StyledDataTable\r\n                primaryKey=\"index\"\r\n                columns={[\r\n                    {\r\n                        property: 'name',\r\n                        header: 'Name',\r\n                        primary: false,\r\n                        render: (data) =>\r\n                            editingIndex === data.index ? (\r\n                                <TextInput\r\n                                    name=\"name\"\r\n                                    value={editingMedication.name}\r\n                                    onChange={handleEditChange}\r\n                                />\r\n                            ) : (\r\n                                data.name\r\n                            ),\r\n                    },\r\n                    {\r\n                        property: 'dosage',\r\n                        header: 'Dosage',\r\n                        render: (data) =>\r\n                            editingIndex === data.index ? (\r\n                                <TextInput\r\n                                    name=\"dosage\"\r\n                                    value={editingMedication.dosage}\r\n                                    onChange={handleEditChange}\r\n                                />\r\n                            ) : (\r\n                                data.dosage\r\n                            ),\r\n                    },\r\n                    {\r\n                        property: 'indication',\r\n                        header: 'Indication',\r\n                        render: (data) =>\r\n                            editingIndex === data.index ? (\r\n                                <TextInput\r\n                                    name=\"indication\"\r\n                                    value={editingMedication.indication}\r\n                                    onChange={handleEditChange}\r\n                                />\r\n                            ) : (\r\n                                data.indication\r\n                            ),\r\n                    },\r\n                    {\r\n                        property: 'startDate',\r\n                        header: 'Start Date',\r\n                        render: (data) =>\r\n                            editingIndex === data.index ? (\r\n                                <TextInput\r\n                                    name=\"startDate\"\r\n                                    value={editingMedication.startDate}\r\n                                    onChange={handleEditChange}\r\n                                />\r\n                            ) : (\r\n                                data.startDate\r\n                            ),\r\n                    },\r\n                    {\r\n                        property: 'actions',\r\n                        header: 'Actions',\r\n                        render: (data) =>\r\n                            editingIndex === data.index ? (\r\n                                <Button icon={<Save/>} onClick={() => handleSaveEdit(data.index)}/>\r\n                            ) : (\r\n                                <Box direction=\"row\" gap=\"small\">\r\n                                    <Button icon={<Edit/>} onClick={() => handleEdit(data.index)}/>\r\n                                    <Button icon={<Trash/>} onClick={() => handleDelete(data.index)}/>\r\n                                </Box>\r\n                            ),\r\n                    },\r\n                ]}\r\n                data={medications.map((medication, index) => ({...medication, index}))}\r\n            />\r\n        </Box>\r\n    );\r\n};\r\n\r\nexport default Medications;\r\n","C:\\Users\\Ajdurden8\\Documents\\GitHub\\physician-dashboard-upgraded\\new-directory-name\\src\\components\\dashboard\\ProcessingOverlay.js",[],"C:\\Users\\Ajdurden8\\Documents\\GitHub\\physician-dashboard-upgraded\\new-directory-name\\src\\components\\Message.js",[],"C:\\Users\\Ajdurden8\\Documents\\GitHub\\physician-dashboard-upgraded\\new-directory-name\\src\\pages\\Dashboard-Enhanced.js",["398","399","400","401","402","403","404"],"C:\\Users\\Ajdurden8\\Documents\\GitHub\\physician-dashboard-upgraded\\new-directory-name\\src\\components\\dashboard\\ClinicalAutopilot.js",["405","406","407","408","409","410","411","412","413"],"/**\n * Clinical Decision Autopilot\n * Revolutionary AI-powered clinical decision support system\n * Provides real-time guidance, automated workflows, and evidence-based recommendations\n */\n\nimport React, { useState, useEffect, useRef, useCallback } from 'react';\nimport { Box, Text, Button, Stack, Layer, Heading, Meter, Card } from 'grommet';\nimport { StatusGood, StatusWarning, StatusCritical, Robot, Checkmark, Close, FormNext } from 'grommet-icons';\nimport styled, { keyframes, css } from 'styled-components';\nimport ambientIntelligence from '../../services/ambientIntelligence';\nimport predictiveAnalytics from '../../services/predictiveAnalytics';\nimport patientService from '../../services/patientService';\n\nconst pulse = keyframes`\n  0% { transform: scale(1); opacity: 1; }\n  50% { transform: scale(1.05); opacity: 0.9; }\n  100% { transform: scale(1); opacity: 1; }\n`;\n\nconst slideIn = keyframes`\n  from { transform: translateX(100%); opacity: 0; }\n  to { transform: translateX(0); opacity: 1; }\n`;\n\nconst AutopilotContainer = styled(Box)`\n  position: fixed;\n  right: 20px;\n  top: 80px;\n  width: 400px;\n  max-height: calc(100vh - 100px);\n  background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);\n  border-radius: 15px;\n  border: 2px solid #0f3460;\n  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);\n  overflow: hidden;\n  z-index: 1000;\n  animation: ${slideIn} 0.3s ease-out;\n`;\n\nconst AutopilotHeader = styled(Box)`\n  background: linear-gradient(90deg, #0f3460 0%, #16213e 100%);\n  padding: 15px 20px;\n  border-bottom: 1px solid rgba(255, 255, 255, 0.1);\n`;\n\nconst StatusIndicator = styled(Box)`\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  padding: 8px 12px;\n  background: ${props => props.status === 'active' ? 'rgba(0, 255, 0, 0.1)' : 'rgba(255, 255, 0, 0.1)'};\n  border-radius: 20px;\n  border: 1px solid ${props => props.status === 'active' ? 'rgba(0, 255, 0, 0.3)' : 'rgba(255, 255, 0, 0.3)'};\n  ${props => props.status === 'active' && css`animation: ${pulse} 2s infinite;`}\n`;\n\nconst DecisionCard = styled(Card)`\n  background: rgba(255, 255, 255, 0.05);\n  border: 1px solid rgba(255, 255, 255, 0.1);\n  border-radius: 10px;\n  padding: 15px;\n  margin: 10px 0;\n  transition: all 0.3s ease;\n  \n  &:hover {\n    background: rgba(255, 255, 255, 0.08);\n    transform: translateY(-2px);\n    box-shadow: 0 5px 15px rgba(0, 0, 0, 0.3);\n  }\n`;\n\nconst ActionButton = styled(Button)`\n  background: ${props => {\n    switch(props.priority) {\n      case 'critical': return 'linear-gradient(135deg, #e53e3e, #c53030)';\n      case 'high': return 'linear-gradient(135deg, #ed8936, #dd6b20)';\n      case 'medium': return 'linear-gradient(135deg, #4299e1, #3182ce)';\n      default: return 'linear-gradient(135deg, #48bb78, #38a169)';\n    }\n  }};\n  border: none;\n  border-radius: 8px;\n  color: white;\n  font-weight: bold;\n  padding: 10px 20px;\n  transition: all 0.3s ease;\n  \n  &:hover {\n    transform: scale(1.05);\n    box-shadow: 0 5px 15px rgba(0, 0, 0, 0.3);\n  }\n`;\n\nconst ConfidenceMeter = styled(Box)`\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  padding: 5px 0;\n`;\n\nconst InsightBadge = styled(Box)`\n  display: inline-flex;\n  align-items: center;\n  gap: 5px;\n  padding: 4px 8px;\n  background: ${props => {\n    switch(props.type) {\n      case 'diagnosis': return 'rgba(147, 51, 234, 0.2)';\n      case 'treatment': return 'rgba(34, 197, 94, 0.2)';\n      case 'risk': return 'rgba(239, 68, 68, 0.2)';\n      case 'lab': return 'rgba(59, 130, 246, 0.2)';\n      default: return 'rgba(156, 163, 175, 0.2)';\n    }\n  }};\n  border-radius: 12px;\n  font-size: 12px;\n  color: white;\n`;\n\nconst TimelineItem = styled(Box)`\n  position: relative;\n  padding-left: 30px;\n  margin: 15px 0;\n  \n  &::before {\n    content: '';\n    position: absolute;\n    left: 10px;\n    top: 8px;\n    width: 8px;\n    height: 8px;\n    border-radius: 50%;\n    background: ${props => props.completed ? '#10b981' : '#6b7280'};\n  }\n  \n  &::after {\n    content: '';\n    position: absolute;\n    left: 13px;\n    top: 16px;\n    width: 2px;\n    height: calc(100% + 10px);\n    background: rgba(107, 114, 128, 0.3);\n  }\n  \n  &:last-child::after {\n    display: none;\n  }\n`;\n\nconst ClinicalAutopilot = ({ patientId, isActive, onToggle }) => {\n  const [autopilotState, setAutopilotState] = useState('initializing');\n  const [currentDecisions, setCurrentDecisions] = useState([]);\n  const [executedActions, setExecutedActions] = useState([]);\n  const [clinicalInsights, setClinicalInsights] = useState([]);\n  const [workflowSteps, setWorkflowSteps] = useState([]);\n  const [confidenceScore, setConfidenceScore] = useState(0);\n  const [isMinimized, setIsMinimized] = useState(false);\n  const decisionQueueRef = useRef([]);\n  const processingRef = useRef(false);\n\n  useEffect(() => {\n    if (isActive && patientId) {\n      initializeAutopilot();\n    }\n    \n    return () => {\n      if (isActive) {\n        shutdownAutopilot();\n      }\n    };\n  }, [isActive, patientId]);\n\n  /**\n   * Initialize the Clinical Autopilot system\n   */\n  const initializeAutopilot = async () => {\n    try {\n      setAutopilotState('initializing');\n      \n      // Initialize AI systems\n      await ambientIntelligence.initialize(patientId);\n      await predictiveAnalytics.initialize();\n      \n      // Create patient digital twin\n      const patientData = await patientService.getPatient(patientId);\n      const digitalTwin = await predictiveAnalytics.createPatientDigitalTwin(patientId, patientData);\n      \n      // Start clinical workflow analysis\n      const workflow = await analyzeOptimalWorkflow(patientData);\n      setWorkflowSteps(workflow);\n      \n      // Get initial predictions and recommendations\n      const predictions = await predictiveAnalytics.runComprehensivePredictions(digitalTwin);\n      const insights = await generateInitialInsights(predictions);\n      setClinicalInsights(insights);\n      \n      // Start real-time monitoring\n      startRealtimeGuidance();\n      \n      setAutopilotState('active');\n      setConfidenceScore(0.92);\n    } catch (error) {\n      console.error('Autopilot initialization failed:', error);\n      setAutopilotState('error');\n    }\n  };\n\n  /**\n   * Analyze and generate optimal clinical workflow\n   */\n  const analyzeOptimalWorkflow = async (patientData) => {\n    const chiefComplaint = patientData.chiefComplaint || 'General consultation';\n    const conditions = patientData.activeProblems || [];\n    \n    // Generate evidence-based workflow steps\n    const workflow = [\n      {\n        id: 'review',\n        title: 'Review Patient History',\n        status: 'in-progress',\n        duration: '2 min',\n        autoActions: ['Load previous visits', 'Analyze trends'],\n        completed: false\n      },\n      {\n        id: 'vitals',\n        title: 'Assess Current Vitals',\n        status: 'pending',\n        duration: '1 min',\n        autoActions: ['Compare to baseline', 'Flag abnormalities'],\n        completed: false\n      },\n      {\n        id: 'examination',\n        title: 'Physical Examination',\n        status: 'pending',\n        duration: '5 min',\n        autoActions: ['Generate exam template', 'Voice transcription'],\n        completed: false\n      },\n      {\n        id: 'diagnosis',\n        title: 'Differential Diagnosis',\n        status: 'pending',\n        duration: '2 min',\n        autoActions: ['AI diagnosis suggestions', 'Evidence ranking'],\n        completed: false\n      },\n      {\n        id: 'orders',\n        title: 'Orders & Prescriptions',\n        status: 'pending',\n        duration: '3 min',\n        autoActions: ['Drug interaction check', 'Dosage optimization'],\n        completed: false\n      },\n      {\n        id: 'documentation',\n        title: 'Documentation',\n        status: 'pending',\n        duration: '0 min',\n        autoActions: ['Auto-generate SOAP note', 'ICD-10 coding'],\n        completed: false\n      },\n      {\n        id: 'followup',\n        title: 'Schedule Follow-up',\n        status: 'pending',\n        duration: '1 min',\n        autoActions: ['Risk-based scheduling', 'Care coordination'],\n        completed: false\n      }\n    ];\n    \n    // Customize workflow based on chief complaint\n    if (chiefComplaint.toLowerCase().includes('emergency')) {\n      workflow.unshift({\n        id: 'triage',\n        title: 'Emergency Triage',\n        status: 'critical',\n        duration: '30 sec',\n        autoActions: ['Rapid assessment', 'Alert team'],\n        completed: false\n      });\n    }\n    \n    return workflow;\n  };\n\n  /**\n   * Generate initial clinical insights\n   */\n  const generateInitialInsights = async (predictions) => {\n    const insights = [];\n    \n    // Risk assessment insights\n    if (predictions.compositeRisk.score > 0.7) {\n      insights.push({\n        type: 'risk',\n        priority: 'critical',\n        title: 'High Risk Patient',\n        description: `${(predictions.compositeRisk.score * 100).toFixed(0)}% risk of deterioration in next 24h`,\n        action: 'Consider ICU consultation'\n      });\n    }\n    \n    // Diagnostic insights\n    if (predictions['24h'].sepsis.probability > 0.5) {\n      insights.push({\n        type: 'diagnosis',\n        priority: 'high',\n        title: 'Possible Sepsis',\n        description: `${(predictions['24h'].sepsis.probability * 100).toFixed(0)}% probability of sepsis`,\n        action: 'Initiate sepsis protocol'\n      });\n    }\n    \n    // Treatment optimization\n    insights.push({\n      type: 'treatment',\n      priority: 'medium',\n      title: 'Medication Optimization',\n      description: 'AI suggests adjusting current medications',\n      action: 'Review recommendations'\n    });\n    \n    // Lab recommendations\n    const suggestedLabs = await suggestDiagnosticTests(predictions);\n    if (suggestedLabs.length > 0) {\n      insights.push({\n        type: 'lab',\n        priority: 'medium',\n        title: 'Recommended Tests',\n        description: `${suggestedLabs.length} diagnostic tests suggested`,\n        action: 'Review and order'\n      });\n    }\n    \n    return insights;\n  };\n\n  /**\n   * Start real-time clinical guidance\n   */\n  const startRealtimeGuidance = () => {\n    // Listen for ambient intelligence updates\n    window.addEventListener('ambient-intelligence-update', handleAmbientUpdate);\n    \n    // Listen for predictive alerts\n    window.addEventListener('predictive-alert', handlePredictiveAlert);\n    \n    // Start decision processing loop\n    const decisionInterval = setInterval(() => {\n      if (!processingRef.current && decisionQueueRef.current.length > 0) {\n        processNextDecision();\n      }\n    }, 1000);\n    \n    return () => {\n      window.removeEventListener('ambient-intelligence-update', handleAmbientUpdate);\n      window.removeEventListener('predictive-alert', handlePredictiveAlert);\n      clearInterval(decisionInterval);\n    };\n  };\n\n  /**\n   * Handle ambient intelligence updates\n   */\n  const handleAmbientUpdate = (event) => {\n    const { type, data } = event.detail;\n    \n    if (type === 'decisions_available') {\n      // Add new decisions to queue\n      decisionQueueRef.current.push(...data);\n      updateCurrentDecisions();\n    } else if (type === 'documentation_ready') {\n      // Auto-complete documentation step\n      updateWorkflowStep('documentation', 'completed');\n    }\n  };\n\n  /**\n   * Handle predictive alerts\n   */\n  const handlePredictiveAlert = (event) => {\n    const { alerts } = event.detail;\n    \n    for (const alert of alerts) {\n      if (alert.severity === 'critical') {\n        // Add critical decision to front of queue\n        decisionQueueRef.current.unshift({\n          type: 'alert',\n          priority: 'critical',\n          title: alert.message,\n          actions: alert.actions,\n          confidence: 0.95\n        });\n      }\n    }\n    \n    updateCurrentDecisions();\n  };\n\n  /**\n   * Update current decisions display\n   */\n  const updateCurrentDecisions = () => {\n    const topDecisions = decisionQueueRef.current.slice(0, 3);\n    setCurrentDecisions(topDecisions);\n  };\n\n  /**\n   * Process next decision in queue\n   */\n  const processNextDecision = async () => {\n    if (decisionQueueRef.current.length === 0) return;\n    \n    processingRef.current = true;\n    const decision = decisionQueueRef.current[0];\n    \n    // Auto-execute if confidence is high enough\n    if (decision.confidence > 0.9 && decision.autoExecutable) {\n      await executeDecision(decision);\n    }\n    \n    processingRef.current = false;\n  };\n\n  /**\n   * Execute a clinical decision\n   */\n  const executeDecision = async (decision) => {\n    try {\n      let result = null;\n      \n      switch (decision.type) {\n        case 'order':\n          result = await executeOrder(decision);\n          break;\n        case 'prescription':\n          result = await executePrescription(decision);\n          break;\n        case 'documentation':\n          result = await executeDocumentation(decision);\n          break;\n        case 'alert':\n          result = await executeAlert(decision);\n          break;\n        default:\n          result = { success: false, reason: 'Unknown decision type' };\n      }\n      \n      if (result.success) {\n        // Add to executed actions\n        setExecutedActions(prev => [...prev, {\n          ...decision,\n          executedAt: new Date().toISOString(),\n          result\n        }]);\n        \n        // Remove from queue\n        decisionQueueRef.current.shift();\n        updateCurrentDecisions();\n      }\n    } catch (error) {\n      console.error('Decision execution failed:', error);\n    }\n  };\n\n  /**\n   * Execute documentation\n   */\n  const executeDocumentation = async (decision) => {\n    try {\n      const documentationData = {\n        patientId,\n        type: decision.documentationType || 'progress_note',\n        content: decision.content,\n        metadata: decision.metadata\n      };\n      \n      // For now, just log the documentation\n      console.log('Documentation created:', documentationData);\n      // In production: const result = await patientService.createDocumentation(documentationData);\n      return { success: true, documentId: Date.now() };\n    } catch (error) {\n      console.error('Documentation execution failed:', error);\n      return { success: false, reason: error.message };\n    }\n  };\n\n  /**\n   * Execute alert\n   */\n  const executeAlert = async (decision) => {\n    try {\n      // Log the alert\n      console.log('Clinical alert:', {\n        patientId,\n        alertType: decision.alertType,\n        severity: decision.severity || 'high',\n        message: decision.message,\n        actions: decision.actions\n      });\n      \n      // In production: await patientService.logClinicalAlert(...)\n      \n      return { success: true, alertLogged: true };\n    } catch (error) {\n      console.error('Alert execution failed:', error);\n      return { success: false, reason: error.message };\n    }\n  };\n\n  /**\n   * Execute an order\n   */\n  const executeOrder = async (decision) => {\n    const orderData = {\n      patientId,\n      type: decision.orderType,\n      tests: decision.tests,\n      priority: decision.priority,\n      clinicalReason: decision.reason\n    };\n    \n    const result = await patientService.createOrder(orderData);\n    return { success: true, orderId: result.id };\n  };\n\n  /**\n   * Execute a prescription\n   */\n  const executePrescription = async (decision) => {\n    // Check for drug interactions\n    const interactions = await checkDrugInteractions(decision.medication);\n    \n    if (interactions.severe.length > 0) {\n      return { success: false, reason: 'Severe drug interaction detected' };\n    }\n    \n    const prescriptionData = {\n      patientId,\n      medication: decision.medication,\n      dosage: decision.dosage,\n      frequency: decision.frequency,\n      duration: decision.duration,\n      instructions: decision.instructions\n    };\n    \n    const result = await patientService.createPrescription(prescriptionData);\n    return { success: true, prescriptionId: result.id };\n  };\n\n  /**\n   * Manual decision override\n   */\n  const handleManualDecision = async (decision, action) => {\n    if (action === 'accept') {\n      await executeDecision(decision);\n    } else if (action === 'reject') {\n      // Remove from queue\n      const index = decisionQueueRef.current.indexOf(decision);\n      if (index > -1) {\n        decisionQueueRef.current.splice(index, 1);\n        updateCurrentDecisions();\n      }\n    } else if (action === 'modify') {\n      // Open modification dialog (to be implemented)\n      console.log('Modify decision:', decision);\n      // Future: openDecisionEditor(decision);\n    }\n  };\n\n  /**\n   * Update workflow step status\n   */\n  const updateWorkflowStep = (stepId, status) => {\n    setWorkflowSteps(prev => prev.map(step => \n      step.id === stepId ? { ...step, status, completed: status === 'completed' } : step\n    ));\n  };\n\n  /**\n   * Suggest diagnostic tests\n   */\n  const suggestDiagnosticTests = async (predictions) => {\n    const tests = [];\n    \n    if (predictions['24h'].cardiac.probability > 0.5) {\n      tests.push('Troponin', 'ECG', 'Echocardiogram');\n    }\n    \n    if (predictions['24h'].sepsis.probability > 0.5) {\n      tests.push('Blood Culture', 'Lactate', 'Procalcitonin');\n    }\n    \n    if (predictions['24h'].aki.probability > 0.5) {\n      tests.push('Creatinine', 'BUN', 'Urinalysis');\n    }\n    \n    return tests;\n  };\n\n  /**\n   * Check drug interactions\n   */\n  const checkDrugInteractions = async (medication) => {\n    // This would connect to a drug interaction database\n    return {\n      severe: [],\n      moderate: [],\n      minor: []\n    };\n  };\n\n  /**\n   * Shutdown autopilot\n   */\n  const shutdownAutopilot = () => {\n    setAutopilotState('inactive');\n    ambientIntelligence.stopListening();\n  };\n\n  if (!isActive) return null;\n\n  return (\n    <AutopilotContainer>\n      <AutopilotHeader direction=\"row\" justify=\"between\" align=\"center\">\n        <Box direction=\"row\" align=\"center\" gap=\"small\">\n          <Robot color=\"white\" size=\"medium\" />\n          <Heading level={4} margin=\"none\" color=\"white\">\n            Clinical Autopilot\n          </Heading>\n        </Box>\n        <Box direction=\"row\" align=\"center\" gap=\"small\">\n          <StatusIndicator status={autopilotState}>\n            {autopilotState === 'active' ? <StatusGood color=\"green\" /> : <StatusWarning color=\"yellow\" />}\n            <Text size=\"small\" color=\"white\">\n              {autopilotState === 'active' ? 'Active' : 'Initializing'}\n            </Text>\n          </StatusIndicator>\n          <Button\n            icon={<Close />}\n            onClick={onToggle}\n            plain\n            style={{ padding: '4px' }}\n          />\n        </Box>\n      </AutopilotHeader>\n\n      <Box pad=\"medium\" gap=\"small\" overflow=\"auto\" height={{ max: 'calc(100vh - 200px)' }}>\n        {/* Confidence Score */}\n        <ConfidenceMeter>\n          <Text size=\"small\" color=\"white\">Confidence</Text>\n          <Box flex>\n            <Meter\n              type=\"bar\"\n              value={confidenceScore}\n              max={1}\n              size=\"small\"\n              thickness=\"xsmall\"\n              color={confidenceScore > 0.8 ? 'status-ok' : 'status-warning'}\n            />\n          </Box>\n          <Text size=\"small\" color=\"white\" weight=\"bold\">\n            {(confidenceScore * 100).toFixed(0)}%\n          </Text>\n        </ConfidenceMeter>\n\n        {/* Clinical Insights */}\n        {clinicalInsights.length > 0 && (\n          <Box gap=\"small\">\n            <Text size=\"small\" color=\"white\" weight=\"bold\">Clinical Insights</Text>\n            {clinicalInsights.map((insight, index) => (\n              <DecisionCard key={index}>\n                <Box gap=\"small\">\n                  <Box direction=\"row\" align=\"center\" gap=\"small\">\n                    <InsightBadge type={insight.type}>\n                      {insight.type}\n                    </InsightBadge>\n                    <Text size=\"small\" weight=\"bold\" color=\"white\">\n                      {insight.title}\n                    </Text>\n                  </Box>\n                  <Text size=\"small\" color=\"light-2\">\n                    {insight.description}\n                  </Text>\n                  <ActionButton\n                    size=\"small\"\n                    priority={insight.priority}\n                    label={insight.action}\n                    onClick={() => handleManualDecision(insight, 'accept')}\n                  />\n                </Box>\n              </DecisionCard>\n            ))}\n          </Box>\n        )}\n\n        {/* Current Decisions */}\n        {currentDecisions.length > 0 && (\n          <Box gap=\"small\">\n            <Text size=\"small\" color=\"white\" weight=\"bold\">Pending Decisions</Text>\n            {currentDecisions.map((decision, index) => (\n              <DecisionCard key={index}>\n                <Box gap=\"small\">\n                  <Text size=\"small\" weight=\"bold\" color=\"white\">\n                    {decision.title}\n                  </Text>\n                  <Box direction=\"row\" gap=\"small\">\n                    <Button\n                      size=\"small\"\n                      label=\"Accept\"\n                      onClick={() => handleManualDecision(decision, 'accept')}\n                      color=\"status-ok\"\n                    />\n                    <Button\n                      size=\"small\"\n                      label=\"Modify\"\n                      onClick={() => handleManualDecision(decision, 'modify')}\n                    />\n                    <Button\n                      size=\"small\"\n                      label=\"Reject\"\n                      onClick={() => handleManualDecision(decision, 'reject')}\n                      color=\"status-critical\"\n                    />\n                  </Box>\n                </Box>\n              </DecisionCard>\n            ))}\n          </Box>\n        )}\n\n        {/* Workflow Timeline */}\n        <Box gap=\"small\">\n          <Text size=\"small\" color=\"white\" weight=\"bold\">Workflow Progress</Text>\n          <Box>\n            {workflowSteps.map((step, index) => (\n              <TimelineItem key={step.id} completed={step.completed}>\n                <Box gap=\"xsmall\">\n                  <Box direction=\"row\" align=\"center\" gap=\"small\">\n                    <Text size=\"small\" weight=\"bold\" color=\"white\">\n                      {step.title}\n                    </Text>\n                    <Text size=\"xsmall\" color=\"light-3\">\n                      {step.duration}\n                    </Text>\n                  </Box>\n                  {step.autoActions && (\n                    <Box gap=\"xxsmall\">\n                      {step.autoActions.map((action, i) => (\n                        <Text key={i} size=\"xsmall\" color=\"light-4\">\n                          • {action}\n                        </Text>\n                      ))}\n                    </Box>\n                  )}\n                </Box>\n              </TimelineItem>\n            ))}\n          </Box>\n        </Box>\n\n        {/* Executed Actions Log */}\n        {executedActions.length > 0 && (\n          <Box gap=\"small\">\n            <Text size=\"small\" color=\"white\" weight=\"bold\">Executed Actions</Text>\n            <Box gap=\"xsmall\">\n              {executedActions.slice(-3).map((action, index) => (\n                <Box key={index} direction=\"row\" align=\"center\" gap=\"small\">\n                  <Checkmark color=\"status-ok\" size=\"small\" />\n                  <Text size=\"xsmall\" color=\"light-3\">\n                    {action.title} - {new Date(action.executedAt).toLocaleTimeString()}\n                  </Text>\n                </Box>\n              ))}\n            </Box>\n          </Box>\n        )}\n      </Box>\n    </AutopilotContainer>\n  );\n};\n\nexport default ClinicalAutopilot;","C:\\Users\\Ajdurden8\\Documents\\GitHub\\physician-dashboard-upgraded\\new-directory-name\\src\\components\\dashboard\\RevolutionaryDashboard.js",["414","415","416","417","418","419","420","421"],"/**\n * Revolutionary Dashboard Integration\n * Industry-altering healthcare platform with unprecedented AI capabilities\n * This component orchestrates all revolutionary features into a cohesive experience\n */\n\nimport React, { useState, useEffect, useRef } from 'react';\nimport { Box, Layer, Button, Text, Heading, Meter, Card, Notification } from 'grommet';\nimport { StatusGood, StatusWarning, StatusCritical, Robot, Analytics, TestDesktop, Alert } from 'grommet-icons';\nimport styled, { keyframes } from 'styled-components';\nimport ClinicalAutopilot from './ClinicalAutopilot';\nimport ambientIntelligence from '../../services/ambientIntelligence';\nimport predictiveAnalytics from '../../services/predictiveAnalytics';\nimport clinicalTrialsMatching from '../../services/clinicalTrialsMatching';\nimport patientService from '../../services/patientService';\n\nconst glow = keyframes`\n  0% { box-shadow: 0 0 5px rgba(0, 255, 255, 0.5); }\n  50% { box-shadow: 0 0 20px rgba(0, 255, 255, 0.8), 0 0 30px rgba(0, 255, 255, 0.6); }\n  100% { box-shadow: 0 0 5px rgba(0, 255, 255, 0.5); }\n`;\n\nconst DashboardContainer = styled(Box)`\n  position: relative;\n  min-height: 100vh;\n  background: linear-gradient(135deg, #0a0a0a 0%, #1a1a2e 50%, #0a0a0a 100%);\n  overflow: hidden;\n  \n  &::before {\n    content: '';\n    position: absolute;\n    top: 0;\n    left: 0;\n    right: 0;\n    bottom: 0;\n    background: \n      radial-gradient(circle at 20% 50%, rgba(0, 255, 255, 0.1) 0%, transparent 50%),\n      radial-gradient(circle at 80% 50%, rgba(255, 0, 255, 0.1) 0%, transparent 50%),\n      radial-gradient(circle at 50% 100%, rgba(0, 255, 0, 0.1) 0%, transparent 50%);\n    pointer-events: none;\n  }\n`;\n\nconst AIStatusBar = styled(Box)`\n  position: fixed;\n  top: 0;\n  left: 0;\n  right: 0;\n  height: 60px;\n  background: rgba(0, 0, 0, 0.9);\n  backdrop-filter: blur(10px);\n  border-bottom: 2px solid rgba(0, 255, 255, 0.3);\n  z-index: 1000;\n  padding: 0 20px;\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  animation: ${glow} 3s infinite;\n`;\n\nconst StatusIndicator = styled(Box)`\n  display: flex;\n  align-items: center;\n  gap: 15px;\n  padding: 8px 16px;\n  background: rgba(0, 255, 255, 0.1);\n  border: 1px solid rgba(0, 255, 255, 0.3);\n  border-radius: 25px;\n`;\n\nconst PredictivePanel = styled(Box)`\n  position: fixed;\n  left: 20px;\n  top: 80px;\n  width: 350px;\n  max-height: calc(100vh - 100px);\n  background: rgba(0, 0, 0, 0.8);\n  backdrop-filter: blur(10px);\n  border: 1px solid rgba(0, 255, 255, 0.3);\n  border-radius: 15px;\n  padding: 20px;\n  overflow-y: auto;\n`;\n\nconst RiskMeter = styled(Box)`\n  padding: 15px;\n  background: rgba(255, 255, 255, 0.05);\n  border-radius: 10px;\n  margin: 10px 0;\n`;\n\nconst ClinicalAlert = styled(Card)`\n  background: ${props => {\n    switch(props.severity) {\n      case 'critical': return 'rgba(239, 68, 68, 0.2)';\n      case 'high': return 'rgba(245, 158, 11, 0.2)';\n      case 'medium': return 'rgba(59, 130, 246, 0.2)';\n      default: return 'rgba(107, 114, 128, 0.2)';\n    }\n  }};\n  border: 1px solid ${props => {\n    switch(props.severity) {\n      case 'critical': return 'rgba(239, 68, 68, 0.5)';\n      case 'high': return 'rgba(245, 158, 11, 0.5)';\n      case 'medium': return 'rgba(59, 130, 246, 0.5)';\n      default: return 'rgba(107, 114, 128, 0.5)';\n    }\n  }};\n  border-radius: 10px;\n  padding: 15px;\n  margin: 10px 0;\n`;\n\nconst DigitalTwinVisualization = styled(Box)`\n  position: relative;\n  width: 100%;\n  height: 200px;\n  background: linear-gradient(180deg, rgba(0, 255, 255, 0.1) 0%, transparent 100%);\n  border-radius: 10px;\n  padding: 15px;\n  margin: 15px 0;\n`;\n\nconst TrialMatchCard = styled(Card)`\n  background: rgba(147, 51, 234, 0.1);\n  border: 1px solid rgba(147, 51, 234, 0.3);\n  border-radius: 10px;\n  padding: 15px;\n  margin: 10px 0;\n  cursor: pointer;\n  transition: all 0.3s ease;\n  \n  &:hover {\n    background: rgba(147, 51, 234, 0.2);\n    transform: translateY(-2px);\n    box-shadow: 0 5px 15px rgba(147, 51, 234, 0.3);\n  }\n`;\n\nconst RevolutionaryDashboard = ({ patient, onClose }) => {\n  const [aiSystems, setAiSystems] = useState({\n    ambient: 'initializing',\n    predictive: 'initializing',\n    autopilot: 'initializing',\n    trials: 'initializing'\n  });\n  \n  const [predictions, setPredictions] = useState(null);\n  const [digitalTwin, setDigitalTwin] = useState(null);\n  const [clinicalAlerts, setClinicalAlerts] = useState([]);\n  const [trialMatches, setTrialMatches] = useState([]);\n  const [documentation, setDocumentation] = useState(null);\n  const [isAutopilotActive, setIsAutopilotActive] = useState(false);\n  const [ambientListening, setAmbientListening] = useState(false);\n  \n  const alertsRef = useRef([]);\n  const notificationTimeout = useRef(null);\n\n  useEffect(() => {\n    if (patient) {\n      initializeRevolutionaryFeatures();\n    }\n\n    return () => {\n      cleanup();\n    };\n  }, [patient]);\n\n  /**\n   * Initialize all revolutionary features\n   */\n  const initializeRevolutionaryFeatures = async () => {\n    try {\n      // Initialize Ambient Intelligence\n      const ambientStatus = await ambientIntelligence.initialize(patient.id);\n      setAiSystems(prev => ({ ...prev, ambient: 'active' }));\n      \n      // Initialize Predictive Analytics & Digital Twin\n      await predictiveAnalytics.initialize();\n      const twin = await predictiveAnalytics.createPatientDigitalTwin(patient.id, patient);\n      setDigitalTwin(twin);\n      setPredictions(twin.predictions);\n      setAiSystems(prev => ({ ...prev, predictive: 'active' }));\n      \n      // Initialize Clinical Trials Matching\n      await clinicalTrialsMatching.initialize();\n      const matches = await clinicalTrialsMatching.matchPatientToTrials(patient);\n      setTrialMatches(matches.slice(0, 3));\n      setAiSystems(prev => ({ ...prev, trials: 'active' }));\n      \n      // Setup event listeners\n      setupEventListeners();\n      \n      // Auto-activate autopilot for high-risk patients\n      if (twin.predictions.compositeRisk.score > 0.7) {\n        setIsAutopilotActive(true);\n        setAiSystems(prev => ({ ...prev, autopilot: 'active' }));\n      }\n      \n    } catch (error) {\n      console.error('Failed to initialize revolutionary features:', error);\n    }\n  };\n\n  /**\n   * Setup event listeners for real-time updates\n   */\n  const setupEventListeners = () => {\n    // Ambient Intelligence updates\n    window.addEventListener('ambient-intelligence-update', handleAmbientUpdate);\n    \n    // Predictive alerts\n    window.addEventListener('predictive-alert', handlePredictiveAlert);\n    \n    // Clinical alerts\n    window.addEventListener('clinical-alert', handleClinicalAlert);\n    \n    // Trial matches\n    window.addEventListener('trial-matches-found', handleTrialMatches);\n  };\n\n  /**\n   * Handle ambient intelligence updates\n   */\n  const handleAmbientUpdate = (event) => {\n    const { type, data } = event.detail;\n    \n    if (type === 'documentation_ready') {\n      setDocumentation(data);\n      showNotification('Documentation auto-generated', 'success');\n    } else if (type === 'decisions_available') {\n      // Decisions are handled by autopilot\n    }\n  };\n\n  /**\n   * Handle predictive alerts\n   */\n  const handlePredictiveAlert = (event) => {\n    const { alerts } = event.detail;\n    \n    const newAlerts = alerts.map(alert => ({\n      ...alert,\n      id: Date.now() + Math.random(),\n      timestamp: new Date().toISOString()\n    }));\n    \n    setClinicalAlerts(prev => [...newAlerts, ...prev].slice(0, 5));\n    \n    // Show notification for critical alerts\n    const critical = alerts.find(a => a.severity === 'critical');\n    if (critical) {\n      showNotification(critical.message, 'critical');\n    }\n  };\n\n  /**\n   * Handle clinical alerts\n   */\n  const handleClinicalAlert = (event) => {\n    const alert = event.detail;\n    \n    setClinicalAlerts(prev => [{\n      ...alert,\n      id: Date.now() + Math.random()\n    }, ...prev].slice(0, 5));\n  };\n\n  /**\n   * Handle new trial matches\n   */\n  const handleTrialMatches = (event) => {\n    const { matches } = event.detail;\n    setTrialMatches(matches);\n    \n    if (matches.length > 0) {\n      showNotification(`${matches.length} new clinical trial matches found`, 'info');\n    }\n  };\n\n  /**\n   * Show notification\n   */\n  const showNotification = (message, status = 'info') => {\n    const notification = {\n      message,\n      status,\n      id: Date.now()\n    };\n    \n    // Use Grommet notification or custom implementation\n    console.log('Notification:', notification);\n  };\n\n  /**\n   * Toggle ambient listening\n   */\n  const toggleAmbientListening = () => {\n    if (ambientListening) {\n      ambientIntelligence.stopListening();\n      setAmbientListening(false);\n    } else {\n      ambientIntelligence.startProcessingPipeline();\n      setAmbientListening(true);\n      showNotification('Ambient listening activated', 'success');\n    }\n  };\n\n  /**\n   * Toggle autopilot\n   */\n  const toggleAutopilot = () => {\n    setIsAutopilotActive(prev => !prev);\n    setAiSystems(prev => ({ \n      ...prev, \n      autopilot: !isAutopilotActive ? 'active' : 'inactive' \n    }));\n  };\n\n  /**\n   * Accept documentation\n   */\n  const acceptDocumentation = async () => {\n    if (documentation) {\n      // Save documentation to patient record\n      await patientService.saveConsultationNote(patient.id, documentation);\n      showNotification('Documentation saved successfully', 'success');\n      setDocumentation(null);\n    }\n  };\n\n  /**\n   * Cleanup on unmount\n   */\n  const cleanup = () => {\n    window.removeEventListener('ambient-intelligence-update', handleAmbientUpdate);\n    window.removeEventListener('predictive-alert', handlePredictiveAlert);\n    window.removeEventListener('clinical-alert', handleClinicalAlert);\n    window.removeEventListener('trial-matches-found', handleTrialMatches);\n    \n    if (ambientListening) {\n      ambientIntelligence.stopListening();\n    }\n  };\n\n  return (\n    <DashboardContainer>\n      {/* AI Status Bar */}\n      <AIStatusBar>\n        <Box direction=\"row\" align=\"center\" gap=\"small\">\n          <Robot size=\"medium\" color=\"cyan\" />\n          <Heading level={4} margin=\"none\" color=\"white\">\n            Agama Health AI Command Center\n          </Heading>\n        </Box>\n        \n        <Box direction=\"row\" gap=\"medium\">\n          <StatusIndicator>\n            <Text size=\"small\" color=\"white\">Ambient AI</Text>\n            {aiSystems.ambient === 'active' ? \n              <StatusGood color=\"status-ok\" /> : \n              <StatusWarning color=\"status-warning\" />\n            }\n          </StatusIndicator>\n          \n          <StatusIndicator>\n            <Text size=\"small\" color=\"white\">Predictive Engine</Text>\n            {aiSystems.predictive === 'active' ? \n              <StatusGood color=\"status-ok\" /> : \n              <StatusWarning color=\"status-warning\" />\n            }\n          </StatusIndicator>\n          \n          <StatusIndicator>\n            <Text size=\"small\" color=\"white\">Autopilot</Text>\n            {aiSystems.autopilot === 'active' ? \n              <StatusGood color=\"status-ok\" /> : \n              <StatusWarning color=\"status-warning\" />\n            }\n          </StatusIndicator>\n          \n          <Button\n            label={ambientListening ? \"Stop Listening\" : \"Start Ambient AI\"}\n            onClick={toggleAmbientListening}\n            primary\n            color={ambientListening ? \"status-critical\" : \"status-ok\"}\n          />\n        </Box>\n      </AIStatusBar>\n\n      {/* Predictive Analytics Panel */}\n      <PredictivePanel>\n        <Heading level={4} margin={{ bottom: 'small' }} color=\"white\">\n          Predictive Analytics\n        </Heading>\n        \n        {/* Risk Assessment */}\n        {predictions && (\n          <RiskMeter>\n            <Text size=\"small\" color=\"white\" weight=\"bold\">\n              Composite Risk Score\n            </Text>\n            <Meter\n              type=\"circle\"\n              value={predictions.compositeRisk.score}\n              max={1}\n              size=\"small\"\n              thickness=\"medium\"\n              color={predictions.compositeRisk.score > 0.7 ? 'status-critical' : \n                     predictions.compositeRisk.score > 0.5 ? 'status-warning' : 'status-ok'}\n            />\n            <Text size=\"small\" color=\"light-3\">\n              {predictions.compositeRisk.primaryRisk} - {(predictions.compositeRisk.score * 100).toFixed(0)}%\n            </Text>\n          </RiskMeter>\n        )}\n\n        {/* Digital Twin Visualization */}\n        {digitalTwin && (\n          <DigitalTwinVisualization>\n            <Text size=\"small\" color=\"white\" weight=\"bold\">\n              Digital Twin Status\n            </Text>\n            <Box pad=\"small\">\n              <Text size=\"xsmall\" color=\"cyan\">\n                Physiology: Simulated\n              </Text>\n              <Text size=\"xsmall\" color=\"cyan\">\n                Predictions: Active\n              </Text>\n              <Text size=\"xsmall\" color=\"cyan\">\n                Treatment Simulations: 3 Available\n              </Text>\n            </Box>\n          </DigitalTwinVisualization>\n        )}\n\n        {/* Clinical Alerts */}\n        <Box margin={{ top: 'medium' }}>\n          <Text size=\"small\" color=\"white\" weight=\"bold\">\n            Clinical Alerts\n          </Text>\n          {clinicalAlerts.map(alert => (\n            <ClinicalAlert key={alert.id} severity={alert.severity}>\n              <Box gap=\"xsmall\">\n                <Box direction=\"row\" align=\"center\" gap=\"small\">\n                  <Alert size=\"small\" color={\n                    alert.severity === 'critical' ? 'status-critical' :\n                    alert.severity === 'high' ? 'status-warning' : 'status-unknown'\n                  } />\n                  <Text size=\"small\" weight=\"bold\" color=\"white\">\n                    {alert.condition || alert.type}\n                  </Text>\n                </Box>\n                <Text size=\"xsmall\" color=\"light-3\">\n                  {alert.message}\n                </Text>\n                {alert.actions && alert.actions.length > 0 && (\n                  <Box margin={{ top: 'xsmall' }}>\n                    {alert.actions.slice(0, 2).map((action, i) => (\n                      <Text key={i} size=\"xsmall\" color=\"cyan\">\n                        • {action}\n                      </Text>\n                    ))}\n                  </Box>\n                )}\n              </Box>\n            </ClinicalAlert>\n          ))}\n        </Box>\n\n        {/* Clinical Trials */}\n        {trialMatches.length > 0 && (\n          <Box margin={{ top: 'medium' }}>\n            <Text size=\"small\" color=\"white\" weight=\"bold\">\n              Clinical Trial Matches\n            </Text>\n            {trialMatches.map((match, index) => (\n              <TrialMatchCard key={index}>\n                <Box gap=\"xsmall\">\n                  <Text size=\"small\" weight=\"bold\" color=\"white\">\n                    {match.trial.title}\n                  </Text>\n                  <Box direction=\"row\" gap=\"small\">\n                    <Text size=\"xsmall\" color=\"light-3\">\n                      Match: {(match.matchScore * 100).toFixed(0)}%\n                    </Text>\n                    <Text size=\"xsmall\" color=\"light-3\">\n                      Phase: {match.trial.phase}\n                    </Text>\n                  </Box>\n                  <Text size=\"xsmall\" color=\"cyan\">\n                    {match.trial.sponsor}\n                  </Text>\n                </Box>\n              </TrialMatchCard>\n            ))}\n          </Box>\n        )}\n      </PredictivePanel>\n\n      {/* Clinical Autopilot */}\n      <ClinicalAutopilot\n        patientId={patient?.id}\n        isActive={isAutopilotActive}\n        onToggle={toggleAutopilot}\n      />\n\n      {/* Auto-generated Documentation Layer */}\n      {documentation && (\n        <Layer\n          position=\"center\"\n          onClickOutside={() => setDocumentation(null)}\n        >\n          <Box pad=\"large\" gap=\"medium\" width=\"large\" background=\"dark-1\">\n            <Heading level={3}>Auto-Generated Documentation</Heading>\n            \n            <Box gap=\"small\">\n              <Box>\n                <Text weight=\"bold\">Subjective:</Text>\n                <Text>{documentation.subjective}</Text>\n              </Box>\n              \n              <Box>\n                <Text weight=\"bold\">Objective:</Text>\n                <Text>{documentation.objective}</Text>\n              </Box>\n              \n              <Box>\n                <Text weight=\"bold\">Assessment:</Text>\n                <Text>{documentation.assessment}</Text>\n              </Box>\n              \n              <Box>\n                <Text weight=\"bold\">Plan:</Text>\n                <Text>{documentation.plan}</Text>\n              </Box>\n              \n              <Box>\n                <Text weight=\"bold\">ICD-10 Codes:</Text>\n                <Text>{documentation.icd10Codes?.join(', ')}</Text>\n              </Box>\n            </Box>\n            \n            <Box direction=\"row\" gap=\"medium\" justify=\"end\">\n              <Button label=\"Edit\" onClick={() => {/* Open editor */}} />\n              <Button label=\"Accept\" primary onClick={acceptDocumentation} />\n            </Box>\n          </Box>\n        </Layer>\n      )}\n    </DashboardContainer>\n  );\n};\n\nexport default RevolutionaryDashboard;","C:\\Users\\Ajdurden8\\Documents\\GitHub\\physician-dashboard-upgraded\\new-directory-name\\src\\services\\ambientIntelligence.js",[],"C:\\Users\\Ajdurden8\\Documents\\GitHub\\physician-dashboard-upgraded\\new-directory-name\\src\\services\\predictiveAnalytics.js",[],"C:\\Users\\Ajdurden8\\Documents\\GitHub\\physician-dashboard-upgraded\\new-directory-name\\src\\services\\clinicalTrialsMatching.js",["422","423"],"/**\n * Real-Time Clinical Trials Matching Engine\n * Revolutionary system that automatically matches patients to clinical trials globally\n * Industry-first implementation with AI-powered eligibility assessment\n */\n\nclass ClinicalTrialsMatchingEngine {\n  constructor() {\n    this.trialsDatabase = new Map();\n    this.matchingQueue = [];\n    this.eligibilityCache = new Map();\n    this.monitoringInterval = null;\n  }\n\n  /**\n   * Initialize the clinical trials matching system\n   */\n  async initialize() {\n    // Load active clinical trials from multiple sources\n    await this.loadClinicalTrials();\n    \n    // Start real-time monitoring\n    this.startMonitoring();\n    \n    return {\n      status: 'active',\n      trials: this.trialsDatabase.size,\n      sources: ['ClinicalTrials.gov', 'WHO ICTRP', 'EU Clinical Trials', 'Industry Sponsors']\n    };\n  }\n\n  /**\n   * Load clinical trials from multiple registries\n   */\n  async loadClinicalTrials() {\n    const sources = [\n      { name: 'ClinicalTrials.gov', url: 'https://clinicaltrials.gov/api/v2/studies' },\n      { name: 'WHO ICTRP', url: 'https://trialsearch.who.int/api' },\n      { name: 'Industry Sponsors', url: 'https://api.agamahealth.ai/trials' }\n    ];\n\n    for (const source of sources) {\n      try {\n        const trials = await this.fetchTrialsFromSource(source);\n        for (const trial of trials) {\n          this.trialsDatabase.set(trial.id, {\n            ...trial,\n            source: source.name,\n            loadedAt: new Date().toISOString()\n          });\n        }\n      } catch (error) {\n        console.error(`Failed to load trials from ${source.name}:`, error);\n      }\n    }\n  }\n\n  /**\n   * Match patient to clinical trials\n   */\n  async matchPatientToTrials(patientData) {\n    const matches = [];\n    const patientProfile = await this.createPatientProfile(patientData);\n    \n    // Iterate through all trials\n    for (const [trialId, trial] of this.trialsDatabase) {\n      const eligibility = await this.assessEligibility(patientProfile, trial);\n      \n      if (eligibility.isEligible) {\n        matches.push({\n          trial: trial,\n          matchScore: eligibility.score,\n          confidence: eligibility.confidence,\n          criteria: eligibility.matchedCriteria,\n          exclusions: eligibility.exclusions,\n          benefits: this.assessTrialBenefits(trial, patientProfile),\n          risks: this.assessTrialRisks(trial, patientProfile),\n          logistics: this.assessLogistics(trial, patientData.location)\n        });\n      }\n    }\n    \n    // Sort by match score and relevance\n    matches.sort((a, b) => b.matchScore - a.matchScore);\n    \n    // Cache results\n    this.eligibilityCache.set(patientData.id, {\n      matches,\n      timestamp: new Date().toISOString()\n    });\n    \n    return matches;\n  }\n\n  /**\n   * Create comprehensive patient profile for matching\n   */\n  async createPatientProfile(patientData) {\n    return {\n      demographics: {\n        age: this.calculateAge(patientData.dateOfBirth),\n        gender: patientData.gender,\n        race: patientData.race,\n        ethnicity: patientData.ethnicity\n      },\n      medical: {\n        diagnoses: patientData.activeProblems?.map(p => ({\n          condition: p.name,\n          icd10: p.icd10,\n          onset: p.diagnosedDate,\n          severity: p.severity\n        })),\n        medications: patientData.medications?.map(m => ({\n          name: m.name,\n          dose: m.dosage,\n          startDate: m.startDate\n        })),\n        allergies: patientData.allergies,\n        labResults: this.extractRelevantLabs(patientData.labs),\n        vitals: patientData.vitals,\n        procedures: patientData.procedures?.map(p => ({\n          name: p.name,\n          date: p.date\n        }))\n      },\n      genomics: {\n        mutations: patientData.genomicData?.mutations || [],\n        biomarkers: patientData.genomicData?.biomarkers || []\n      },\n      functional: {\n        performanceStatus: patientData.ecog || patientData.karnofsky,\n        organFunction: {\n          cardiac: this.assessCardiacFunction(patientData),\n          hepatic: this.assessHepaticFunction(patientData),\n          renal: this.assessRenalFunction(patientData)\n        }\n      },\n      preferences: {\n        willingToTravel: patientData.preferences?.travel || false,\n        maxTravelDistance: patientData.preferences?.maxDistance || 50,\n        preferredLanguage: patientData.language || 'English'\n      }\n    };\n  }\n\n  /**\n   * Assess patient eligibility for a specific trial using AI\n   */\n  async assessEligibility(patientProfile, trial) {\n    const inclusionResults = await this.checkInclusionCriteria(patientProfile, trial.inclusionCriteria);\n    const exclusionResults = await this.checkExclusionCriteria(patientProfile, trial.exclusionCriteria);\n    \n    // Use NLP to parse complex criteria\n    const nlpAssessment = await this.performNLPEligibilityCheck(patientProfile, trial.eligibilityText);\n    \n    // Calculate overall eligibility\n    const isEligible = inclusionResults.allMet && !exclusionResults.anyMet;\n    const score = this.calculateMatchScore(inclusionResults, exclusionResults, nlpAssessment);\n    \n    return {\n      isEligible,\n      score,\n      confidence: nlpAssessment.confidence,\n      matchedCriteria: inclusionResults.matched,\n      unmatchedCriteria: inclusionResults.unmatched,\n      exclusions: exclusionResults.matched,\n      details: {\n        inclusion: inclusionResults,\n        exclusion: exclusionResults,\n        nlp: nlpAssessment\n      }\n    };\n  }\n\n  /**\n   * Check inclusion criteria\n   */\n  async checkInclusionCriteria(profile, criteria) {\n    const results = {\n      matched: [],\n      unmatched: [],\n      uncertain: [],\n      allMet: true\n    };\n    \n    for (const criterion of criteria || []) {\n      const check = await this.evaluateCriterion(profile, criterion);\n      \n      if (check.met) {\n        results.matched.push({ ...criterion, reason: check.reason });\n      } else if (check.uncertain) {\n        results.uncertain.push({ ...criterion, reason: check.reason });\n      } else {\n        results.unmatched.push({ ...criterion, reason: check.reason });\n        results.allMet = false;\n      }\n    }\n    \n    return results;\n  }\n\n  /**\n   * Check exclusion criteria\n   */\n  async checkExclusionCriteria(profile, criteria) {\n    const results = {\n      matched: [],\n      unmatched: [],\n      uncertain: [],\n      anyMet: false\n    };\n    \n    for (const criterion of criteria || []) {\n      const check = await this.evaluateCriterion(profile, criterion);\n      \n      if (check.met) {\n        results.matched.push({ ...criterion, reason: check.reason });\n        results.anyMet = true;\n      } else if (check.uncertain) {\n        results.uncertain.push({ ...criterion, reason: check.reason });\n      } else {\n        results.unmatched.push({ ...criterion, reason: check.reason });\n      }\n    }\n    \n    return results;\n  }\n\n  /**\n   * Evaluate a single criterion\n   */\n  async evaluateCriterion(profile, criterion) {\n    // Parse criterion type\n    switch (criterion.type) {\n      case 'age':\n        return this.evaluateAgeCriterion(profile.demographics.age, criterion);\n      \n      case 'diagnosis':\n        return this.evaluateDiagnosisCriterion(profile.medical.diagnoses, criterion);\n      \n      case 'lab':\n        return this.evaluateLabCriterion(profile.medical.labResults, criterion);\n      \n      case 'medication':\n        return this.evaluateMedicationCriterion(profile.medical.medications, criterion);\n      \n      case 'genomic':\n        return this.evaluateGenomicCriterion(profile.genomics, criterion);\n      \n      case 'performance':\n        return this.evaluatePerformanceCriterion(profile.functional.performanceStatus, criterion);\n      \n      default:\n        // Use NLP for complex text criteria\n        return await this.evaluateTextCriterion(profile, criterion);\n    }\n  }\n\n  /**\n   * Use NLP to check eligibility from free text\n   */\n  async performNLPEligibilityCheck(profile, eligibilityText) {\n    if (!eligibilityText) {\n      return { eligible: true, confidence: 0.5, reasons: [] };\n    }\n    \n    try {\n      const response = await fetch('https://api.agamahealth.ai/v2/trial-eligibility', {\n        method: 'POST',\n        headers: {\n          'Content-Type': 'application/json',\n          'Authorization': `Bearer ${process.env.REACT_APP_TRIALS_API_KEY}`\n        },\n        body: JSON.stringify({\n          patientProfile: profile,\n          eligibilityText: eligibilityText,\n          model: 'clinical-trials-v2'\n        })\n      });\n      \n      const result = await response.json();\n      \n      return {\n        eligible: result.eligible,\n        confidence: result.confidence,\n        reasons: result.reasons,\n        concerns: result.concerns\n      };\n    } catch (error) {\n      console.error('NLP eligibility check failed:', error);\n      return { eligible: false, confidence: 0, reasons: ['Unable to assess'] };\n    }\n  }\n\n  /**\n   * Calculate match score\n   */\n  calculateMatchScore(inclusion, exclusion, nlp) {\n    let score = 0;\n    \n    // Inclusion criteria weight: 40%\n    const inclusionScore = (inclusion.matched.length / (inclusion.matched.length + inclusion.unmatched.length || 1)) * 0.4;\n    \n    // Exclusion criteria weight: 30%\n    const exclusionScore = (1 - (exclusion.matched.length / (exclusion.matched.length + exclusion.unmatched.length || 1))) * 0.3;\n    \n    // NLP confidence weight: 20%\n    const nlpScore = (nlp.confidence || 0) * 0.2;\n    \n    // Uncertainty penalty: 10%\n    const uncertaintyPenalty = ((inclusion.uncertain.length + exclusion.uncertain.length) / 10) * 0.1;\n    \n    score = inclusionScore + exclusionScore + nlpScore - uncertaintyPenalty;\n    \n    return Math.max(0, Math.min(1, score));\n  }\n\n  /**\n   * Assess potential benefits of trial participation\n   */\n  assessTrialBenefits(trial, profile) {\n    const benefits = [];\n    \n    // Access to novel treatments\n    if (trial.phase === 'Phase 3' || trial.phase === 'Phase 2') {\n      benefits.push({\n        type: 'novel_treatment',\n        description: 'Access to cutting-edge therapy not yet available',\n        impact: 'high'\n      });\n    }\n    \n    // Enhanced monitoring\n    benefits.push({\n      type: 'enhanced_care',\n      description: 'Frequent monitoring and medical attention',\n      impact: 'medium'\n    });\n    \n    // Cost coverage\n    if (trial.costCoverage) {\n      benefits.push({\n        type: 'financial',\n        description: 'Study-related medical costs covered',\n        impact: 'high'\n      });\n    }\n    \n    // Contributing to science\n    benefits.push({\n      type: 'contribution',\n      description: 'Help advance medical knowledge',\n      impact: 'medium'\n    });\n    \n    return benefits;\n  }\n\n  /**\n   * Assess potential risks of trial participation\n   */\n  assessTrialRisks(trial, profile) {\n    const risks = [];\n    \n    // Side effects\n    if (trial.knownSideEffects) {\n      risks.push({\n        type: 'side_effects',\n        description: trial.knownSideEffects,\n        severity: trial.sideEffectSeverity || 'unknown'\n      });\n    }\n    \n    // Time commitment\n    risks.push({\n      type: 'time',\n      description: `${trial.visitFrequency || 'Regular'} visits required`,\n      severity: 'low'\n    });\n    \n    // Placebo possibility\n    if (trial.hasPlacebo) {\n      risks.push({\n        type: 'placebo',\n        description: `${trial.placeboRatio || '50'}% chance of receiving placebo`,\n        severity: 'medium'\n      });\n    }\n    \n    return risks;\n  }\n\n  /**\n   * Assess logistics of trial participation\n   */\n  assessLogistics(trial, patientLocation) {\n    const logistics = {\n      distance: this.calculateDistance(patientLocation, trial.site.location),\n      travelTime: null,\n      visitSchedule: trial.visitSchedule,\n      duration: trial.estimatedDuration,\n      compensation: trial.compensation || 'None specified',\n      transportation: trial.transportationAssistance || false\n    };\n    \n    // Estimate travel time\n    if (logistics.distance) {\n      logistics.travelTime = this.estimateTravelTime(logistics.distance);\n    }\n    \n    return logistics;\n  }\n\n  /**\n   * Monitor for new matching opportunities\n   */\n  startMonitoring() {\n    this.monitoringInterval = setInterval(async () => {\n      // Check for new trials\n      await this.checkForNewTrials();\n      \n      // Re-evaluate cached patients\n      for (const [patientId, cache] of this.eligibilityCache) {\n        const age = Date.now() - new Date(cache.timestamp).getTime();\n        const oneDay = 24 * 60 * 60 * 1000;\n        \n        if (age > oneDay) {\n          // Re-run matching for patients with stale cache\n          this.matchingQueue.push(patientId);\n        }\n      }\n      \n      // Process matching queue\n      await this.processMatchingQueue();\n    }, 60 * 60 * 1000); // Every hour\n  }\n\n  /**\n   * Check for new clinical trials\n   */\n  async checkForNewTrials() {\n    const newTrials = await this.fetchNewTrials();\n    \n    for (const trial of newTrials) {\n      if (!this.trialsDatabase.has(trial.id)) {\n        this.trialsDatabase.set(trial.id, trial);\n        \n        // Notify about new trial\n        this.notifyNewTrial(trial);\n      }\n    }\n  }\n\n  /**\n   * Process matching queue\n   */\n  async processMatchingQueue() {\n    while (this.matchingQueue.length > 0) {\n      const patientId = this.matchingQueue.shift();\n      \n      try {\n        const patientData = await this.fetchPatientData(patientId);\n        const matches = await this.matchPatientToTrials(patientData);\n        \n        if (matches.length > 0) {\n          this.notifyMatches(patientId, matches);\n        }\n      } catch (error) {\n        console.error(`Failed to process matching for patient ${patientId}:`, error);\n      }\n    }\n  }\n\n  /**\n   * Notify about new trial matches\n   */\n  notifyMatches(patientId, matches) {\n    window.dispatchEvent(new CustomEvent('trial-matches-found', {\n      detail: {\n        patientId,\n        matches: matches.slice(0, 5), // Top 5 matches\n        timestamp: new Date().toISOString()\n      }\n    }));\n  }\n\n  /**\n   * Helper methods\n   */\n  calculateAge(dateOfBirth) {\n    const today = new Date();\n    const birth = new Date(dateOfBirth);\n    let age = today.getFullYear() - birth.getFullYear();\n    const monthDiff = today.getMonth() - birth.getMonth();\n    \n    if (monthDiff < 0 || (monthDiff === 0 && today.getDate() < birth.getDate())) {\n      age--;\n    }\n    \n    return age;\n  }\n\n  calculateDistance(location1, location2) {\n    // Haversine formula for distance calculation\n    if (!location1 || !location2) return null;\n    \n    const R = 3959; // Earth radius in miles\n    const lat1 = location1.lat * Math.PI / 180;\n    const lat2 = location2.lat * Math.PI / 180;\n    const deltaLat = (location2.lat - location1.lat) * Math.PI / 180;\n    const deltaLon = (location2.lon - location1.lon) * Math.PI / 180;\n    \n    const a = Math.sin(deltaLat/2) * Math.sin(deltaLat/2) +\n              Math.cos(lat1) * Math.cos(lat2) *\n              Math.sin(deltaLon/2) * Math.sin(deltaLon/2);\n    const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a));\n    \n    return R * c;\n  }\n\n  estimateTravelTime(distance) {\n    // Rough estimate: 1 hour per 60 miles\n    return Math.ceil(distance / 60);\n  }\n\n  /**\n   * Stub methods for demonstration\n   */\n  async fetchTrialsFromSource(source) {\n    // In production, this would fetch real trials\n    return [];\n  }\n\n  async fetchNewTrials() {\n    // In production, this would fetch new trials\n    return [];\n  }\n\n  async fetchPatientData(patientId) {\n    // In production, this would fetch patient data\n    return {};\n  }\n\n  extractRelevantLabs(labs) {\n    // Extract relevant lab values for trial matching\n    return labs || {};\n  }\n\n  assessCardiacFunction(data) {\n    return data.ejectionFraction || 'normal';\n  }\n\n  assessHepaticFunction(data) {\n    return data.liverFunction || 'normal';\n  }\n\n  assessRenalFunction(data) {\n    return data.kidneyFunction || 'normal';\n  }\n\n  evaluateAgeCriterion(age, criterion) {\n    const met = age >= criterion.min && age <= criterion.max;\n    return {\n      met,\n      reason: met ? 'Age within range' : `Age ${age} outside range ${criterion.min}-${criterion.max}`\n    };\n  }\n\n  evaluateDiagnosisCriterion(diagnoses, criterion) {\n    const hasDiagnosis = diagnoses?.some(d => \n      d.condition.toLowerCase().includes(criterion.value.toLowerCase()) ||\n      d.icd10 === criterion.icd10\n    );\n    \n    return {\n      met: hasDiagnosis,\n      reason: hasDiagnosis ? 'Has required diagnosis' : 'Missing required diagnosis'\n    };\n  }\n\n  evaluateLabCriterion(labs, criterion) {\n    const value = labs[criterion.labName];\n    if (!value) {\n      return { met: false, uncertain: true, reason: 'Lab value not available' };\n    }\n    \n    let met = false;\n    switch (criterion.operator) {\n      case '>':\n        met = value > criterion.threshold;\n        break;\n      case '<':\n        met = value < criterion.threshold;\n        break;\n      case '>=':\n        met = value >= criterion.threshold;\n        break;\n      case '<=':\n        met = value <= criterion.threshold;\n        break;\n      case '=':\n        met = value === criterion.threshold;\n        break;\n    }\n    \n    return {\n      met,\n      reason: `${criterion.labName}: ${value} ${criterion.operator} ${criterion.threshold}`\n    };\n  }\n\n  evaluateMedicationCriterion(medications, criterion) {\n    const hasMedication = medications?.some(m => \n      m.name.toLowerCase().includes(criterion.value.toLowerCase())\n    );\n    \n    return {\n      met: criterion.required ? hasMedication : !hasMedication,\n      reason: criterion.required ? \n        (hasMedication ? 'On required medication' : 'Not on required medication') :\n        (hasMedication ? 'On excluded medication' : 'Not on excluded medication')\n    };\n  }\n\n  evaluateGenomicCriterion(genomics, criterion) {\n    const hasMutation = genomics.mutations?.includes(criterion.mutation);\n    const hasBiomarker = genomics.biomarkers?.includes(criterion.biomarker);\n    \n    const met = criterion.mutation ? hasMutation : hasBiomarker;\n    \n    return {\n      met,\n      reason: met ? 'Has required genomic marker' : 'Missing required genomic marker'\n    };\n  }\n\n  evaluatePerformanceCriterion(status, criterion) {\n    if (!status) {\n      return { met: false, uncertain: true, reason: 'Performance status unknown' };\n    }\n    \n    const met = status >= criterion.min && status <= criterion.max;\n    \n    return {\n      met,\n      reason: met ? 'Performance status acceptable' : 'Performance status outside range'\n    };\n  }\n\n  async evaluateTextCriterion(profile, criterion) {\n    // Use NLP for complex text criteria\n    return { met: false, uncertain: true, reason: 'Requires manual review' };\n  }\n\n  notifyNewTrial(trial) {\n    console.log('New trial available:', trial.title);\n  }\n}\n\n// Create singleton instance\nconst clinicalTrialsMatching = new ClinicalTrialsMatchingEngine();\n\nexport default clinicalTrialsMatching;","C:\\Users\\Ajdurden8\\Documents\\GitHub\\physician-dashboard-upgraded\\new-directory-name\\src\\data\\mockPatients.js",[],"C:\\Users\\Ajdurden8\\Documents\\GitHub\\physician-dashboard-upgraded\\new-directory-name\\src\\components\\ConsultListDynamic.js",[],{"ruleId":"424","replacedBy":"425"},{"ruleId":"426","replacedBy":"427"},{"ruleId":"428","severity":1,"message":"429","line":7,"column":8,"nodeType":"430","messageId":"431","endLine":7,"endColumn":15},{"ruleId":"428","severity":1,"message":"432","line":12,"column":8,"nodeType":"430","messageId":"431","endLine":12,"endColumn":19},{"ruleId":"428","severity":1,"message":"433","line":3,"column":10,"nodeType":"430","messageId":"431","endLine":3,"endColumn":16},{"ruleId":"428","severity":1,"message":"434","line":4,"column":10,"nodeType":"430","messageId":"431","endLine":4,"endColumn":21},{"ruleId":"428","severity":1,"message":"435","line":4,"column":23,"nodeType":"430","messageId":"431","endLine":4,"endColumn":34},{"ruleId":"428","severity":1,"message":"436","line":16,"column":7,"nodeType":"430","messageId":"431","endLine":16,"endColumn":14},{"ruleId":"428","severity":1,"message":"437","line":23,"column":7,"nodeType":"430","messageId":"431","endLine":23,"endColumn":19},{"ruleId":"428","severity":1,"message":"438","line":39,"column":7,"nodeType":"430","messageId":"431","endLine":39,"endColumn":16},{"ruleId":"428","severity":1,"message":"439","l